# Master switch for the unfinished VAT feature (config.js features.vat).
# true = VAT rate resolution + VAT/WARTOŚĆ VAT/WARTOŚĆ BRUTTO fields on position
# forms. Absent/anything else = feature fully off (production default; .env is
# excluded from the production rsync, see exclude-list.txt).
VAT_ENABLED=true
INVOICES_ENABLED=true
ORG_CUSTOMERS_ENABLED=true

# Automatyczny tester konfiguratora (services/configuratorTester) — adresaci raportu
