# ── Asystent eForm (czat AI) — PRZEŁĄCZNIKI ────────────────────────────────
# Zmiana działa po restarcie serwera. Opis: config.js (blok `assistant`).
# ASSISTANT_ENABLED       true = włączony dla wszystkich | admins = tylko konta admina (pilotaż) | false = wyłączony (znika okno i /assistant)
# ASSISTANT_VOICE_ENABLED true = rozmowa głosowa włączona | false = tylko czat (działa tylko przy włączonym asystencie)
# ASSISTANT_AVATAR_ENABLED true = animowana maskotka (chomik) na przycisku i w oknie | false = bez maskotki
# ASSISTANT_HANDOFF_EMAIL adres(y) konsultantów, po przecinku; per marka: ASSISTANT_HANDOFF_EMAIL_<IDENT_ORGANIZACJI>
# Klucz OPENAI_API_KEY trzymamy w .env.local (poza gitem) — ten plik jest auto-commitowany.
ASSISTANT_ENABLED=true
ASSISTANT_VOICE_ENABLED=true
ASSISTANT_AVATAR_ENABLED=true
ASSISTANT_HANDOFF_EMAIL=

# Automat faktur (services/invoices/autoInvoicing.js) — co godzinę po synchronizacji
# statusów produkcji; wszystkie poziomy 1–4, tylko zlecenia !sent! wysłane od SINCE.
INVOICE_AUTOGEN_ENABLED=true
INVOICE_AUTOGEN_SINCE=2026-01-01
