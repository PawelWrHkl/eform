{% extends "base.njk" %}
{% block head %}
    <link rel="stylesheet" href="/styles/home.css">
        <link rel="stylesheet" href="/styles/mobile/home.css">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
                <style>
                    .admin-card {
                        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
                        border: 1px solid #e9ecef;
                    }
                    .admin-card:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                    }
                    .admin-card .card-title {
                        color: #2c3e50;
                        font-weight: 600;
                    }
                    .admin-card .card-text {
                        color: #6c757d;
                        flex-grow: 1;
                    }
                    .admin-card .btn {
                        min-width: 120px;
                    }
                    .admin-card i {
                        color: #6c757d;
                    }
                    h2 {
                        color: #2c3e50;
                        font-weight: 700;
                        border-bottom: 3px solid #6c757d;
                        padding-bottom: 10px;
                        display: inline-block;
                    }
                </style>
            {% endblock head %}
            {% block content %}
                <div class="content">
                    <div class="container mb-5 col-12 w-100 mobile-rm-card">
                        <div class="row">
                            <div class="col-12">
                                <h2 class="mb-4">Panel Administracyjny</h2>
                            </div>
                        </div>
                        <div class="row justify-content-center">
                            <div class="col-lg-4 col-md-6 col-12">
                                <div
                                    class="d-flex flex-column gap-3">
                                    <!-- Administracja użytkownikami -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-person-gear me-2"></i>
                                                Administracja Użytkownikami
                                            </h5>
                                            <p class="card-text">Ustawienia konta klienta — rola, wprowadzenie, typ i język potwierdzenia, opóźnienie dostawy, e-mail i hasło</p>
                                            <a href="/admin/users" class="btn btn-primary mt-auto">
                                                Otwórz
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Podgląd logowań klientów -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-clock-history me-2"></i>
                                                Historia Logowań
                                            </h5>
                                            <p class="card-text">Przeglądaj historię logowań wszystkich użytkowników</p>
                                            <a href="/admin/login-history" class="btn btn-primary mt-auto">
                                                Zobacz
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Raporty zamówień -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-graph-up me-2"></i>
                                                Raporty Zamówień
                                            </h5>
                                            <p class="card-text">Statystyki i raporty dotyczące zamówień</p>
                                            <a href="/admin/reports" class="btn btn-secondary mt-auto">
                                                Zobacz Raporty
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Logi systemowe -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-file-text me-2"></i>
                                                Logi Systemowe
                                            </h5>
                                            <p class="card-text">Przeglądanie logów systemowych i błędów</p>
                                            <a href="/admin/logs" class="btn btn-secondary mt-auto">
                                                Zobacz Logi
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Log importów -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-cloud-download me-2"></i>
                                                Log Importów
                                            </h5>
                                            <p class="card-text">Historia importów zamówień z FTP — statusy, błędy, szczegóły</p>
                                            <a href="/admin/import-log" class="btn btn-secondary mt-auto">
                                                Zobacz Importy
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Aktywne sesje -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-people me-2"></i>
                                                Aktywne Sesje
                                            </h5>
                                            <p class="card-text">Sprawdź kto jest aktualnie zalogowany</p>
                                            <button id="btn-active-sessions" class="btn btn-info mt-auto text-white">
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                Sprawdź
                                            </button>
                                            <div id="sessions-result" class="mt-3 d-none">
                                                <span id="sessions-count" class="badge bg-success fs-6 mb-2"></span>
                                                <ul id="sessions-list" class="list-group list-group-flush"></ul>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Blokada dostępu -->
                                    <div class="card admin-card border-danger">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-slash-circle me-2"></i>
                                                Zablokuj dostęp
                                            </h5>
                                            <p class="card-text">Przerwa techniczna — tylko admin może się zalogować. Pozostali użytkownicy zobaczą komunikat na stronie logowania.</p>
                                            <div class="d-flex align-items-center gap-2 mt-auto flex-wrap">
                                                <button id="btn-access-lock" class="btn {% if accessBlocked %}btn-success{% else %}btn-danger{% endif %} text-white">
                                                    <i class="bi {% if accessBlocked %}bi-unlock{% else %}bi-lock{% endif %} me-1"></i>
                                                    {% if accessBlocked %}Odblokuj dostęp{% else %}Zablokuj dostęp{% endif %}
                                                </button>
                                                <span id="access-lock-status" class="badge {% if accessBlocked %}bg-danger{% else %}bg-secondary{% endif %} fs-6">
                                                    {% if accessBlocked %}Dostęp zablokowany{% else %}Dostęp otwarty{% endif %}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Słownik tłumaczeń -->
                                    <div class="card admin-card">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <i class="bi bi-translate me-2"></i>
                                                Słownik Tłumaczeń
                                            </h5>
                                            <p class="card-text">Synchronizuj tłumaczenia parametrów i wartości ze wszystkich grup produktowych oraz strukturę działów/grup z Exceli konfiguracyjnych</p>
                                            <button id="btn-sync-translations" class="btn btn-warning mt-auto">
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                Synchronizuj
                                            </button>
                                            <div id="translations-result" class="mt-3 d-none">
                                                <div id="translations-progress" class="mb-2"></div>
                                                <div id="group-sync-status" class="mb-2"></div>
                                                <div id="translations-summary"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endblock content %}
            {% block scripts %}
                <script src="/scripts/admin/admin_panel.js"></script>
            {% endblock scripts %}