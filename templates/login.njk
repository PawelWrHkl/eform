<!DOCTYPE html>
<html lang="{{ locale | default('en') }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ __('login.title') }}</title>
    <link rel="stylesheet" href="/styles/theme.css">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/login.css">
    <link rel="stylesheet" href="/styles/mobile/login.css">
    <link rel="stylesheet" href="/styles/mobile/main.css">
    <link rel="stylesheet" href="/styles/mobile/components.css">
    <link rel="stylesheet" href="/styles/components.css">
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet"/>
    <script src="/scripts/themeToggle.js"></script>
    {# Wariant wyglądu A/B — ten sam stan co w aplikacji (public/scripts/uiVariant.js);
       użytkownik, który wybrał B, widzi go też po wylogowaniu. #}
    <script src="/scripts/uiVariant.js?v={{ assetVersion }}"></script>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/theme-efor-v2.css?v={{ assetVersion }}">
  </head>
  <body class="image-background ">
    <header class="languages">
      <div class="language-switcher">
        <a href="/change-language?lang=pl" {% if locale == 'pl' %} class="active" data-tooltip="{{ __('base.polish_tooltip') }}" {% endif %}><img src="/img/poland.png" alt="Poland flag" width="30" height="28"></a>
        <a href="/change-language?lang=en" {% if locale == 'en' %} class="active" data-tooltip="{{ __('base.base.english_tooltip') }}" {% endif %}><img src="/img/united-kingdom.png" alt="UK flag" width="30" height="28"></a>
        <a href="/change-language?lang=de" {% if locale == 'de' %} class="active" data-tooltip="{{ __('base.german_tooltip') }}" {% endif %}><img src="/img/germany.png" alt="Germany flag" width="30" height="28"></a>
        <a href="/change-language?lang=nl" {% if locale == 'nl' %} class="active" data-tooltip="{{ __('base.netherlands_tooltip') }}" {% endif %}><img src="/img/netherlands.png" alt="Netherlands flag" width="30" height="28"></a>
        <a href="/change-language?lang=fr" {% if locale == 'fr' %} class="active" data-tooltip="{{ __('base.french_tooltip') }}" {% endif %}><img src="/img/france.png" alt="France flag" width="30" height="28"></a>
      </div>
    </header>
    <form action="/user/auth/login" method="POST">
      <div class="login-box mobile-rm-card">
        <button id="theme-toggle-login" class="theme-toggle theme-toggle-login" type="button" aria-label="Przełącz motyw"></button>
        <h3>{{ __('login.header') }}</h3>
        <div id='node-div'>
          <p id='env-info'></p>
        </div>
        <div class="input-space">
          <label for='pin' id='pin'>{{ __('login.pin_label') }}</p>
          <input type="text" name="pin" placeholder="{{ __('login.pin_placeholder') }}">
        </div>
        <div class="input-space">
          <label for='password' id='password'>{{ __('login.password_label') }}</p>
          <input type="password" name="password" placeholder="{{ __('login.password_placeholder') }}">
        </div>
        {% if message %}
          <p class="alert alert-danger mt-4 p-2 w-100 ms-0 ">{{ __(message) }}
          </p>
        {% endif %}
        <button class="btn btn-secondary" type="submit">{{ __('login.login_button') }}</button>
      </div>
    </form>
    <div id='js-warning-container' class='d-none'>
      <div style=" position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: linear-gradient(135deg,
          #dc3545 0%, #c82333 100%); color: white; padding: 2rem 3rem; border-radius: 12px; box-shadow: 0 10px 40px rgba(220, 53,
          69, 0.4); text-align: center; max-width: 500px; width: 90%; z-index: 999999; font-family: -apple-system,
          BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; ">
        <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
        <h2 style="margin: 0 0 1rem 0; font-size: 1.5rem; font-weight: 600;">
          {{ __('base.outdated_browser') }}
        </h2>
        <p style="margin: 0; font-size: 1rem; line-height: 1.6; opacity: 0.95;">
          {{ __('base.js_warning_message') }}
        </p>
      </div>
      <a id='update-browser-btn'>{{ __('base.update_browser') }}</a>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"></script>
    <script type="module" src="/scripts/translation.js"></script>
    <script type="module" src="/scripts/getEnv.js"></script>
    <script type="module" src="/scripts/checkJsVer.js"></script>
  </body>
</html>