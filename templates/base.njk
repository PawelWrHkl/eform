<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial0-scale=1.0">

    <title>{% block title %}Portal zamówień HKL{% endblock title %} </title>
    <link rel="stylesheet" href="styles/main.css">
    <link rel="stylesheet" href="styles/layout.css">
    <link rel="stylesheet" href="styles/form.css">
    <link rel="stylesheet" href="styles/components.css">
    <link rel="stylesheet" href="styles/responsive.css">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <style>
        .hidden {
            display: none;
        }
    </style>
    {% block head %}{% endblock head %}
</head>
<body>
v

    <nav class="desktop-nav">
    <a href="/">
        <img src="img/logo.png" id="hkl-logo" alt="logo HKL">
        </a>
        <div class="side-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a href="/orders" class="nav-link">Twoje zamówienia</a>
                </li>
                <li class="nav-item">
                    <a href="/new_order" class="nav-link">Nowe zamówienie</a>
                </li>
                <li class="nav-item">
                  <form action="/logout" method="POST" style="display: inline;">
                    <button type="submit" class="nav-link btn btn-link" style="text-decoration: none;">
                      Wyloguj
                    </button>
                  </form>
                </li>

                </li>
                <div class="side-nav" id="bottom-nav-menu">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a href="#" class="nav-link">Produkty</a>
                        </li>
                    </ul>
                </div>
            </ul>
        </div>
    </nav>


    <div class="update-info">
        <span>
            Ostatnie zmiany: <br>
            <b>-funkcja resetowania pól zależnych (DEPENDENCES)</b> <br>
            <b>-Reset całego formularza</b><br>
            <b>-wybór grupy asortymentowej</b><br>
            <b>-Pasek nawigacyjny</b><br>
        </span>
    </div>


    <main> 
        <div class="content">
        {% block content %}
            <div class="container">
            główny interfejs
            </div>
        {% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/hyperformula@latest/dist/hyperformula.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hot-formula-parser@4.0.0/dist/formula-parser.min.js"></script>
    <!-- <script src="scripts/custom_formula.js"></script> -->
    <script src="scripts/formula.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jstat@1.9.2/dist/jstat.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/formulajs/formulajs@2.9.3/dist/formula.min.js"></script>
    <script type="module" src="scripts/main.js"></script>
    {% block scripts %}
    {% endblock scripts %}
</body>

</html>