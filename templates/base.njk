<!DOCTYPE html>
<html lang="{{ locale | default('en') }}">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <title>
            {% block title %}
                {{ __('base.portal_title') }}
            {% endblock title %}
        </title>
        <link rel="stylesheet" href="/styles/theme.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/main.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/scripts/components/toast.css">
        <link rel="stylesheet" href="/styles/layout.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/form.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/components.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/confirm-prompt.css">
        <link rel="stylesheet" href="/styles/responsive.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/intro.css">
        <script src="/scripts/themeToggle.js"></script>
        {# ── Wariant wyglądu A (klasyczny) / B („Efor 2.0”) ──────────────────
           Synchronicznie i jak najwcześniej: uiVariant.js ustawia klasę
           `theme-efor-v2` na <html> przed pierwszym malowaniem, więc po
           odświeżeniu nie ma mignięcia wariantu A. Style wariantu B są w
           /styles/theme-efor-v2.css (wczytywany na końcu <head>), widoki
           dokładane przez JS w /scripts/uiVariantView.js (koniec <body>).
           Etykiety: partials/efor-v2-strings.njk (słownik w repo, bo pliki
           tłumaczeń żyją poza nim — patrz komentarz w tamtym pliku). #}
        <script src="/scripts/uiVariant.js?v={{ assetVersion }}"></script>
        {% import "partials/efor-v2-strings.njk" as eforStrings %}
        {% set eforT = eforStrings.dict[locale] or eforStrings.dict["en"] %}
        <style id="efor-v2-strings">:root{ {%- for key in eforStrings.cssKeys %}--efor-t-{{ key }}:"{{ eforT[key] | safe }}";{% endfor -%} }</style>
        <script>window.eforV2I18n = {{ eforT | dump | safe }};</script>
        <link rel="stylesheet" href="/styles/mobile/main.css">
        <link rel="stylesheet" href="/scripts/components/mobile-toast.css">
        <link rel="stylesheet" href="/styles/mobile/layout.css">
        <link rel="stylesheet" href="/styles/mobile/form.css">
        <link rel="stylesheet" href="/styles/mobile/components.css">
        <link rel="stylesheet" href="/styles/mobile/responsive.css">
        {# ── Mobile ETAP 1 ──────────────────────────────────────────────
           Kolejnosc ma znaczenie: tokens.css definiuje zmienne `--m-*`,
           a header.css nadpisuje starsze reguly z mobile/layout.css, wiec
           oba MUSZA byc wczytane PO pozostalych arkuszach mobilnych.
           Wszystko siedzi w @media (max-width: 767.98px) - desktop bez zmian. #}
        <link rel="stylesheet" href="/styles/mobile/tokens.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/mobile/header.css?v={{ assetVersion }}">
        <link rel="stylesheet" href="/styles/mobile/bottomnav.css?v={{ assetVersion }}">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet"/>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous">
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shepherd.js@13.0.0/dist/css/shepherd.css"/>
        {% if admin %}
            <link rel="stylesheet" href="/styles/admin_section.css">
        {% endif %}
        <script type="module" src="https://cdn.jsdelivr.net/npm/shepherd.js@13.0.0/dist/esm/shepherd.mjs"></script>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
        <script type="module" src="/scripts/tools/langChanger.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/exceljs@4.3.0/dist/exceljs.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
        <script>
            window.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' || event.keyCode === 27) {
                        {% block key_nav %}
                    {% endblock %}
            }
        }
    );
</script>
<style>
    .hidden {
        display: none;
    }
</style>
<script>
    (function () {
        const isCollapsed = localStorage.getItem('nav-collapsed') === 'true';
        const backText = document.querySelector('.back-text');
        if (isCollapsed) {
            document
                .documentElement
                .classList
                .add('nav-collapsed');
            backText.style.display = isCollapsed
                ? 'none'
                : 'inline';
        }
    })();
</script>
{% block head %}{% endblock head %}
{# Wariant B PO arkuszach podstrony (blok `head`), żeby przy równej
   specyficzności wygrywał. W wariancie A nic nie robi — każda reguła wisi pod
   `.theme-efor-v2` (wyjątek: sam przycisk „Zmień wygląd”, opisany w pliku). #}
<link rel="stylesheet" href="/styles/theme-efor-v2.css?v={{ assetVersion }}">
</head><body>
{% include "partials/efor-v2-icons.njk" %}
{% block nav %}
    <nav class="navbar navbar-expand-lg navbar-light bg-light mobile-nav">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img alt="logo " class="logo">
            </a>
            <button id="mobile-back-btn" type="button" class="mobile-back-btn d-none" onclick="window.history.back()" aria-label="{{ __('base.back_button') }}">
                <img src="/img/go-back-arrow.png" class="mobile-back-icon" alt="">
            </button>
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mobileNav"
                aria-controls="mobileNav"
                aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mobileNav">
                <ul class="nav flex-column">
                    <li class="nav-item context-button d-none" id="mobile-context-item">
                        <a href="/orders/clear-context" class="nav-link">{{ __('base.turn_off_context') }}</a>
                    </li>
                    <li class="nav-item">
                        <a href="/orders/add-order" class="nav-link fw-bold">{{ __('base.new_order') }}</a>
                    </li>
                    <li class="nav-item">
                        <a href="/orders" class="nav-link">{{ __('base.your_orders') }}</a>
                    </li>
                    <li class="nav-item">
                        <a href="/orders/history" class="nav-link">{{ __('base.orders_history') }}</a>
                    </li>
                    <li class="nav-item">
                        <a href="/panel" class="nav-link">{{ __('panel.nav_link') }}</a>
                    </li>
                    <li class="nav-item d-none" id="mobile-employee-panel-item">
                        <a href="#" id="mobile-employee-panel-link" class="nav-link">{{ __('base.employee_panel') }}</a>
                    </li>
                    {% if invoicesEnabled %}
                        <li class="nav-item">
                            <a href="/invoices" class="nav-link">Faktury</a>
                        </li>
                    {% endif %}
                    {% if canManageCustomers %}
                        <li class="nav-item">
                            <a href="/org/customers" class="nav-link">Klienci organizacji</a>
                        </li>
                    {% endif %}
                    {% if isGroup %}
                        <li class="nav-item">
                            <a href="/group/panel" class="nav-link">{{ __('group.panel_title') }}</a>
                        </li>
                        {% if groupShops and groupShops | length > 0 %}
                            <li class="nav-item mt-2">
                                <label for="mobileGroupShopSelect" class="nav-link pb-0">{{ __(gk('context_select_label')) }}</label>
                                <div class="px-3">
                                    <select id="mobileGroupShopSelect" class="dropdown-input w-100">
                                        <option value="">{{ __(gk('context_select_placeholder')) }}</option>
                                        {% for shop in groupShops %}
                                            <option value="{{ shop.id }}" {% if groupShopContext and groupShopContext.id == shop.id %}selected{% endif %}>{{ shop.name or shop.ident }}</option>
                                        {% endfor %}
                                    </select>
                                    {% if groupShopContext %}
                                        <a href="/group/context/clear" class="nav-link px-0">{{ __('group.context_exit') }}</a>
                                    {% endif %}
                                </div>
                            </li>
                        {% endif %}
                    {% endif %}
                    {% if owner and not admin %}
                        <li class="nav-item mt-2">
                            <label for="mobileUserSelect" class="nav-link pb-0">{{ __('orders.users_list') }}</label>
                            <div class="px-3">
                                <input type="text" id="mobileUserSelect" class="dropdown-input w-100" placeholder="{{ __('orders.select_user') }}" autocomplete="off"/>
                                <div id="mobileUserDropdown" class="dropdown-menu custom-dropdown">
                                    <div class="dropdown-item context-button">
                                        <a href="/orders/clear-context" class="context-button">
                                            <span>{{ __('base.turn_off_context') }}</span>
                                        </a>
                                    </div>
                                    {% if users %}
                                        {% for user in users %}
                                            <div class="dropdown-item pt-5 pb-5" data-value="{{ user.ident }}">{{ user.ident }}</div>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endif %}
                    {# Przełącznik wariantu wyglądu — na telefonie `.languages` (gdzie
                       siedzi wersja desktopowa) jest ukryty, więc przycisk żyje też tu.
                       Obsługa kliknięcia: delegacja w uiVariant.js po `data-ui-variant-toggle`. #}
                    <li class="nav-item">
                        <button type="button" class="nav-link ui-variant-toggle ui-variant-toggle--menu" data-ui-variant-toggle aria-pressed="false"
                                data-hint-efor="{{ eforT.toggleToEfor }}" data-hint-classic="{{ eforT.toggleToClassic }}" title="{{ eforT.toggleToEfor }}">
                            <svg class="ui-variant-toggle__icon" aria-hidden="true"><use href="#efor-i-palette"/></svg>
                            <span class="ui-variant-toggle__label">{{ eforT.toggle }}</span>
                            <span class="ui-variant-toggle__state" aria-hidden="true" data-state-classic="{{ eforT.variantClassic }}" data-state-efor="{{ eforT.variantEfor }}"></span>
                        </button>
                    </li>
                    <li class="nav-item">
                        {# ⚠️ Prawdziwy formularz, nie link z `data-action`: wylogowanie
                           działało wyłącznie dzięki JS-owi (`base.js` podpinał handler
                           i sam budował POST). Gdy skrypt nie zdążył się wykonać albo
                           wysypał się wcześniej na danej stronie, kliknięcie nie robiło
                           NIC — bez żadnego komunikatu. Teraz to zwykły POST. #}
                        <form method="POST" action="/user/logout" class="nav-logout-form">
                            <button type="submit" id="mobile-logout-link" class="nav-link nav-logout-btn">
                                {{ __('base.logout') }}
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <nav class="desktop-nav">
        <button class="nav-toggle-btn" id="navToggleBtn" type="button">
            <svg class="nav-toggle-icon" width="20" height="20" viewbox="0 0 24 24" fill="none">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <a href="/">
            <img class="logo w-75 m-3" alt="logo">
        </a>
        <div id='node-div'>
            <p id='env-info'></p>
        </div>
        <div id='user-div'>
            <p id='user-info'></p>
        </div>
        <div class="side-nav">
            <ul class="nav flex-column">
                {% block extra_nav_links %}
                    <a href="/orders/clear-context" id='context-button' class="custom-nav-link context-button has-tooltip d-none" data-tooltip="{{ __('base.turn_off_context') }}">
                        <img src="/img/power.png" class='nav-icon' alt="new-order-icon">
                        <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-power"/></svg>
                        <span class="nav-text">{{ __('base.turn_off_context') }}</span>
                    </a>
                {% endblock %}
                <a href="/orders/add-order" id='new-order-nav-btn' class="custom-nav-link nav-link-primary has-tooltip" data-tooltip="{{ __('base.new_order') }}">
                    <img src="/img/new-order.png" class='nav-icon' alt="new-order-icon">
                    <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-file-plus"/></svg>
                    <span class="nav-text fw-bold nav-text-new-order">{{ __('base.new_order') }}</span>
                </a>
                <a href="/orders" id='orders-nav-btn' class="custom-nav-link has-tooltip" data-tooltip="{{ __('base.your_orders') }}">
                    <img src="/img/orders.png" class='nav-icon' alt="orders-ico">
                    <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-clipboard"/></svg>
                    <span class="nav-text">{{ __('base.your_orders') }}</span>
                </a>
                <a href="/orders/history" id='orders-history-nav-btn' class="custom-nav-link has-tooltip" data-tooltip="{{ __('base.orders_history') }}">
                    <img src="/img/orders_history.png" class='nav-icon' alt="orders-ico">
                    <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-truck"/></svg>
                    <span class="nav-text">{{ __('base.orders_history') }}</span>
                </a>
                <a id='employee-panel-nav-btn' class="custom-nav-link has-tooltip d-none" data-tooltip="{{ __('base.employee_panel_tooltip') }}">
                    <img src="/img/employee.png" class='nav-icon' alt="orders-ico">
                    <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-users"/></svg>
                    <span class="nav-text">{{ __('base.employee_panel') }}</span>
                </a>
                {# Panel faktur — przy włączonej fladze `features.invoices`
                   (INVOICES_ENABLED w .env). Widzą go owner/admin (poziom 2) ORAZ
                   zwykły użytkownik/salon (poziom 3: faktury dla swoich odbiorców
                   końcowych) — bez tego formularz odbiorców nie miałby zastosowania.
                   Etykieta na sztywno, bo tłumaczenia idą z /mnt/eform/languages. #}
                {% if invoicesEnabled %}
                    <a href="/invoices" id='invoices-nav-btn' class="custom-nav-link has-tooltip" data-tooltip="Faktury">
                        <img src="/img/orders_history.png" class='nav-icon' alt="invoices-ico">
                        <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-receipt"/></svg>
                        <span class="nav-text">Faktury</span>
                    </a>
                {% endif %}
                {# Klienci organizacji — przy włączonej fladze `features.orgCustomers`
                   (ORG_CUSTOMERS_ENABLED w .env). Wejście tylko dla konta
                   organizacji; pracownik bez `can_manage_customers` dostanie 403
                   na samej trasie, więc nie pokazujemy mu wejścia w menu.
                   Etykieta na sztywno — jak przy fakturach, bo tłumaczenia idą
                   z /mnt/eform/languages, a nie z repo. #}
                {% if canManageCustomers %}
                    <a href="/org/customers" id='org-customers-nav-btn' class="custom-nav-link has-tooltip" data-tooltip="Klienci organizacji">
                        <img src="/img/employee.png" class='nav-icon' alt="customers-ico">
                        <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-contacts"/></svg>
                        <span class="nav-text">Klienci</span>
                    </a>
                {% endif %}
                {% if isGroup %}
                    <a href="/group/panel" class="custom-nav-link has-tooltip" data-tooltip="{{ __('group.panel_title') }}">
                        <img src="/img/orders.png" class='nav-icon' alt="group-panel-icon">
                        <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-store"/></svg>
                        <span class="nav-text">{{ __('group.panel_title') }}</span>
                    </a>
                {% endif %}
                {# Jak wyżej: POST bez pośrednictwa JS-u #}
                <form method="POST" action="/user/logout" class="nav-logout-form">
                    <button type="submit" id='logout-nav-btn' class="custom-nav-link has-tooltip nav-logout-btn" data-tooltip="{{ __('base.logout') }}">
                        <img src="/img/logout.png" class='nav-icon' alt="orders-ico">
                        <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-logout"/></svg>
                        <span class="nav-text">{{ __('base.logout') }}</span>
                    </button>
                </form>
                <!-- <a href="#" id='intro-tour-btn' class="custom-nav-link has-tooltip" data-tooltip="{{ __('base.tour') or 'Tour' }}" style="text-decoration: none; margin-top: auto;"> -->
                    <!-- <i class="fas fa-question-circle nav-icon" style="font-size: 1.4rem; display: flex; align-items: center; justify-content: center;"></i> -->
                    <!-- <span class="nav-text">{{ __('base.tour') or 'Tour' }}</span> -->
                <!-- </a> -->
                {# ── Kontekst konta podrzędnego dla grupy (`role = 'group'`) ──
                   Odpowiednik listy klientów u ownera/admina, ale na poziomie
                   `group_user`: grupa wybiera swój sklep/klienta i pracuje jako
                   on (services/groupContext.js). #}
                {% if isGroup and groupShops and groupShops | length > 0 %}
                    <div id='groupShopContextContainer'>
                        <label for='groupShopSelect' class="mt-4">{{ __(gk('context_select_label')) }}</label>
                        <select id="groupShopSelect" class="dropdown-input w-100">
                            <option value="">{{ __(gk('context_select_placeholder')) }}</option>
                            {% for shop in groupShops %}
                                <option value="{{ shop.id }}" {% if groupShopContext and groupShopContext.id == shop.id %}selected{% endif %}>{{ shop.name or shop.ident }}{% if shop.name and shop.ident %} ({{ shop.ident }}){% endif %}</option>
                            {% endfor %}
                        </select>
                        {% if groupShopContext %}
                            <div class="group-context-chip mt-2">
                                <span>{{ __('group.context_active') }}: <strong>{{ groupShopContext.name }}</strong></span>
                                <a href="/group/context/clear" class="group-context-exit">{{ __('group.context_exit') }}</a>
                            </div>
                        {% else %}
                            <small class="form-text text-muted d-block">{{ __(gk('context_hint')) }}</small>
                        {% endif %}
                    </div>
                {% endif %}
                {% block user_select %}
                    {% if owner and not admin %}
                        <div id='userSelectContainer'>
                            <label for='userSelect' id='userSelectLabel' class="mt-5">{{ __('orders.users_list') }}</label>
                            <div class="d-flex align-items-start gap-2">
                                <div class="dropdown-container flex-grow-1">
                                    <input type="text" id="userSelect" class="dropdown-input w-100" placeholder="{{ __('orders.select_user') }}" autocomplete="off" {% if selectedUser %} value="{{ selectedUser.client_name }}" {% endif %}/>
                                    <div id="userDropdown" class="dropdown-menu custom-dropdown">
                                        <div class="dropdown-item context-button">
                                            <a href="/orders/clear-context" id='context-dropdown-item' class='context-button'>
                                                <span class="nav-text">{{ __('base.turn_off_context') }}</span>
                                            </a>
                                        </div>
                                        {% if users %}
                                            {% for user in users %}
                                                <div class="dropdown-item pt-5 pb-5" data-value="{{ user.ident }}">{{ user.ident }}</div>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                                <a href="/user/org-pwd" id='pwd-org-btn'class="custom-nav-link has-tooltip" data-tooltip="Hasła">
                                    <img src="/img/key-chain.png" class='nav-icon' alt="passwords">
                                    <svg class="nav-icon-v2" aria-hidden="true"><use href="#efor-i-key"/></svg>
                                </a>
                            </div>
                        </div>
                    {% endif %}
                {% endblock %}
                <div class="side-nav" id="bottom-nav-menu">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a href="#" class="nav-link">{{ __('base.products') }}</a>
                        </li>
                    </ul>
                </div>
            </ul>
        </div>
        <div id='config-div'>
            <p id='config-number-info'></p>
        </div>
        {# Wariant B: karta konta na dole paska (jak w makietach). Treść wypełnia
           uiVariantView.js z danych, które base.js i tak pobiera (`/user/name`,
           zdarzenie `eform:user-loaded`) — bez drugiego zapytania. W wariancie A
           dane konta pokazuje jak dotąd `#user-info` wyżej. #}
        <div class="efor-user-card efor-v2-only" data-efor-user-card>
            <span class="efor-user-card__avatar" aria-hidden="true" data-efor-initials><svg><use href="#efor-i-user"/></svg></span>
            <span class="efor-user-card__text">
                <span class="efor-user-card__name" data-efor-user-name></span>
                <span class="efor-user-card__mail" data-efor-user-mail></span>
                <span class="efor-user-card__extra" data-efor-user-extra></span>
            </span>
        </div>
    </nav>
{% endblock %}
<header class="languages">
    {# Wariant B: okruszki po lewej stronie paska górnego. Ścieżkę (sekcja z
       aktywnego linku nawigacji + tytuł strony) dopisuje uiVariantView.js. #}
    <nav class="efor-breadcrumb efor-v2-only" aria-label="{{ eforT.breadcrumb }}">
        <a href="/" class="efor-breadcrumb__home" aria-label="{{ eforT.home }}"><svg aria-hidden="true"><use href="#efor-i-home"/></svg></a>
        <ol class="efor-breadcrumb__trail" data-efor-breadcrumb></ol>
    </nav>
    <a href="/panel" id="user-panel-header-btn" title="{{ __('panel.nav_link') }}" aria-label="{{ __('panel.nav_link') }}">
        {# Wariant B: awatar z inicjałami zamiast pigułki z napisem (inicjały: uiVariantView.js). #}
        <span class="efor-avatar efor-v2-only" data-efor-initials aria-hidden="true"><svg><use href="#efor-i-user"/></svg></span>
        <svg class="efor-avatar__chevron efor-v2-only" aria-hidden="true"><use href="#efor-i-chevron-down"/></svg>
        <svg class="efor-classic-only" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span class="efor-classic-only">{{ __('panel.nav_link') }}</span>
    </a>
    {# „Zmień wygląd” — przełącznik wariantu A ⇄ B, widoczny w obu wariantach.
       Stan (aria-pressed, podpowiedź) ustawia uiVariant.js; litera A/B na
       plakietce idzie z CSS (`data-state-*`), więc nie miga przy ładowaniu.
       Tour i przełącznik motywu wstawia za nim themeToggle.js. #}
    <button type="button" class="ui-variant-toggle" id="ui-variant-toggle" data-ui-variant-toggle aria-pressed="false"
            data-hint-efor="{{ eforT.toggleToEfor }}" data-hint-classic="{{ eforT.toggleToClassic }}" title="{{ eforT.toggleToEfor }}">
        <svg class="ui-variant-toggle__icon" aria-hidden="true"><use href="#efor-i-palette"/></svg>
        <span class="ui-variant-toggle__label">{{ eforT.toggle }}</span>
        <span class="ui-variant-toggle__state" aria-hidden="true" data-state-classic="A" data-state-efor="B"></span>
    </button>
    <div class="language-switcher">
        <a href="/change-language?lang=pl" {% if locale=='pl' %} class="active" data-tooltip="{{ __('base.polish_tooltip') }}" {% endif %}><img src="/img/poland.png" alt="Poland flag" width="30" height="28"></a>
        <a href="/change-language?lang=en" {% if locale=='en' %} class="active" data-tooltip="{{ __('base.base.english_tooltip') }}" {% endif %}><img src="/img/united-kingdom.png" alt="UK flag" width="30" height="28"></a>
        <a href="/change-language?lang=de" {% if locale=='de' %} class="active" data-tooltip="{{ __('base.german_tooltip') }}" {% endif %}><img src="/img/germany.png" alt="Germany flag" width="30" height="28"></a>
        <a href="/change-language?lang=nl" {% if locale=='nl' %} class="active" data-tooltip="{{ __('base.netherlands_tooltip') }}" {% endif %}><img src="/img/netherlands.png" alt="Netherlands flag" width="30" height="28"></a>
        <a href="/change-language?lang=fr" {% if locale=='fr' %} class="active" data-tooltip="{{ __('base.french_tooltip') }}" {% endif %}><img src="/img/france.png" alt="France flag" width="30" height="28"></a>
    </div>
    {# Wariant B: lista rozwijana języków („🌐 Deutsch ▾”) zamiast rzędu flag —
       te same adresy `/change-language`. Nazwy w językach własnych, więc bez
       tłumaczeń. Rozwijanie: dropdown Bootstrapa (bundle w <head>). #}
    {% set eforLangNames = { "pl": "Polski", "en": "English", "de": "Deutsch", "nl": "Nederlands", "fr": "Français" } %}
    <div class="efor-lang dropdown efor-v2-only">
        <button type="button" class="efor-lang__btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ eforT.language }}: {{ eforLangNames[locale] | default('English') }}">
            <svg class="efor-lang__globe" aria-hidden="true"><use href="#efor-i-globe"/></svg>
            <span class="efor-lang__name">{{ eforLangNames[locale] | default('English') }}</span>
            <svg class="efor-lang__chevron" aria-hidden="true"><use href="#efor-i-chevron-down"/></svg>
        </button>
        <ul class="dropdown-menu dropdown-menu-end efor-lang__menu">
            {% for code, name in eforLangNames %}
                <li><a class="dropdown-item{% if locale == code %} active{% endif %}" href="/change-language?lang={{ code }}" hreflang="{{ code }}" lang="{{ code }}"{% if locale == code %} aria-current="true"{% endif %}>{{ name }}</a></li>
            {% endfor %}
        </ul>
    </div>
</header>
<main>
    {% block back_link %}{% endblock %}
    <span class="arrow">
        <img src="/img/go-back-arrow.png" class='icon' alt="">
    </span>
    <span class="back-text fw-bold">{{ __('base.back_button') }}</span>
</button>
