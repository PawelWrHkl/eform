{% extends "base.njk" %}
{% block head %}
    <link rel="stylesheet" href="/styles/home.css">
        <link rel="stylesheet" href="/styles/dialog.css">
        <link rel="stylesheet" href="/styles/mobile/home.css">
            <link rel="stylesheet" href="/styles/mobile/dialog.css">
        {% endblock head %}
        {% block content %}
        {% if mustAcceptRODO %}
            <div id="rodo-modal" class="modal-overlay">
                <div class="modal-content">
                    <h2>{{ __('base.must_accept_rodo') }}</h2>
                    <p>{{ __('base.rodo_description') }}</p>
                    <a
                        href='/user/rodo'
                        class="rodo-info-text"
                        target='_blank'
                        style="color: #555; font-style: italic; margin-bottom: 1rem;">
                        {{ __('base.view_rodo_info') }}
                    </a>
                    <div class="modal-buttons">
                        <form action="/user/logout" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-danger" style="text-decoration: none;">
                                {{ __('order.cancel') }}
                            </button>
                        </a>
                    </form>
                    <button id="accept-rodo-btn" type='button' class="btn btn-primary">
                        {{ __('base.accept_rodo') }}
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
    {# ── Wariant B: pulpit startowy ──────────────────────────────────────────
       Te same dane co niżej (`user`, `orders`, `ordersSent` z routes/index.js,
       z tymi samymi ograniczeniami konta), ułożone jak pulpit: tytuł = nazwa
       firmy, akcja „Nowa oferta”, ostatnie oferty, ostatnio wysłane, dane
       firmy. W wariancie A niewidoczny (`.efor-v2-only`); w B chowa klasyczny
       widok (theme-efor-v2.css, sekcja 24). Wysyłka i edycja zostają w ofercie
       i na liście — pulpit tylko prowadzi. #}
    {% if user %}
        {% import "partials/efor-v2-strings.njk" as eforStrings %}
        {% set eforT = eforStrings.dict[locale] or eforStrings.dict["en"] %}
        <section class="efor-dash efor-v2-only content" aria-labelledby="efor-dash-title">
            <header class="efor-dash__head">
                <h1 class="efor-dash__title" id="efor-dash-title">{{ user.client_name }}</h1>
                <a href="/orders/add-order" class="btn btn-primary efor-dash__new">
                    <svg aria-hidden="true"><use href="#efor-i-file-plus"/></svg>
                    <span>{{ __('base.new_order') }}</span>
                </a>
            </header>

            <div class="efor-dash__grid">
                <section class="efor-card efor-dash__panel efor-dash__offers" aria-labelledby="efor-dash-offers">
                    <h2 class="efor-card__head" id="efor-dash-offers">
                        <span>{{ __('base.last_orders') }}</span>
                        <a href="/orders" class="efor-dash__all">{{ eforT.dashAll }}</a>
                    </h2>
                    {% if orders %}
                        <ul class="efor-dash__list">
                            {% for order in orders %}
                                <li>
                                    <a href="/orders/order/{{ order.id }}" class="efor-dash__row">
                                        <span class="efor-dash__no">#{{ order.order_idx }}</span>
                                        <span class="efor-dash__name">{{ order.commision or '—' }}</span>
                                        {% if order.status == 'pending_approval' %}
                                            <span class="efor-pill">{{ __('group.status_submitted_for_approval') }}</span>
                                        {% endif %}
                                        <span class="efor-dash__date">{{ order.created_date }}</span>
                                        <svg class="efor-dash__chevron" aria-hidden="true"><use href="#efor-i-chevron-right"/></svg>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="efor-dash__empty">{{ eforT.dashEmptyOffers }}</p>
                    {% endif %}
                </section>

                <section class="efor-card efor-dash__panel efor-dash__sent" aria-labelledby="efor-dash-sent">
                    <h2 class="efor-card__head" id="efor-dash-sent">
                        <span>{{ __('base.last_sent_orders') }}</span>
                        <a href="/orders/history" class="efor-dash__all">{{ eforT.dashAll }}</a>
                    </h2>
                    {% if ordersSent %}
                        <ul class="efor-dash__list">
                            {% for order in ordersSent %}
                                <li>
                                    <a href="/orders/history/order/{{ order.id }}" class="efor-dash__row">
                                        <span class="efor-dash__no">#{{ order.order_idx }}</span>
                                        <span class="efor-dash__name">{{ order.commision or '—' }}</span>
                                        <span class="efor-pill{% if order.prod_status == '!sent!' %} efor-pill--sent{% endif %}">{{ __(order.prod_status) if order.prod_status else __('order.status_order_sent') }}</span>
                                        <span class="efor-dash__date">{{ order.sent_date or order.created_date }}</span>
                                        <svg class="efor-dash__chevron" aria-hidden="true"><use href="#efor-i-chevron-right"/></svg>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="efor-dash__empty">{{ eforT.dashEmptySent }}</p>
                    {% endif %}
                </section>

                <section class="efor-card efor-dash__panel efor-dash__company" aria-labelledby="efor-dash-company">
                    <h2 class="efor-card__head" id="efor-dash-company"><span>{{ eforT.companyData }}</span></h2>
                    <div class="efor-dash__body">
                        <dl class="efor-dash__facts">
                            <div><dt>{{ __('base.nip') | replace(':', '') }}</dt><dd>{{ user.tax_id or '—' }}</dd></div>
                            <div><dt>{{ __('base.street') | replace(':', '') }}</dt><dd>{{ user.street or '—' }}</dd></div>
                            <div><dt>{{ __('base.zip') | replace(':', '') }}</dt><dd>{{ user.zip or '—' }}</dd></div>
                            <div><dt>{{ __('base.city_country') | replace(':', '') }}</dt><dd>{{ user.city }}{% if user.country %}, {{ user.country }}{% endif %}</dd></div>
                            <div><dt>E-mail</dt><dd>{% if user.email %}{{ user.email | escape | replace('@', '@<wbr>') | safe }}{% else %}—{% endif %}</dd></div>
                        </dl>
                        {% if not isGroupShop %}
                            <a class="btn btn-outline-secondary efor-dash__edit" href="/user/edit-user">{{ __('base.edit_user_data') }}</a>
                        {% endif %}
                    </div>
                </section>
            </div>
        </section>
    {% endif %}
    <div id='main-content' class="content">
        <div class="container mb-5 col-12 w-100 mobile-rm-card">
            {% if user %}
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6 text-center ">
                        <h5>
                            {{ user.client_name }}</h5>
                        <p>
                            <strong>{{ __('base.nip') }}</strong>
                            {{ user.tax_id }}</p>
                        <p>
                            <strong>{{ __('base.street') }}</strong>
                            {{ user.street }}</p>
                        <p>
                            <strong>{{ __('base.zip') }}</strong>
                            {{ user.zip }}</p>
                        <p>
                            <strong>{{ __('base.city_country') }}</strong>
                            {{ user.city }}, {{ user.country }}</p>
                        <p>
                            <strong>E-mail:</strong>
                            {{ user.email }}</p>
                        {% if not isGroupShop %}
                            <a class='btn btn-outline-secondary m-auto mt-3' href="/user/edit-user">{{ __('base.edit_user_data') }}</a>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning mt-4 text-center" role="alert">
                    {{ __('base.no_user_data') }}
                </div>
            {% endif %}
        </div>
    </div>
    <div id="print-template-container" style="display: none;">
        {% include 'order_to_print.njk' %}
    </div>

    <div class="orders-toggle-container">
        <div class="content center-content custom-checkbox-wrapper">
            <input type="checkbox" id="orders-toggle" class="custom-checkbox"/>
            <label for="orders-toggle" class="custom-checkbox-label">
                <span class="custom-checkbox-indicator"></span>
                <span class="custom-checkbox-text">{{ __('base.show_orders') or 'Pokaż zamówienia' }}</span>
            </label>
        </div>
    </div>
    <div class="content center-content d-flex extra-info-parrent d-none" id='last-orders-section'>
        {% if orders %}
            <div class="container col -4 me-2 add-info-box">
                <h2>{{ __('base.last_orders') }}</h2>
                <div class="last-orders-list three-column-layout">
                    {% for order in orders %}
                        <div class="order-column">
                            <div
                                class="order-card" onclick="window.location.href='/orders/order/{{ order.id }}'">
                                <div class="order-card-row">
                                    <div class="order-id">
                                        <span class="order-label">#{{ order.order_idx }}</span>
                                    </div>
                                    <div class="order-info">
                                        <div class="order-commission">
                                            {{ order.commision }}
                                        </div>
                                        <div class="order-date">
                                            {{ order.created_date }}
                                        </div>
                                    </div>
                                    <div class="order-actions">
                                        {# Zamówienie założone przez klienta grupy: grupa-matka ma
                                           podgląd, a wysyłkę robi przez zatwierdzenie w panelu grupy —
                                           bez edycji i bez wysyłki stąd (utils/orderStatusGuard.js). #}
                                        {% set clientOwned = isGroup and isGroupClientType and order.created_by_group_user_id %}
                                        {% if not clientOwned %}
                                        <a class="action-btn action-btn-edit p-1 stop-propagation" href='/orders/edit/{{ order.id }}'>
                                            <img src="/img/edit-text.png" alt="{{ __('orders.edit') }}"></a>
                                        {% endif %}
                                            {% if isGroupShop and (order.status == 'pending_approval' or not groupShopCanSend) %}
                                              {% if order.status == 'pending_approval' %}
                                                <span class="badge bg-warning text-dark align-self-center" style="font-size:0.8rem;">Do zatwierdzenia</span>
                                              {% else %}
                                                <button class="action-btn action-btn-send p-1 stop-propagation submit-approval-btn" type="button" data-id="{{ order.id }}">
                                                  <img src="/img/send.png" alt="Wyślij do zatwierdzenia"></button>
                                              {% endif %}
                                            {% elif isEmployee and (not employeePermissions or not employeePermissions.can_send_orders) %}
                                              <button class="action-btn action-btn-send p-1 stop-propagation send-order-btn" type="button" disabled title="{{ __('employee.no_send_permission') or 'Brak uprawnień do wysyłania zamówień' }}">
                                                <img src="/img/send.png" alt="{{ __('orders.send') }}"></button>
                                            {% elif not clientOwned %}
                                              <button class="action-btn action-btn-send p-1 stop-propagation send-order-btn" type="button" id='send-order' data-id="{{ order.id }}">
    +                                            <img src="/img/send.png" alt="{{ __('orders.send') }}"></button>
                                            {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {% if ordersSent %}
                    {% if not orders %}
                        <div class="container col-6 me-2 h-100 add-info-box">
                        {% else %}
                            <div class="container col-6 me-2 h-100 add-info-box">
                            {% endif %}
                            <h2>{{ __('base.last_sent_orders') }}</h2>
                            <div class="last-orders-list three-column-layout">
                                {% for order in ordersSent %}
                                    <div class="order-column">
                                        <div class="history-order-card" onclick="window.location.href='/orders/history/order/{{ order.id }}'">
                                            <div class="order-card-row">
                                                <div class="history-order-id">
                                                    <span class="history-order-label">#{{ order.order_idx }}</span>
                                                </div>
                                                <div class="order-info">
                                                    <div class="order-commission">
                                                        {{ order.commision }}
                                                    </div>
                                                    <div class="order-date">
                                                        {{ order.created_date }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}                     
                    <div id='dialog-container'>
                        <dialog id='dialog-space'></dialog>
                    </div>
                {% endblock content %}
                {% block scripts %}
                    <script type="module" src="/scripts/orders.js"></script>
                    <script type="module" src="/scripts/home.js"></script>
                {% endblock scripts %}