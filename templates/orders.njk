{% extends "base.njk" %}
{% block title %}
  {{ __('orders.title') }}
{% endblock title %}
{% block head %}
  <link rel="stylesheet" href="/styles/orders.css">
    <link rel="stylesheet" href="/styles/mobile/orders.css">
      <link rel="stylesheet" href="/styles/dialog.css">
        <link rel="stylesheet" href="/styles/mobile/dialog.css">
        {% endblock head %}
        {% block key_nav %}
          window.location.href='/'
        {% endblock %}
        {% block back_link %}
          <button class="modern-back-btn" onclick="window.location.href='/'">
          {% endblock %}
          {% block content %}
            <div class="content center-content">
              <div class="container my-5 w-100 mobile-rm-card">
                <div class="orders-topbar mb-4">
                  <div class="orders-topbar-left">
                    {% block user_filter %}{% endblock %}
                  </div>
                  <div class="orders-topbar-center">
                    {% block site_title %}
                      <h2 class="fw-bold header">{{ __('orders.title') }}</h2>
                    {% endblock site_title %}
                  </div>
                  <div class="orders-topbar-right">
                    {% block site_buttons %}
                      <a href="/orders/import-log" class="btn btn-light" title="Log importów">
                        <img src="/img/import.png" alt="import log button" class = 'icon'  >
                      </a>
                      <a href="/delivery-time" class='btn btn-light' id='delivery-btn' style="padding: 12px !important;">
                        <img
                          src="/img/fast-delivery.png"
                          alt="delivery bus button"
                          class="icon"></a>
                      {% endblock %}
                    </div>
                  </div>
                  {% block all_orders_btn %}{% endblock %}
                  {% block filters_bar %}
                    {% if orders and orders | length > 0 %}
                      <div id="orders-filters-bar" class="orders-filters-bar">
                        <div class="filter-group">
                          <label for="orders-search-mount">{{ __('orders.search') or 'Szukaj' }}</label>
                          <div id="orders-search-mount" class="orders-search-mount" {% block search_data %} data-sent="false" {% endblock %} {% if isEmployee %} data-is-employee="true" {% endif %}></div>
                        </div>
                        <div class="orders-date-filter">
                          <div class="filter-group">
                            <label for="filter-date-from">{{ __('orders.created_from') or 'Data od' }}</label>
                            <input type="date" id="filter-date-from" data-filter="dateFrom" class="form-control form-control-sm">
                          </div>
                          <span class="filters-separator">&ndash;</span>
                          <div class="filter-group">
                            <label for="filter-date-to">{{ __('orders.created_to') or 'Data do' }}</label>
                            <input type="date" id="filter-date-to" data-filter="dateTo" class="form-control form-control-sm">
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  {% endblock %}
                  {% block orders %}
                    {% if orders and orders | length > 0 %}
                      <!-- Desktop table version -->
                      <table class="table align-middle d-none d-md-table">
                        <thead>
                          <tr>
                            {% block order_no_th %}<th scope="col">{{ __('orders.order_no') }}</th>{% endblock %}
                            {# Grupa widzi na swojej liście zamówienia WSZYSTKICH swoich kont
                               podrzędnych (dzielą wiersz `user`), więc bez tej kolumny nie da się
                               odróżnić, czyje jest zamówienie. Nazwa kolumny idzie przez `gk()`,
                               żeby grupa typu `client` widziała „Klient", a nie „Sklep". #}
                            {% if isGroup %}<th scope="col">{{ __(gk('col_shop')) }}</th>{% endif %}
                            <th scope="col">{{ __('orders.commission') }}</th>
                            <th scope="col">{{ __('orders.created_date') }}</th>
                            {% block extra_heads %}{% endblock %}
                            {% block action_th %}
                              {% if not isEmployee or (employeePermissions and employeePermissions.can_send_orders) %}
                                <th scope="col ">{{ __('orders.action') }}</th>
                              {% endif %}
                            {% endblock %}
                          </tr>
                        </thead>
                        <tbody>
                          {% for order in orders %}
                            <!--onclick="window.location.href='/orders/order/{{ order.id }}'"-->
                            {% block order_item_link %}
                              <tr onclick="window.location.href='/orders/order/{{ order.id }}'" class="order-row" data-commission="{{ order.commision }}">
                              {% endblock %}
                              {# Zamówienie założone przez klienta grupy (`group_type = client`):
                                 grupa-matka ma podgląd, a wysyłkę robi przez zatwierdzenie w panelu
                                 grupy — żadnej edycji, usuwania ani wysyłki z listy
                                 (utils/orderStatusGuard.js). #}
                              {% set clientOwned = isGroup and isGroupClientType and order.created_by_group_user_id %}
                              {% block order_no_td %}<th scope="row">{{ order.order_idx }}</th>{% endblock %}
                              {% if isGroup %}<td>{% if order.shop_ident %}{{ order.shop_ident }}{% if order.shop_name %} ({{ order.shop_name }}){% endif %}{% elif order.shop_name %}{{ order.shop_name }}{% else %}—{% endif %}</td>{% endif %}
                              {% if order.employee_id and not isEmployee %}
                                <td>{{ order.commision }} ({{ order.name }}
                                  {{ order.surname }})</td>
                              {% else %}
                                <td>{{ order.commision }}</td>
                              {% endif %}
                              <td>{{ order.created_date }}</td>
                              {% block extra_rows %}{% endblock %}
                              {% if not isEmployee %}
                                {% block buttons_space %}
                                  <td class='buttons'>
                                    {% if not clientOwned %}
                                    <button class="action-btn action-btn-delete p-1 delete-position-btn stop-propagation has-tooltip" data-tooltip="{{ __('orders.delete_order') }}" id="delete-order-btn" data-href='/orders/order/{{ order.id }}/delete' type='button' onclick="event.stopPropagation()" '>
                                      <img src="/img/delete.png" alt="{{ __('order.delete') }}" style="height: 24px;"/>
                                    </button>
                                    <a class="action-btn action-btn-edit p-1 stop-propagation has-tooltip" id='edit-order-btn' data-tooltip="{{ __('orders.edit_order_tooltip') }}" href='/orders/edit/{{ order.id }}'>
                                      <img src="/img/edit-text.png" alt="{{ __('orders.edit') }}"></a>
                                    {% endif %}
                                      {% if isGroupShop %}
                                        {% if order.status == 'pending_approval' %}
                                          <span class="badge bg-warning text-dark align-self-center" style="font-size:0.8rem;">{{ __('group.status_submitted_for_approval') }}</span>
                                        {% else %}
                                          <button class="action-btn action-btn-send p-1 stop-propagation submit-approval-btn has-tooltip" data-tooltip="{{ __('group.submit_for_approval_title') }}" type="button" data-id="{{ order.id }}">
                                            <img src="/img/send.png" alt="{{ __('group.submit_for_approval_title') }}"></button>
                                        {% endif %}
                                      {% elif not clientOwned %}
                                        <button class="action-btn action-btn-send p-1 stop-propagation send-order-btn has-tooltip" data-tooltip="{{ __('orders.send_order_tooltip') }}" type="button" id='send-order' data-id="{{ order.id }}">
                                          <img src="/img/send.png" alt="{{ __('orders.send') }}"></button>
                                      {% endif %}
                                      </td>
                                    {% endblock buttons_space %}
                                  {% elif isEmployee and employeePermissions and employeePermissions.can_send_orders and not clientOwned %}
                                    <td class='buttons'>
                                      <button class="action-btn action-btn-send p-1 stop-propagation send-order-btn has-tooltip" data-tooltip="{{ __('orders.send_order_tooltip') }}" type="button" id='send-order' data-id="{{ order.id }}">
                                        <img src="/img/send.png" alt="{{ __('orders.send') }}"></button>
                                    </td>
                                  {% endif %}
                                </tr>
                              {% endfor %}
                            </tbody>
                          </table>
                          <!-- Mobile card version -->
                          <div class="mobile-orders-list d-block d-md-none">
                            {% for order in orders %}
                              {% block mobile_order_item_link %}
                                <div class="mobile-order-card" data-commission="{{ order.commision }}" onclick="window.location.href='/orders/order/{{ order.id }}'">
                              {% endblock %}
                                <div class="mobile-order-header">
                                  {% block mobile_order_no %}<span class="mobile-order-number">#{{ order.order_idx }}</span>{% endblock %}
                                  <span class="mobile-order-date">{{ order.created_date }}</span>
                                </div>
                                {% set clientOwned = isGroup and isGroupClientType and order.created_by_group_user_id %}
                                {% if isGroup and (order.shop_name or order.shop_ident) %}
                                  <div class="mobile-order-client text-muted" style="font-size:0.85rem;">{{ order.shop_ident or order.shop_name }}{% if order.shop_ident and order.shop_name %} ({{ order.shop_name }}){% endif %}</div>
                                {% endif %}
                                <div class="mobile-order-commission">{{ order.commision }}</div>
                                {% block mobile_order_actions %}
                                  <div class="mobile-order-actions">
                                    {% if not isEmployee and not clientOwned %}
                                    <button
                                      class="action-btn action-btn-delete delete-position-btn stop-propagation"
                                      data-href='/orders/order/{{ order.id }}/delete'
                                      type='button'
                                      onclick="event.stopPropagation()">
                                      {{ __('orders.delete') }}
                                    </button>
                                    <a class="action-btn action-btn-edit stop-propagation" href='/orders/edit/{{ order.id }}'>
                                      {{ __('orders.edit') }}
                                    </a>
                                    {% endif %}
                                    {% if isGroupShop %}
                                      {% if order.status == 'pending_approval' %}
                                        <span class="badge bg-warning text-dark">{{ __('group.status_submitted_for_approval') }}</span>
                                      {% else %}
                                        <button class="action-btn action-btn-send stop-propagation submit-approval-btn" type="button" data-id="{{ order.id }}">
                                          {{ __('group.submit_for_approval_title') }}
                                        </button>
                                      {% endif %}
                                    {% elif not clientOwned and (not isEmployee or (employeePermissions and employeePermissions.can_send_orders)) %}
                                      <button class="action-btn action-btn-send stop-propagation send-order-btn" type="button" data-id="{{ order.id }}">
                                        {{ __('orders.send') }}
                                      </button>
                                    {% endif %}
                                  </div>
                                {% endblock %}
                              </div>
                            {% endfor %}
                          </div>
                        {% else %}
                          <div class="text-center py-5" data-id='siema'>
                            {% block empty %}
                              <div class="text-center py-5">
                                <h3 class="mb-4">{{ __('orders.no_orders') }}</h3>
                                <p class="lead">{{ __('orders.add_first_order') }}</p>
                              </div>
                              <a href="/orders/add-order" class="action-btn action-btn-send p-2 mb-5" id='new-order-button' type='button'>
                                {{ __('orders.add_order_btn') }}
                              </a>
                            {% endblock empty %}
                          {% endif %}
                        </div>
                        {% block pagination %}
                          {% if range(totalPages).length > 1 %}
                            <nav aria-label="Paginate">
                              <ul
                                class="pagination justify-content-center">
                                <!-- Previous button -->
                                <li class="page-item {% if page == 1 %}disabled{% endif %}">
                                  <a class="page-link page-nav-btn" href="?page={{ page - 1 }}" {% if page == 1 %} tabindex="-1" aria-disabled="true" {% endif %}>
                                    <svg width="16" height="16" viewbox="0 0 16 16" fill="currentColor">
                                      <path d="M10 3L5 8l5 5"/>
                                    </svg>
                                  </a>
                                </li>
                                {% set showEllipsisStart = totalPages > 7 and page > 4 %}
                                {% set showEllipsisEnd = totalPages > 7 and page < totalPages - 3 %}
                                <!-- First 3 pages -->
                                {% for i in range(1, 4) %}
                                  {% if i <= totalPages %}
                                    <li class="page-item {% if i == page %} page-active {% endif %}">
                                      <a class="page-link" href="?page={{ i }}">{{ i }}</a>
                                    </li>
                                  {% endif %}
                                {% endfor %}
                                {% if totalPages > 6 %}
                                  <li class="page-item disabled">
                                    <span class="page-link page-ellipsis">...</span>
                                  </li>
                                {% endif %}
                                {% if totalPages > 7 and page > 3 and page < totalPages - 2 %}
                                  <li class="page-item page-active">
                                    <a class="page-link" href="?page={{ page }}">{{ page }}</a>
                                  </li>
                                  <li class="page-item disabled">
                                    <span class="page-link page-ellipsis">...</span>
                                  </li>
                                {% elif totalPages > 6 and page >= totalPages - 2 %}
                                  <!-- Show ellipsis before last 3 pages when on last pages -->
                                  <li class="page-item disabled">
                                    <span class="page-link page-ellipsis">...</span>
                                  </li>
                                {% endif %}
                                <!-- Last 3 pages -->
                                {% for i in range(totalPages - 2, totalPages + 1) %}
                                  {% if i > 3 and i <= totalPages %}
                                    <li class="page-item {% if i == page %}page-active{% endif %}">
                                      <a class="page-link" href="?page={{ i }}">{{ i }}</a>
                                    </li>
                                  {% endif %}
                                {% endfor %}
                                <!-- Next button -->
                                <li class="page-item {% if page == totalPages %}disabled{% endif %}">
                                  <a class="page-link page-nav-btn" href="?page={{ page + 1 }}" {% if page == totalPages %} tabindex="-1" aria-disabled="true" {% endif %}>
                                    <svg width="16" height="16" viewbox="0 0 16 16" fill="currentColor">
                                      <path d="M6 3l5 5-5 5"/>
                                    </svg>
                                  </a>
                                </li>
                              </ul>
                              <p class="pagination-info">{{ __('orders.page_word') }}
                                {{ page }} z {{ totalPages }}</p>
                            </nav>
                          {% endif %}
                        {% endblock %}
                      </div>
                    </div>
                    <div id='dialog-container'>
                      <dialog id='dialog-space'></dialog>
                      <dialog id="delete-dialog">
                        <h3 class="text-center" id='dialog-title'>{{ __('order.delete_element') }}</h3>
                        <p class="text-center" id='for-sure'>{{ __('order.delete_confirm') }}</p>
                        <div class="alert" id='status-info'></div>
                        <div class="confirmattion-buttons">
                          <button id="cancel-btn" class="btn btn-secondary me-1" type="button">{{ __('order.cancel') }}</button>
                          <button id="confirm-btn" class="btn btn-danger ms-1" type="button">{{ __('order.confirm') }}</button>
                        </div>
                      </dialog>
                    </div>
                  {% endblock %}
                {% endblock %}
                {% block scripts %}
                  <script type="module" src="/scripts/orders.js"></script>
                {% endblock scripts %}