                                                                        </div>
                                                                    {% endblock %}
                                                                </div>
                                                                {% block scripts %}
                                                                    <script type='module' src="/scripts/order.js"></script>
                                                                    <script src="/scripts/mobileCards.js"></script>
                    <script src="/scripts/linkPositions.js"></script>
                                                                    <script src="/scripts/stickyColumns.js"></script>
                                                                    <script src="/scripts/tableTooltips.js"></script>
                                                                    {% if owner or admin %}
                                                                    <script type='module' src="/scripts/recalculateOrder.js"></script>
                                                                    {% endif %}
                                                                    {% if admin %}
                                                                    <script>
                                                                    async function adminToggleOrderStatus(btn) {
                                                                        btn.disabled = true;
                                                                        try {
                                                                            const orderId = btn.dataset.orderId;
                                                                            const res = await fetch(`/orders/order/${orderId}/toggle-status`, {
                                                                                method: 'PATCH',
                                                                                headers: { 'Content-Type': 'application/json' }
                                                                            });
                                                                            const data = await res.json();
                                                                            if (data.success) {
                                                                                if (data.status === 'sent') {
                                                                                    location.href = `/orders/history/order/${orderId}`;
                                                                                } else {
                                                                                    location.href = `/orders/order/${orderId}`;
                                                                                }
                                                                            } else {
                                                                                alert('Błąd: ' + (data.message || 'Nieznany błąd'));
                                                                                btn.disabled = false;
                                                                            }
                                                                        } catch (e) {
                                                                            alert('Błąd połączenia');
                                                                            btn.disabled = false;
                                                                        }
                                                                    }

                                                                    async function adminSendToProduction(btn) {
                                                                        if (!confirm('Wysłać zamówienie na produkcję? Status zostanie zmieniony na „wysłane", wygenerowany PDF produkcyjny i wysłany mail.')) {
                                                                            return;
                                                                        }
                                                                        const originalText = btn.innerHTML;
                                                                        btn.disabled = true;
                                                                        btn.innerHTML = 'Wysyłanie…';
                                                                        try {
                                                                            const orderId = btn.dataset.orderId;
                                                                            const res = await fetch(`/orders/order/${orderId}/send-to-production`, {
                                                                                method: 'POST',
                                                                                headers: { 'Content-Type': 'application/json' }
                                                                            });
                                                                            const data = await res.json();
                                                                            if (data.success) {
                                                                                location.href = data.redirect || `/orders/history/order/${orderId}`;
                                                                            } else {
                                                                                alert('Błąd: ' + (data.message || 'Nieznany błąd'));
                                                                                btn.disabled = false;
                                                                                btn.innerHTML = originalText;
                                                                            }
                                                                        } catch (e) {
                                                                            alert('Błąd połączenia');
                                                                            btn.disabled = false;
                                                                            btn.innerHTML = originalText;
                                                                        }
                                                                    }
                                                                    </script>
                                                                    {% endif %}
                                                                {% endblock scripts %}