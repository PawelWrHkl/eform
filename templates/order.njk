{% extends "base.njk" %}
{% block title %}
    {{ __('order.title') }}
    {{ orderDetails.order_idx }}
{% endblock title %}
{% block head %}
    <link rel="stylesheet" href="/styles/order_details.css">
        <link rel="stylesheet" href="/styles/mobile/order_details.css">
            <link rel="stylesheet" href="/styles/dialog.css">
                <link rel="stylesheet" href="/styles/mobile/dialog.css">
                    <script defer src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
                    <script defer src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
                    <script defer src="https://cdn.jsdelivr.net/npm/canvg@3.0.10/lib/umd.min.js"></script>
                    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                {% endblock head %}
                {% block key_nav %}
                    window.history.back()
                {% endblock %}
                {% block back_link %}
                    <button class="modern-back-btn" onclick="window.history.back()">
                    {% endblock %}
                    {% block content %}
                    {# Konto podrzędne grupy nie widzi VAT-u zawsze, grupa-matka typu `client`
                       też (na jej prośbę) — jedna zmienna, żeby oba miejsca renderu (tabela
                       tutaj i ukryty `{% include 'order_to_print.njk' %}` niżej, źródło
                       eksportu do Excela) zgadzały się ze sobą. #}
                    {% set hideClientVat = isGroupShop or (isGroup and isGroupClientType) %}
                    <div class="content  col-9 center-content">
                        <div id='order-nav' class='bg-white'>
                            <div class="order-nav-main">
                                <div class="mobile-top-row d-block d-md-none">
                                    <div id="order-buttons">
                                        {# Zamówienie klienta grupy (`group_type = client`) jest dla
                                           grupy-matki tylko do wglądu i zatwierdzenia — bez nowej
                                           pozycji i bez edycji (utils/orderStatusGuard.js). #}
                                        {% if not clientOwnedOrder %}
                                        <a
                                            href="/orders/order/{{ orderDetails.id }}/new-position/"
                                            class="action-btn action-btn-send "
                                            id="new-order-button"
                                            type="button">
                                            <img class='ico' src="/img/new-position.png" alt=""></a>
                                            <a href="/orders/edit/{{ orderDetails.id }}" class="action-btn action-btn-edit" id="edit-order-button" type="button">
                                                <img class='ico' src="/img/edit-text.png" alt="{{ __('orders.edit') }}"></a>
                                            {% endif %}
                                            </div>
                                            <div id="generate-container-mobile">
                                                <button class="btn open-link-manager-btn" type="button" aria-label="{{ __('order.link_manager_title') }}">
                                                    <span style="font-size:22px;">&#128279;</span></button>
                                                {# Jeden przycisk „Pokaż cenę po rabacie" dla grupy i klienta końcowego:
                                                   odsłania NARAZ wiersz cen SUB i wiersz rabatu, po podaniu hasła tego konta
                                                   (public/scripts/order.js). Zastąpił dwa osobne przyciski — `unlockSubBtn`
                                                   (przełącznik cen SUB przez sesję) jest dla tych ról ukryty niżej. #}
                                                {% if (isGroup or isGroupShop) and not hidePrices %}
                                                    <button id="showDiscountPriceBtn" class="btn has-tooltip" type="button" data-tooltip="{{ __('form.show_discounted_price') }}">
                                                        <img src="/img/padlock.png" alt="padlock icon" class='icon'>
                                                    </button>
                                                {% endif %}
                                                {% if not isGroup and not isGroupShop and not hidePrices and not isHklClient and (not hasSubPriceToggle or showCatalogPrices) %}
                                                <button id="unlockBtn" class="btn">
                                                    <img src="/img/padlock.png" alt="padlock icon" class='icon'></button>
                                                {% endif %}
                                                    {% if (canViewSubPrices or viewAsOrganization) and not isGroup and not isGroupShop %}
                                                        <button id="unlockSubBtn" class="btn has-tooltip{% if showSub %} active{% endif %}" data-tooltip="{{ __('group.toggle_sub_params_tooltip') }}">
                                                            <img src="/img/sub-prices.png" alt="sub params icon" class='icon'></button>
                                                    {% endif %}
                                                    <button class="btn has-tooltip" data-tooltip="{{ __('base.generate_pdf_tooltip') }}" id='print-button'>
                                                        <img src="/img/pdf.png" alt="pdf icon" class='icon'></button>
                                                        <button id="generate-excel-btn" class="btn has-tooltip" data-tooltip="{{ __('order.generate_excel_tooltip') }}">
                                                            <img src="/img/excel-file.png" alt="excel-file-image" class='icon'></button>
                                                        </div>
                                                    </div>
                                                    <div id="order-buttons" class="d-none d-md-flex">
                                                        {% block new_pos_btn %}
                                                            {% if not clientOwnedOrder %}
                                                            <a
                                                                href="/orders/order/{{ orderDetails.id }}/new-position/"
                                                                class="action-btn action-btn-send custom-order-btn"
                                                                id="new-order-button"
                                                                type="button">
                                                                {{ __('order.add_position_btn') }}
                                                            </a>
                                                            {% endif %}
                                                        {% endblock %}
                                                    </div>
                                                    {% block order_space %}
                                                        <div class="floating-order w-50 d-none d-md-block" id='desktop-floating-order'>
                                                        {% endblock %}
                                                        <h2 class="fw-bold header text-center" id='order-title' data-id="{{ orderDetails.id }}" data-org-id="{{ orderDetails.organization_id }}">
                                                            {% block order_title %}
                                                                {{ __('order.title') }}
                                                            {% endblock %}
                                                            {{ orderDetails.order_idx }} <br/>
                                                            {% if orderDetails.commision %}
                                                                <p id='commission-name' data-name='{{ orderDetails.commision }}'>"{{ orderDetails.commision }}"</p>
                                                            {% endif %}
                                                        </h2>
                                                    </div>
                                                    {% block print_space %}
                                                        <div id="generate-container" class='me-3 d-none d-md-flex'>
                                                            {% block edit_order_btn %}
                                                                {% if not clientOwnedOrder %}
                                                                <a
                                                                    href="/orders/edit/{{ orderDetails.id }}"
                                                                    class="action-btn action-btn-edit row me-2"
                                                                    id="edit-order-button"
                                                                    type="button">
                                                                    {{ __('edit_order.title') }}
                                                                </a>
                                                                {% endif %}
                                                            {% endblock %}
                                                            <div class='d-flex'>
                                                                {% if owner or admin %}
                                                                <button class="btn has-tooltip" data-tooltip="{{ __('order.recalculate_tooltip') or 'Przelicz wszystkie pozycje' }}" id="recalculate-order-btn" data-order-id="{{ orderDetails.id }}" type="button">
                                                                    <span  style="display:inline-flex; align-items:center; justify-content:center; font-size:24px;"><img  class="icon" src="/img/recalculate.png" alt=""></span>
                                                                </button>
                                                                {% endif %}
                                                                <button class="btn has-tooltip open-link-manager-btn" data-tooltip="{{ __('order.link_manager_title') }}" type="button">
                                                                    <span style="display:inline-flex; align-items:center; justify-content:center; font-size:22px;">&#128279;</span>
                                                                </button>
                                                                {% if not isGroup and not isGroupShop and not hidePrices %}
                                                                <button class="btn has-tooltip" data-tooltip="{{ __('base.give_discount_tooltip') }}" id='discount-btn'>
                                                                    <img src="/img/sale.png" alt="sale icon" class='icon'></button>
                                                                {% endif %}
                                                                    {# Jeden przycisk „Pokaż cenę po rabacie" dla grupy i klienta końcowego:
                                                                       odsłania NARAZ wiersz cen SUB i wiersz rabatu, po podaniu hasła tego konta
                                                                       (public/scripts/order.js). Zastąpił dwa osobne przyciski — `unlockSubBtn`
                                                                       (przełącznik cen SUB przez sesję) jest dla tych ról ukryty niżej. #}
                                                                    {% if (isGroup or isGroupShop) and not hidePrices %}
                                                                        <button id="showDiscountPriceBtn" class="btn has-tooltip" type="button" data-tooltip="{{ __('form.show_discounted_price') }}">
                                                                            <img src="/img/padlock.png" alt="padlock icon" class='icon'>
                                                                        </button>
                                                                    {% endif %}
                                                                    {% if not isGroup and not isGroupShop and not hidePrices and not isHklClient and (not hasSubPriceToggle or showCatalogPrices) %}
                                                                    <button id="unlockBtn" class="btn">
                                                                        <img src="/img/padlock.png" alt="padlock icon" class='icon'></button>
                                                                    {% endif %}
                                                                        {% if (canViewSubPrices or viewAsOrganization) and not isGroup and not isGroupShop %}
                                                                            <button id="unlockSubBtn" class="btn has-tooltip{% if showSub %} active{% endif %}" data-tooltip="{{ __('group.toggle_sub_params_tooltip') }}">
                                                                                <img src="/img/sub-prices.png" alt="sub params icon" class='icon'></button>
                                                                        {% endif %}
                                                                        <button class="btn has-tooltip" data-tooltip="{{ __('base.generate_short_pdf_tooltip') }}" id='short-print-button'>
                                                                            <img src="/img/pdf-short.png" alt="pdf icon" class='icon'></button>
                                                                             {% if admin and availableLanguages %}
                                                                                    <div class="dropdown has-tooltip" data-tooltip="{{ __('order.translate_pdf') }}">
                                                                                            <button class="btn dropdown-toggle" id='translate-pdf-btn' data-bs-toggle="dropdown">
                                                                                            <img src="/img/pdf-translate.png" alt="pdf icon" class='icon'>
                                                                                           
                                                                                        </button>
                                                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                                                            {% for lang in availableLanguages %}
                                                                                                <li><a class="dropdown-item translate-pdf-lang" href="#" data-lang="{{ lang }}">{{ lang | upper }}</a></li>
                                                                                            {% endfor %}
                                                                                        </ul>
                                                                                    </div>
                                                                                {% endif %}
                                                                            <button class="btn has-tooltip" data-tooltip="{{ __('base.generate_pdf_tooltip') }}" id='print-button'>
                                                                                <img src="/img/pdf.png" alt="pdf icon" class='icon'></button>
                                                                                <button id="generate-excel-btn" class="btn has-tooltip" data-tooltip="{{ __('order.generate_excel_tooltip') }}">
                                                                                    <img src="/img/excel-file.png" alt="excel-file-image" class='icon'></button>
                                                                               
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="floating-order w-100 mobile d-block d-md-none">
                                                                            <h2 class="fw-bold header text-center p-4" id='order-title-mobile' data-id="{{ orderDetails.id }}" data-org-id="{{ orderDetails.organization_id }}">
                                                                                {{ __('order.title') }}
                                                                                {{ orderDetails.order_idx }} <br/>
                                                                                {% if orderDetails.commision %}
                                                                                    <p id='commission-name-mobile' data-name='{{ orderDetails.commision }}'>"{{ orderDetails.commision }}"</p>
                                                                                {% endif %}
                                                                            </h2>
                                                                        </div>
                                                                        <!-- Komentarz pod tytułem -->
                                                                        <div class="comment-space d-flex align-items-center justify-content-center w-100">
                                                                            <h3 id='comment' class='h3 fw-bold btn row' data-id="{{ orderDetails.id }}">
                                                                                {% if orderDetails.comment and orderDetails.comment.trim() and orderDetails.comment.trim() != '' and orderDetails.comment.trim() != '-' %}
                                                                                    {{ __('order.comment') }}: {{ orderDetails.comment }}
                                                                                {% endif %}
                                                                            </h3>
                                                                        </div>
                                                                    </div>
                                                                {% endblock %}
                                                                <div class="container my-5 padding-top mobile-rm-card">
                                                                    <div class="position-relative mb-4 static-head"></div>
                                                                    {% if cleanOrderItems.length > 0 %}
                                                                        <div class="order-table-container" style="overflow-x: auto;">
                                                                            {% block table %}
                                                                                {% set globalIndex = 1 %}
                                                                                {% for table in cleanOrderItems %}
                                                                                    <div class="table-scroll mb-5">
                                                                                        {% block table_style %}
                                                                                            <!-- Desktop table -->
                                                                                            <table class="table align-left table-bordered order-table mt-5 d-none d-md-table">
                                                                                                <thead>
                                                                                                {% endblock %}
                                                                                                <tr>
                                                                                                    {% block btns_head %}
                                                                                                        <th class="edit-buttons">{{ __('order.action') }}</th>
                                                                                                    {% endblock %}
                                                                                                    <th class="edit-buttons">#</th>
                                                                                                    {% for header in table.headers1 %}
                                                                                                        {% if not(header in table.locked) and not(header in table.sub) %}
                                                                                                            <th class="th-field">{{ header }}</th>
                                                                                                        {% endif %}
                                                                                                    {% endfor %}
                                                                                                    <th class="edit-buttons">{{ __('order.department') }}</th>
                                                                                                    <th class="edit-buttons">{{ __('order.group_name') }}</th>
                                                                                                    <th class="edit-buttons">{{ __('order.name') }}</th>
                                                                                                    <th class="edit-buttons">{{ __('order.comment') }}</th>
                                                                                                </tr>
                                                                                            </thead>
                                                                                            <tbody>
                                                                                                {% for rowObj in table.rows %}
                                                                                                    {% set itemHasSubPrices = rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                                                                                                    {% block item_redirect %}
                                                                                                        <tr style="cursor: pointer display:grid" data-id="{{ rowObj.item.id }}" data-link-group="{{ rowObj.item.link_group or '' }}" onclick="window.location.href='/position/{{ rowObj.item.id }}'">
                                                                                                        {% endblock %}
                                                                                                        {% block pos_btns %}
                                                                                                            {# ⚠️ `display: flex` NIE MOŻE stać na `<td>`: taka komórka przestaje być
                                                                                                               komórką tabeli (przeglądarka owija ją anonimową komórką), a FIREFOX
                                                                                                               nie przypina wtedy `position: sticky` — pierwsza kolumna odjeżdżała
                                                                                                               przy przewijaniu w bok, mimo że kolumny 2 i 3 trzymały. Chromium to
                                                                                                               wybaczał, więc błąd był widoczny tylko w Firefoksie.
                                                                                                               Układ flex robi teraz wewnętrzny kontener. #}
                                                                                                            <td class="order-action-cell">
                                                                                                                <div class="order-action-cell__inner d-flex align-items-center">
                                                                                                                {# Pozycje zamówienia klienta grupy: bez przenoszenia, duplikowania,
                                                                                                                   edycji i usuwania — grupa-matka typu `client` ma sam podgląd
                                                                                                                   (utils/orderStatusGuard.js). #}
                                                                                                                {% if not clientOwnedOrder %}
                                                                                                                <div class="position-controls d-flex flex-column align-items-center me-2">
                                                                                                                    <button class="btn move-up-btn has-tooltip" data-tooltip="{{ __('order.move_up') }}" data-id="{{ rowObj.item.id }}" onclick="event.stopPropagation()">
                                                                                                                        <svg viewbox="0 0 16 16">
                                                                                                                            <path
                                                                                                                                fill-rule="evenodd"
                                                                                                                                d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5
                                                                                                                                    5.707V11.5a.5.5 0 0 0 .5.5z"/>
                                                                                                                        </svg>
                                                                                                                    </button>
                                                                                                                    <button class="btn move-down-btn has-tooltip" data-tooltip="{{ __('order.move_down') }}" data-id="{{ rowObj.item.id }}" onclick="event.stopPropagation()">
                                                                                                                        <svg viewbox="0 0 16 16">
                                                                                                                            <path
                                                                                                                                fill-rule="evenodd"
                                                                                                                                d="M8 4a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5
                                                                                                                                    10.293V4.5A.5.5 0 0 1 8 4z"/>
                                                                                                                        </svg>
                                                                                                                    </button>
                                                                                                                </div>
                                                                                                                <button class="action-btn action-btn-duplicate me-1 p-1 duplicate-btn has-tooltip" data-tooltip="{{ __('order.duplicate_pos') }}" data-id='{{ rowObj.item.id }}' onclick="event.stopPropagation()">
                                                                                                                    <img src="/img/duplicate.png" class='icon' alt="{{ __('order.edit') }}"></button>
                                                                                                                    <a class="action-btn action-btn-edit me-1 p-1 edit-position-btn has-tooltip" data-tooltip="{{ __('order.edit_pos') }}" href="/position/{{ rowObj.item.id }}/edit?id={{ rowObj.item.id }}" onclick="event.stopPropagation()">
                                                                                                                        <img src="/img/edit-text.png" alt="{{ __('order.edit') }}"></a>
                                                                                                                        {% if admin %}
                                                                                                                        <a class="action-btn action-btn-edit me-1 p-1 has-tooltip" style="background:#fff3cd;border:1px solid #ffc107;" data-tooltip="Edytuj (admin — najnowszy formularz)" href="/position/{{ rowObj.item.id }}/admin-redit" onclick="event.stopPropagation()">
                                                                                                                            <img src="/img/edit-text.png" alt="Admin re-edit"><span style="font-size:0.65em;color:#664d03;margin-left:2px;">ADM</span></a>
                                                                                                                        {% endif %}
                                                                                                                        <button class="action-btn action-btn-delete p-1 delete-position-btn has-tooltip" data-tooltip="{{ __('order.delete_pos') }}" type="button" data-id="{{ rowObj.item.id }}" data-href="/position/{{ rowObj.item.id }}/delete" onclick="event.stopPropagation()">
                                                                                                                            <img src="/img/delete.png" alt="{{ __('order.delete') }}"/>
                                                                                                                        </button>
                                                                                                                {% endif %}
                                                                                                                    {# Zamknięcie wrappera MUSI być w tym bloku: szablony, które nadpisują
                                                                                                                       `pos_btns` pustą treścią (np. `order_sent.njk`), nie mogą zostać
                                                                                                                       z osieroconym `</div>` zamykającym cudzy kontener. #}
                                                                                                                    </div>
                                                                                                                    {% endblock %}
                                                                                                                </td>
                                                                                                                <th scope="row" class='order-idx' data-id="{{ rowObj.item.id }}" data-idx='{{ globalIndex }}'>{{ globalIndex }}</th>
                                                                                                                {% for header in table.headers1 %}
                                                                                                                    {% if not(header in rowObj.item.lockedParams) %}
                                                                                                                        <td class="td-val">{{ rowObj.row.row1[header] or '-' }}</td>
                                                                                                                    {% endif %}
                                                                                                                {% endfor %}
                                                                                                                <td>{{ rowObj.item.department or '-' }}
                                                                                                                </td>
                                                                                                                <td>{{ rowObj.item.group_name or '-' }}
                                                                                                                </td>
                                                                                                                <td>{{ rowObj.item.commision | truncate(20, true, "...") or "-" }}</td>
                                                                                                                <td>{{ rowObj.item.comment | truncate(30, true, "...") }}</td>
                                                                                                            </tr>
                                                                                                            {% if not isGroupShop and not (isClient and itemHasSubPrices) and not hidePrices and not (hasSubPriceToggle and itemHasSubPrices and not showCatalogPrices) %}
                                                                                                            <tr id='price-row' class="price-row">
                                                                                                                <td colspan="100%" class="sub-params-cell">
                                                                                                                    <div class="sub-params-container">
                                                                                                                        {% for header in table.headers2 %}
                                                                                                                            {# VAT katalogowy (organizacje HKL: klucze `VAT`/`WARTOSC_VAT`/`WARTOSC_BRUTTO`
                                                                                                                               bez prefiksu `SUB___`) — konto podrzędne go nie widzi zawsze, grupa-matka
                                                                                                                               typu `client` też (na jej prośbę). Klucz odzyskujemy z `headerKeys2`
                                                                                                                               (`display||key`), bo pętla ma tu tylko etykietę wyświetlaną. #}
                                                                                                                            {% set headerKey = table.headerKeys2[loop.index0] or '' %}
                                                                                                                            {% set isVatRow = (isGroupShop or (isGroup and isGroupClientType)) and (headerKey.endsWith('||VAT') or headerKey.endsWith('||WARTOSC_VAT') or headerKey.endsWith('||WARTOSC_BRUTTO')) %}
                                                                                                                            {% if not(header in rowObj.item.lockedParams) and not isVatRow %}
                                                                                                                                {% set value = rowObj.row.row2[header] %}
                                                                                                                                {% if value and value != '-' and value != '' %}
                                                                                                                                    <span class="sub-param-item">
                                                                                                                                        <span class="sub-param-label">{{ header }}:</span>
                                                                                                                                        <b class="sub-param-value">{{ value | applyFactor(priceFactor) }}</b>
                                                                                                                                    </span>
                                                                                                                                {% endif %}
                                                                                                                            {% endif %}
                                                                                                                        {% endfor %}
                                                                                                                    </div>
                                                                                                                </td>
                                                                                                            </tr>
                                                                                                            {% endif %}
                                                                                                            {% if (isGroup or isGroupShop or canViewSubPrices or viewAsOrganization or (isClient and itemHasSubPrices)) and rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                                                                                                                {% set isOrgView = isOrgAccount or viewAsOrganization %}
                                                                                                                <tr class="sub-params-row"{% if isGroupShop or (isClient and itemHasSubPrices) or (hasSubPriceToggle and itemHasSubPrices) or (isGroup and showSub) %} style="display: table-row;"{% endif %}>
                                                                                                                    <td colspan="100%" class="sub-params-cell">
                                                                                                                        <div class="sub-params-container">
                                                                                                                            {% for entry in rowObj.item.subParamValues %}
                                                                                                                                {% if entry.value and entry.value != '-' and entry.value != '' %}
                                                                                                                                    {# Rabat klienta grupy: wiersz jest `locked`, więc normalnie chowa się razem
                                                                                                                                       z cenami „złotymi", ALE klient końcowy (group_user) i grupa mają go
                                                                                                                                       zobaczyć po kliknięciu kłódki — renderujemy ukryty, odsłania
                                                                                                                                       `showDiscountPriceBtn` (public/scripts/order.js). #}
                                                                                                                                    {% set isClientDiscountRow = entry.key == 'SUB___RABAT_KLIENTA' or entry.key == 'SUB___WARTOSC_PO_RABACIE' %}
                                                                                                                                    {# ⚠️ Konto podrzędne grupy (`group_user`) nie widzi VAT-u — ani w
                                                                                                                                       konfiguracji pozycji (form.js nie tworzy pól), ani tutaj. Grupa-matka
                                                                                                                                       typu `client` też nie (na jej prośbę — kłódka odsłania SUB, ale nie VAT).
                                                                                                                                       Pozycje zapisane wcześniej mają te wiersze w bazie, więc pomijamy je
                                                                                                                                       przy renderze. #}
                                                                                                                                    {% set hideVatFromRole = isGroupShop or (isGroup and isGroupClientType) %}
                                                                                                                                    {% set isVatRow = entry.key == 'SUB___VAT' or entry.key == 'SUB___WARTOSC_VAT' or entry.key == 'SUB___WARTOSC_BRUTTO' %}
                                                                                                                                    {% if (not hideVatFromRole or not isVatRow) and not isClientDiscountRow and (not entry.locked or (not isOrgView and prices)) %}
                                                                                                                                    <span class="sub-param-item{% if entry.locked %} gold{% endif %}">
                                                                                                                                        <span class="sub-param-label">{{ entry.display }}:</span>
                                                                                                                                        <b class="sub-param-value">{{ entry.value }}</b>
                                                                                                                                    </span>
                                                                                                                                    {% endif %}
                                                                                                                                {% endif %}
                                                                                                                            {% endfor %}
                                                                                                                        </div>
                                                                                                                    </td>
                                                                                                                </tr>
{# Rabat klienta grupy w OSOBNYM wierszu pod cenami SUB — odsłaniany kłódką
   (`showDiscountPriceBtn`, public/scripts/order.js). ⚠️ `d-none` niesie
   `!important`, więc po jego zdjęciu potrzebny jest własny inline
   `display: table-row` — sam `.sub-params-row` jest w CSS ukryty. #}
{% if rowObj.item.clientDiscountValues and rowObj.item.clientDiscountValues.length > 0 and (isGroup or isGroupShop) and not hidePrices %}
    <tr class="sub-params-row client-discount-row d-none" style="display: table-row;">
        <td colspan="100%" class="sub-params-cell">
            <div class="sub-params-container">
                {% for entry in rowObj.item.clientDiscountValues %}
                    {% if entry.value and entry.value != '-' and entry.value != '' %}
                        <span class="sub-param-item gold">
                            <span class="sub-param-label">{{ entry.display }}:</span>
                            <b class="sub-param-value">{{ entry.value }}</b>
                        </span>
                    {% endif %}
                {% endfor %}
            </div>
        </td>
    </tr>
{% endif %}
                                                                                                                {% if isOrgView and showCatalogPrices and prices %}
                                                                                                                <tr class="sub-params-row" style="display: table-row;">
