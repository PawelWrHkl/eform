{% extends "base.njk" %}
{% block title %}
  [ADMIN] {{ __('form.title_edit') }}
{% endblock title %}
{% block head %}
  <link rel="stylesheet" href="/styles/dialog.css">
    <link rel="stylesheet" href="/styles/slope.css">
      <link rel="stylesheet" href="/styles/mobile/dialog.css">
        <link rel="stylesheet" href="/styles/mobile/slope.css">
          <link rel="stylesheet" href="/styles/mobile/components.css">
            <link rel="stylesheet" href="/styles/form_btn.css">
            <style>
              .admin-redit-notice {
                background: #fff3cd;
                border: 1px solid #ffc107;
                border-radius: 6px;
                padding: 10px 16px;
                margin-bottom: 16px;
                font-size: 0.9rem;
                color: #664d03;
              }
              .admin-redit-notice strong {
                display: block;
                margin-bottom: 4px;
              }
              .admin-redit-badge {
                font-size: 0.75em;
                color: #664d03;
                background: #fff3cd;
                border: 1px solid #ffc107;
                border-radius: 4px;
                padding: 1px 5px;
                vertical-align: middle;
              }
            </style>
            {% endblock head %}
            {% block key_nav %}{% endblock %}
            {% block back_link %}
              <button class="modern-back-btn" onclick="window.location.href='/orders/order/{{ orderId }}'">
              {% endblock %}
              {% block content %}
                <form action="post" class='full-form'>
                  <p id="orderId" class='d-none'>{{ orderId }}</p>
                  <p id="positionId" class='d-none'>{{ position.id }}</p>
                  <div class='content'>
                    <h1>
                      {{ __('form.edit_h1') }}
                      {{ position.name }}</h1>
                    <div class='container d-flex col-12 p-3'>
                      <div class='commission-space d-flex mb-4 col-12'>
                        <div class="admin-redit-notice col-12">
                          <strong>&#9888; Tryb edycji admina — najnowszy formularz</strong>
                          Formularz zostanie załadowany w najnowszej wersji parametrów (nie wersji zapisanej w pozycji).
                          Wartości z oryginalnej pozycji zostaną wstępnie wpisane i przeliczone według aktualnych zasad.
                        </div>
                        <div class="comm-input d-grid col-3">
                          <label for="commision-input" class='p-1 fw-bold'>{{ __('form.commission_label') }}</label>
                          <input type="text" maxlength="32" id="commission-name" class="p-1" value="{{ position.commision }}"></div>
                        </div>
                      </div>
                      <div class="container">
                        <h3>{{ __('form.reminder') }}</h3>
                        <div id="dynamic-form"></div>
                        <div id="file-error-message" class="alert alert-danger d-none col-12" role="alert"></div>
                        <div id="buttons-space" class='justify-content-center'>
                          <button class="btn" type='button' id='show-button'>
                            {{ __('form.save_button') }}
                          </button>
                          <button class="btn mt-3" type='button' id='reset-button'>
                            {{ __('form.reset_button') }}
                          </button>
                          <div id="attachment-space">
                            <div class="attachment-label"></div>
                            <div id="attachment-container"></div>
                          </div>
                        </div>
                      </div>
                    </form>
                    <dialog id="color-dialog">
                      <div id="dialog-toast-container"></div>
                      <div id="dialog-container" class="d-grid">
                        <h3 id="dialog-title" class="text-center">{{ __('form.dialog_title') }}</h3>
                        <p class="text-center">{{ __('form.dialog_subtitle') }}</p>
                        <div id="dynamic-options-list" class="options-scrollable"></div>
                        <div class="bottom mt-3">
                          <div class="button-wrapper">
                            <button id="dialog-confirm" class="btn btn-success me-2" type="button">
                              {{ __('form.apply_button') }}
                            </button>
                            <button id="dialog-close" class="btn btn-secondary" type="button">
                              {{ __('form.cancel_button') }}
                            </button>
                          </div>
                          <div class="obj-counter">
                            <label for="object-count">{{ __('form.object_count') }}:</label>
                            <span id="object-count">sdassd</span>
                          </div>
                        </div>
                      </div>
                    </dialog>
                    <dialog id="image-preview-dialog" class="image-preview-dialog">
                      <button id="close-dialog-btn" class="close-dialog-btn" type='button'>✖</button>
                      <img id="preview-image" src="" alt="{{ __('form.preview_alt') }}"/>
                    </dialog>
                    <div id='version-space'></div>
                    <div class="hourglass"></div>
                    <div class="overlay"></div>
                  {% endblock content %}
                  {% block scripts %}
                    <script>
                      window.vatRate = {{ vatRate | default(0) | dump | safe }};
                      window.vatReason = {{ vatReason | default("unknown") | dump | safe }};
                      window.isHklOrg = {{ isHklOrg | default(false) | dump | safe }};
                    </script>
                    <script type='module' src="/scripts/admin/admin_edit_form.js"></script>
                  {% endblock scripts %}
