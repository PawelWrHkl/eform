{#
  Odbiorcy końcowi (poziom 3) — prywatna baza klientów Użytkownika/salonu.

  ⚠️ To NIE są konta w aplikacji: brak pinu i hasła, istnieją wyłącznie jako
  nabywcy na fakturach i adresaci dostaw (tabela `invoice_end_client`).
  Cała komunikacja idzie przez `/api/v1/invoices/end-clients` — strona nie ma
  własnej logiki biznesowej. Wyszukiwanie jest serwerowe (skala!).
#}
{% extends "base.njk" %}

{% block title %}{{ L.end_clients }}{% endblock title %}

{% block head %}
  <link rel="stylesheet" href="/styles/orders.css">
  <link rel="stylesheet" href="/styles/invoices.css?v={{ assetVersion }}">
{% endblock head %}

{% block key_nav %}window.location.href='/invoices'{% endblock %}

{% block back_link %}
  <button class="modern-back-btn" onclick="window.location.href='/invoices'">
{% endblock %}

{% block content %}
  <div class="content center-content">
    <div class="container my-5 w-100 mobile-rm-card">

      <div class="inv-topbar">
        <div>
          <h2 class="fw-bold header mb-1">{{ L.end_clients }}</h2>
          <div class="inv-subtitle">{{ L.end_clients_hint }}</div>
        </div>
        {# ⚠️ „Nowy odbiorca" to GŁÓWNY powód wejścia na ten ekran, więc jest
           akcją strony (u góry, wyróżniona kolorem), a nie przyciskiem
           doklejonym do pola wyszukiwania, gdzie ginął obok szarego „Wróć". #}
        <div class="inv-topbar__actions">
          <a class="inv-btn inv-btn--ghost" href="/invoices">{{ L.back }}</a>
          <button type="button" class="inv-btn inv-btn--accent" id="ec-new">
            <span class="inv-btn__plus" aria-hidden="true">+</span> {{ L.end_client_new }}
          </button>
        </div>
      </div>

      {# ---------- Wyszukiwanie + lista ---------- #}
      <section class="inv-card">
        <h3 class="inv-card__title">{{ L.end_clients_list }}</h3>
        <div class="inv-form__row inv-form__row--tight">
          <label class="inv-field inv-field--grow">
            <input type="text" id="ec-search" class="inv-combo__input"
                   placeholder="{{ L.end_client_search_placeholder }}" autocomplete="off">
          </label>
          <span class="inv-count" id="ec-count"></span>
        </div>

        <div class="inv-table-wrap">
          <table class="inv-table" id="ec-table">
            <thead>
              <tr>
                <th>{{ L.name }}</th>
                <th>{{ L.type }}</th>
                <th>{{ L.tax_id }}</th>
                <th>{{ L.client_country }}</th>
                <th>{{ L.city }}</th>
                <th>{{ L.email }}</th>
                <th>{{ L.actions }}</th>
              </tr>
            </thead>
            <tbody id="ec-rows">
              <tr><td colspan="7" class="inv-empty">{{ L.searching }}</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      {# ---------- Formularz w oknie modalnym ----------
         ⚠️ Wcześniej formularz był kolejną KARTĄ POD LISTĄ, przez co ekran
         „nowy odbiorca" i ekran „lista odbiorców" były tym samym widokiem —
         po kliknięciu „Nowy odbiorca" nadal widać było tabelę, a formularz
         trzeba było doskrolować. Teraz to `<dialog>`: przykrywa listę, ma
         własny nagłówek i zamyka się Esc / „Anuluj" / po zapisie.
         Świadomie modal, nie osobny endpoint — po zapisie wracasz dokładnie
         tam, gdzie byłeś (ta sama fraza wyszukiwania, ta sama pozycja listy),
         bez przeładowania strony. #}
      <dialog class="inv-dialog" id="ec-form-card" aria-labelledby="ec-form-title">
        <div class="inv-dialog__head">
          <h3 class="inv-dialog__title" id="ec-form-title">{{ L.end_client_new }}</h3>
          <button type="button" class="inv-dialog__close" id="ec-close" aria-label="{{ L.cancel_doc }}">&times;</button>
        </div>

        <form id="ec-form">
          <input type="hidden" name="id" id="ec-id">
          <p class="inv-hint inv-hint--form">{{ L.form_required_hint }}</p>

          {# ⚠️ Sekcje jako GRUPY (fieldset + legenda), nie kolejne `inv-card__title`:
             wcześniej pięć nagłówków w tym samym stylu co tytuł karty wyglądało
             jak pięć osobnych, poprzerywanych ekranów. #}
          <fieldset class="inv-section">
            <legend class="inv-section__title">{{ L.section_identity }}</legend>
            <p class="inv-section__hint">{{ L.section_identity_hint }}</p>
            <div class="inv-grid">
              <label class="inv-field"><span class="inv-label">{{ L.end_client_type }}</span>
                <select name="client_type" id="ec-type">
                  <option value="company">{{ L.type_company }}</option>
                  <option value="person">{{ L.type_person }}</option>
                </select></label>
              <label class="inv-field inv-field--wide"><span class="inv-label">{{ L.name }} *</span>
                <input name="name" required></label>
              <label class="inv-field"><span class="inv-label">{{ L.client_country }} *</span>
                <input name="country" maxlength="2" placeholder="PL" required></label>
              <label class="inv-field"><span class="inv-label">{{ L.tax_id }}</span>
                <input name="tax_id" id="ec-tax-id"></label>
              <label class="inv-field"><span class="inv-label">{{ L.vat_eu_id }}</span>
                <input name="vat_eu_id" placeholder="DE123456789"></label>
            </div>

            {# REGON / KVK / SIREN to dalej NUMERY TEGO SAMEGO ODBIORCY — stoją
               przy NIP-ie i VAT-UE, a nie w osobnej sekcji na końcu formularza.
               Zestaw pól zależy od kraju, więc dokłada je JS. #}
            {# Bez osobnego nagłówka — pola rejestrowe to dalszy ciąg danych
               identyfikacyjnych, a same etykiety (REGON, KVK, SIREN…) mówią,
               czym są. Zostaje tylko dyskretna podpowiedź o kraju. #}
            <div class="inv-subsection" id="ec-registry-block">
              <span class="inv-hint" id="ec-registry-hint"></span>
              <div class="inv-grid" id="ec-registry-fields"></div>
            </div>
          </fieldset>

          <fieldset class="inv-section">
            <legend class="inv-section__title">{{ L.section_contact }}</legend>
            <p class="inv-section__hint">{{ L.section_contact_hint }}</p>
            <div class="inv-grid">
              <label class="inv-field inv-field--wide"><span class="inv-label">{{ L.street }}</span>
                <input name="street"></label>
              <label class="inv-field"><span class="inv-label">{{ L.zip }}</span>
                <input name="zip"></label>
              <label class="inv-field"><span class="inv-label">{{ L.city }}</span>
                <input name="city"></label>
              <label class="inv-field"><span class="inv-label">{{ L.email }}</span>
                <input name="email" type="email"></label>
              <label class="inv-field"><span class="inv-label">{{ L.phone }}</span>
                <input name="phone"></label>
            </div>
          </fieldset>

          {# Adres dostawy dotyczy mniejszości odbiorców i tak samo działa na
             fakturze (drukowany dopiero po zaznaczeniu — `main.js:buildDeliveryAddress`),
             więc checkbox STERUJE sekcją zamiast wisieć pod nią. #}
          <fieldset class="inv-section inv-section--optional">
            <legend class="inv-section__title">
              <label class="inv-check inv-check--legend">
                <input type="checkbox" name="print_delivery_address" id="ec-print-delivery" value="1">
                <span>{{ L.delivery_address }}</span>
              </label>
            </legend>
            <p class="inv-section__hint">{{ L.section_delivery_hint }}</p>
            <div class="inv-grid" id="ec-delivery-fields" hidden>
              <label class="inv-field inv-field--wide"><span class="inv-label">{{ L.name }}</span>
                <input name="delivery_name"></label>
              <label class="inv-field inv-field--wide"><span class="inv-label">{{ L.street }}</span>
                <input name="delivery_street"></label>
              <label class="inv-field"><span class="inv-label">{{ L.zip }}</span>
                <input name="delivery_zip"></label>
              <label class="inv-field"><span class="inv-label">{{ L.city }}</span>
                <input name="delivery_city"></label>
              <label class="inv-field"><span class="inv-label">{{ L.client_country }}</span>
                <input name="delivery_country" maxlength="2"></label>
            </div>
          </fieldset>

          <fieldset class="inv-section">
            <legend class="inv-section__title">{{ L.notes }}</legend>
            <p class="inv-section__hint">{{ L.section_notes_hint }}</p>
            <label class="inv-field inv-field--wide">
              <textarea name="notes" rows="3"></textarea>
            </label>
          </fieldset>

          {# Akcje przyklejone do dołu: formularz jest długi, a bez tego przy
             dłuższej kartotece „Zapisz" uciekało poza ekran. #}
          <div class="inv-form__actions inv-form__actions--sticky">
            <button type="button" class="inv-btn inv-btn--ghost" id="ec-cancel">{{ L.cancel_doc }}</button>
            <button type="submit" class="inv-btn inv-btn--accent">{{ L.save }}</button>
          </div>
        </form>
      </dialog>

    </div>
  </div>

  <script type="application/json" id="inv-labels">{{ L | dump | safe }}</script>
  {# Definicje numerów rejestrowych per kraj — te same, których używa
     `core/compliance.js` przy budowaniu dokumentu (jedno źródło prawdy). #}
  <script type="application/json" id="ec-registry-defs">{{ registryFields | dump | safe }}</script>
{% endblock content %}

{% block scripts %}
  <script type="module" src="/scripts/owner/end_clients.js?v={{ assetVersion }}"></script>
{% endblock scripts %}
