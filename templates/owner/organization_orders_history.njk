{% extends "owner/organization_orders.njk" %}
{% block search_data %}data-sent="true" data-organization="true"{% endblock %}
{% block title %}
    {{ __('orders.sent_orders') }}
{% endblock title %}
{% block head %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/3.0.1/jspdf.umd.min.js"></script>
    <link rel="stylesheet" href="/styles/orders.css">
        <link rel="stylesheet" href="/styles/mobile/orders.css">
            <link rel="stylesheet" href="/styles/dialog.css">
                <link rel="stylesheet" href="/styles/mobile/dialog.css">
                {% endblock %}
                {% block site_title %}
                    <h2 class="fw-bold header">{{ __('orders.sent_orders') }}</h2>
                {% endblock site_title %}
                {% block site_buttons %}
                    <a href="/delivery-time" class='btn btn-light' id='delivery-btn'>
                        <img
                            src="/img/fast-delivery.png"
                            alt="delivery bus button"
                            style='height:50px;width:50px; border:0px white solid !important'></a>
                    {% endblock %}
                    {% block users %}
                        {% if users and users.length > 0 %}
                            <div class="user-filter-inline mt-4 ms-2">
                                <div class="dropdown-container">
                                    <input type="text" id="inlineUserSelect" class="dropdown-input" placeholder="{{ __('orders.select_user') }}" autocomplete="off" {% if selectedUserIdent %} value="{{ selectedUserIdent }}" {% endif %}/>
                                    <div id="inlineUserDropdown" class="dropdown-menu custom-dropdown">
                                        <div class="dropdown-item context-button">
                                            <a href="/orders/organization-orders?history=true" id='context-dropdown-item' class='context-button'>
                                                <span>{{ __('orders.all_users') or 'Wszyscy' }}</span>
                                            </a>
                                        </div>
                                        {% for user in users %}
                                            <div class="dropdown-item" data-value="{{ user.ident }}">{{  user.ident }}</div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endblock %}
                    {% block extra_heads %}
                        <th scope="col">
                            {{ __('orders.sent_date') }}</th>
                        <th scope="col">{{ __('orders.status') }}</th>
                        <th scope="col">{{ __('translate.delivery') }}</th>
                        <th scope="col">{{ __('orders.tracking_numbers') or 'Numery przesyłek' }}</th>
                    {% endblock %}
                    {% block filters_bar %}
                        {% if orders %}
                        <div id="orders-filters-bar" class="orders-filters-bar">
                            <div class="filter-group">
                                <label for="orders-search-mount">{{ __('orders.search') or 'Szukaj' }}</label>
                                <div id="orders-search-mount" class="orders-search-mount" data-sent="true" data-organization="true"></div>
                            </div>
                            <div class="orders-date-filter">
                                <div class="filter-group">
                                    <label for="filter-date-from">{{ __('orders.created_from') or 'Data od' }}</label>
                                    <input type="date" id="filter-date-from" data-filter="dateFrom" class="form-control form-control-sm">
                                </div>
                                <span class="filters-separator">&ndash;</span>
                                <div class="filter-group">
                                    <label for="filter-date-to">{{ __('orders.created_to') or 'Data do' }}</label>
                                    <input type="date" id="filter-date-to" data-filter="dateTo" class="form-control form-control-sm">
                                </div>
                            </div>
                            <div class="orders-date-filter">
                                <div class="filter-group">
                                    <label for="filter-sent-from">{{ __('orders.sent_date_from') or 'Wys. od' }}</label>
                                    <input type="date" id="filter-sent-from" data-filter="sentDateFrom" class="form-control form-control-sm">
                                </div>
                                <span class="filters-separator">&ndash;</span>
                                <div class="filter-group">
                                    <label for="filter-sent-to">{{ __('orders.sent_date_to') or 'Wys. do' }}</label>
                                    <input type="date" id="filter-sent-to" data-filter="sentDateTo" class="form-control form-control-sm">
                                </div>
                            </div>
                            <div class="orders-status-filter filter-group">
                                <label for="filter-prod-status">{{ __('orders.status') }}</label>
                                <select id="filter-prod-status" data-filter="prodStatus" class="form-select form-select-sm">
                                    <option value="">{{ __('orders.all_statuses') }}</option>
                                    <option value="__received__">{{ __('order.status_order_sent') }}</option>
                                    <option value="!sent!">{{ __('!sent!') }}</option>
                                    <option value="!preparation!">{{ __('!preparation!') }}</option>
                                    <option value="!production!">{{ __('!production!') }}</option>
                                    <option value="!backorder!">{{ __('!backorder!') }}</option>
                                </select>
                            </div>
                        </div>
                        {% endif %}
                    {% endblock %}
                    {% block order_item_link %}
                        <tr onclick="window.location.href='/orders/history/order/{{ order.id }}'" class="order-row">
                    {% endblock %}
                    {% block mobile_order_item_link %}
                        <div class="mobile-order-card" onclick="window.location.href='/orders/history/order/{{ order.id }}'">
                    {% endblock %}
                    {% block mobile_order_actions %}
                        <div class="mobile-order-actions">
                            <button type="button" class="btn reorder-btn reorder-btn--labeled copy-order-btn stop-propagation" data-id="{{ order.id }}" onclick="event.stopPropagation()">{% include 'partials/reorder_icon.njk' %}<span>{{ __('orders.reorder') }}</span></button>
                        </div>
                    {% endblock %}
                        {% block action_th %}{% endblock %}
                        {% block extra_rows %}
                            <td>{{ order.sent_date }}</td>
                            <th scope="row" data-prod-status="{{ order.prod_status or '' }}">{{ __(order.prod_status) if order.prod_status else __('order.status_order_sent') }}</th>
                            <th scope="row">
                                {% if order.delivery_date %}
                                    {{ order.delivery_date }}
                                {% elif not order.prod_status and order.max_prod_days %}
                                    {{ order.max_prod_days }} {{ __('termin.days') }}
                                {% else %}
                                    -
                                {% endif %}
                            </th>
                            <td>
                                {% if order.parsedSpeditionNumbers and order.parsedSpeditionNumbers.length > 0 %}
                                    <div class="dropdown" onclick="event.stopPropagation()">
                                        <button
                                            class="btn btn-sm dropdown-toggle"
                                            type="button"
                                            id="trackingDropdown{{ order.id }}"
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="outside"
                                            aria-expanded="false">
                                            {{ order.parsedSpeditionNumbers.length }}
                                            {{ __('orders.tracking_parcels') or 'przesyłek' }}
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="trackingDropdown{{ order.id }}">
                                            {% for tracking in order.parsedSpeditionNumbers %}
                                                {% if tracking.carrier %}
                                                    <li>
                                                        {% if tracking.href %}
                                                            <a class="dropdown-item d-flex align-items-center" href="{{ tracking.href }}" target="_blank" rel="noopener noreferrer">
                                                                <span class="badge bg-primary me-2">{{ tracking.carrier }}</span>
                                                                <span>{{ tracking.code }}</span>
                                                                <i class="bi bi-box-arrow-up-right ms-auto text-muted" style="font-size: 0.85rem;"></i>
                                                            </a>
                                                        {% else %}
                                                            <span class="dropdown-item text-muted d-flex align-items-center">
                                                                <span class="badge bg-secondary me-2">{{ tracking.carrier }}</span>
                                                                <span>{{ tracking.code or tracking.fullCode }}</span>
                                                            </span>
                                                        {% endif %}
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <button type="button" class="action-btn action-btn-copy reorder-btn copy-order-btn stop-propagation has-tooltip" data-id="{{ order.id }}" data-tooltip="{{ __('orders.reorder') }}" aria-label="{{ __('orders.reorder') }}" onclick="event.stopPropagation()">{% include 'partials/reorder_icon.njk' %}</button>
                            </td>
                        {% endblock %}
                        {% block buttons_space %}{% endblock buttons_space %}
                        {% block empty %}
                            <div class="text-center py-5">
                                <h3 class="mb-4">{{ __('orders.nothing_here') }}</h3>
                                <p class="lead">{{ __('orders.you_dont_have_any_sent_order_yet') }}</p>
                            </div>
                        {% endblock empty %}
                        {% block scripts %}
                            <script type="module" src="/scripts/orders.js"></script>
                            <script type="module" src="/scripts/owner/owner.js"></script>
                        {% endblock scripts %}
                    </tr>