{% extends "base.njk" %}
{% block title %}{{ __('pwds.title') or 'Hasła klientów' }}{% endblock title %}
{% block key_nav %}
window.location.href='/'
{% endblock %}
{% block back_link %}
<button class="modern-back-btn" onclick="window.location.href='/'">
    {% endblock %}
    {% block content %}
    <div class="content col-9 center-content">
        <div class="container my-5 mobile-rm-card">
            <h2 class="text-center mb-4 fw-bold">{{ __('pwds.title') or 'Hasła klientów' }}</h2>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <div class="input-group" style="max-width: 350px;">
                    <input type="text" id="pwd-search" class="form-control"
                        placeholder="{{ __('form.search_input_placeholder') or 'Szukaj klienta...' }}"
                        autocomplete="off">
                </div>
                <div class="btn-group btn-group-sm" role="group" id="pwd-sort-group">
                    <button type="button" class="btn btn-outline-secondary active" data-sort="alpha">
                        {{ __('pwds.sort_alpha') or 'A-Z' }}
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-sort="recent">
                        {{ __('pwds.sort_recent') or 'Ostatnio używane' }}
                    </button>
                </div>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="pwd-recent-only">
                    <label class="form-check-label" for="pwd-recent-only">
                        {{ __('pwds.recent_only') or 'Tylko ostatnie 10' }}
                    </label>
                </div>
                <span id="pwd-count" class="text-muted ms-auto"></span>
            </div>

            {% set recentIdents = recentIdents or [] %}
            {% if users and users.length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover table-bordered" id="pwd-table">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>{{ __('base.user') or 'Klient' }}</th>
                            <th>Pin</th>
                            <th>{{ __('login.password_label') or 'Hasło' }}</th>
                            <th>{{ __('pwds.send') or 'Wyślij' }}</th>
                        </tr>
                    </thead>
                    <tbody id="pwd-tbody">
                        {% for user in users %}
                        {% set recentIndex = recentIdents.indexOf(user.ident) %}
                        <tr class="pwd-row" data-recent-index="{{ recentIndex }}">
                            <td class="pwd-index">{{ loop.index }}</td>
                            <td class="pwd-ident">
                                {{ user.ident }}
                                {% if recentIndex > -1 %}
                                <span class="badge bg-light text-secondary border pwd-recent-badge" title="{{ __('pwds.recent_badge_title') or 'Ostatnio wybrany klient' }}">★</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pwd-pin">{{ user.pin }}</span>
                                    <button type="button" class="btn btn-sm btn-outline-dark copy-btn" data-copy="pin">
                                        {{ __('pwds.copy') or 'Kopiuj' }}
                                    </button>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="pwd-value" data-revealed="false">••••••••</span>
                                    <input type="hidden" class="pwd-hidden" value="{{ user.password }}">
                                    <button type="button" class="btn btn-sm btn-outline-secondary pwd-toggle-btn">
                                        {{ __('pwds.show') or 'Pokaż' }}
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-dark copy-btn"
                                        data-copy="password">
                                        {{ __('pwds.copy') or 'Kopiuj' }}
                                    </button>
                                </div>
                            </td>
                            <td>
                                {% if user.email %}
                                <a href="mailto:{{ user.email }}?subject={{ __('pwds.' + orgIdent + '_mail_title') | urlencode }}&body={{ __('pwds.' + orgIdent + '_mail_hello') | urlencode }}%0A%0A{{ __('pwds.' + orgIdent + '_mail_content') | urlencode }}%0A%0A{{ __('pwds.mail_body_pin') | urlencode }}%3A%20{{ user.pin }}%0A{{ __('pwds.mail_body_password') | urlencode }}%3A%20{{ user.password }}%0A%0A{{ __('pwds.' + orgIdent + '_mail_regards') | urlencode }}"
                                    class="btn btn-sm btn-outline-secondary send-mail-btn">
                                    {{ __('pwds.send_to_client') }}
                                </a>
                                {% else %}
                                <span class="text-muted">{{ __('pwds.no_email') or 'Brak email' }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="alert alert-info text-center" role="alert">
                {{ __('pwds.no_data') or 'Brak danych do wyświetlenia.' }}
            </div>
            {% endif %}
        </div>
    </div>
    {% endblock %}
    {% block scripts %}
    <script src="/scripts/pwds.js"></script>
    {% endblock scripts %}