{#
  Widok JEDNEGO nabywcy: jego nazwa, dane, wystawianie dokumentów i jego faktury.

  ⚠️ Osobny ekran, nie kolejna sekcja listy wyboru: dokument zawsze dotyczy
  konkretnego nabywcy, więc kontekst („czyje to faktury") musi być widoczny
  w nagłówku i w adresie. Wcześniej wybór klienta i jego faktury żyły na tej
  samej stronie, co przy dwóch relacjach naraz łatwo prowadziło do wystawienia
  dokumentu nie temu podmiotowi.
#}
{% extends "base.njk" %}

{% block title %}{{ client.client_name }} · {{ L.title }}{% endblock title %}

{% block head %}
  <link rel="stylesheet" href="/styles/orders.css">
  <link rel="stylesheet" href="/styles/invoices.css?v={{ assetVersion }}">
{% endblock head %}

{% block key_nav %}window.location.href='/invoices?level={{ level }}'{% endblock %}

{% block back_link %}
  <button class="modern-back-btn" onclick="window.location.href='/invoices?level={{ level }}'">
{% endblock %}

{% block content %}
  <div class="content center-content">
    <div class="container my-5 w-100 mobile-rm-card">

      <div class="inv-topbar">
        <div>
          <div class="inv-breadcrumb">
            <a href="/invoices?level={{ level }}">{{ L.title }}</a>
            <span aria-hidden="true">›</span>
            <span>{{ levelLabel }}</span>
          </div>
          <h2 class="fw-bold header mb-1">{{ client.client_name }}</h2>
          <div class="inv-subtitle">
            {{ L.price_basis }}: <strong>{{ priceBasisLabels[priceBasis.basis] }}</strong>
            · <span class="inv-badge-currency">{{ L.currency_note }}</span>
          </div>
        </div>
        <div class="inv-topbar__actions">
          <a class="inv-btn inv-btn--ghost" href="/invoices?level={{ level }}">{{ L.change_client }}</a>
        </div>
      </div>

      <section class="inv-card">
        {% include "owner/partials/client_card.njk" %}
      </section>

      {% include "owner/partials/client_documents.njk" %}

    </div>
  </div>

  <script type="application/json" id="inv-labels">{{ L | dump | safe }}</script>
{% endblock content %}

{% block scripts %}
  <script type="module" src="/scripts/owner/invoices.js?v={{ assetVersion }}"></script>
{% endblock scripts %}
