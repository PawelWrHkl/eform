{% extends "order.njk" %}
{% block print_space %}
  <div id="generate-container" class='me-3 d-none d-md-flex'>
    {% block edit_order_btn %}
      {# Zamówienie klienta grupy — bez edycji, patrz utils/orderStatusGuard.js #}
      {% if not clientOwnedOrder %}
      <a
        href="/orders/edit/{{ orderDetails.id }}"
        class="action-btn action-btn-edit row me-2"
        id="edit-order-button"
        type="button">
        {{ __('edit_order.title') }}
      </a>
      {% endif %}
    {% endblock %}
    {% if not isHklClient %}
    <button id="lockBtn" class="btn">
      <img src="/img/open-padlock.png" alt="padlock icon" class='icon'></button>
    {% endif %}
      <button class="btn has-tooltip" data-lock='true' data-tooltip="{{ __('base.generate_short_pdf_tooltip') }}" id='short-print-button'>
        <img src="/img/pdf-short.png" alt="pdf icon" class='icon'></button>
        {% if admin and availableLanguages %}
          <div class="dropdown has-tooltip" data-tooltip="{{ __('order.translate_pdf') }}">
            <button class="btn dropdown-toggle" id='translate-pdf-btn' data-bs-toggle="dropdown">
              <img src="/img/pdf-translate.png" alt="pdf icon" class='icon'>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              {% for lang in availableLanguages %}
                <li><a class="dropdown-item translate-pdf-lang" href="#" data-lang="{{ lang }}">{{ lang | upper }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        <button class="btn has-tooltip" data-lock='true' data-tooltip="{{ __('base.generate_pdf_tooltip') }}" id='print-button'>
          <img src="/img/pdf.png" alt="pdf icon" class='icon'></button>
          <button id="generate-excel-btn" data-lock="true" class="btn has-tooltip" data-tooltip="{{ __('order.generate_excel_tooltip') }}">
            <img src="/img/excel-file.png" alt="excel-file-image" class='icon'></button>
          </div>
        </div>
        <div class="floating-order w-100 mobile d-block d-md-none">
          <h2 class="fw-bold header text-center p-4" id='order-title-mobile' data-id="{{ orderDetails.id }}">
            {{ __('order.title') }}
            {{ orderDetails.order_idx }} <br/>
            {% if orderDetails.commision %}
              <p id='commission-name-mobile' data-name='{{ orderDetails.commision }}'>"{{ orderDetails.commision }}"</p>
            {% endif %}
          </h2>
        </div>

        {% if orderDetails.comment and orderDetails.comment.trim() and orderDetails.comment.trim() != '' and orderDetails.comment.trim() != '-' %}
          <div class="comment-space d-flex align-items-center justify-content-center w-100">
            <h3 id='comment' class='h3 fw-bold btn' data-id="{{ orderDetails.id }}">
              {{ __('order.comment') }}: {{ orderDetails.comment }}
            </h3>
          </div>
        {% else %}
          <div class="comment-space d-flex align-items-center justify-content-center w-100">
            <h3 id='comment' class='h3 fw-bold btn' data-id="{{ orderDetails.id }}"></h3>
          </div>
        {% endif %}
      </div>
    {% endblock %}
    {% block table %}
      {% set globalIndex = 1 %}
      {% for table in cleanOrderItems %}
        <div class="table-scroll mb-5">
          {% block table_style %}
            <!-- Desktop table -->
            <table class="table align-left table-bordered order-table mt-5 d-none d-md-table">
              <thead>
              {% endblock %}
              <tr>
                {% block btns_head %}
                  <th class="edit-buttons">{{ __('order.action') }}</th>
                {% endblock %}
                <th class="edit-buttons">#</th>
                {% for header in table.headers1 %}
                  {% if not(header in table.locked) %}
                    <th class="th-field">{{ header }}</th>
                  {% endif %}
                {% endfor %}
                <th class="edit-buttons">{{ __('order.department') }}</th>
                <th class="edit-buttons">{{ __('order.group_name') }}</th>
                <th class="edit-buttons">{{ __('order.name') }}</th>
                <th class="edit-buttons">{{ __('order.comment') }}</th>
              </tr>
            </thead>
            <tbody>
              {% for rowObj in table.rows %}
                {% block item_redirect %}
                  <tr style="cursor: pointer display:grid" onclick="window.location.href='/position/{{ rowObj.item.id }}'">
                  {% endblock %}
                  {% block pos_btns %}
                    <td
                      class="d-flex align-items-center">

                      {# Pozycje zamówienia klienta grupy: bez przenoszenia, duplikowania,
                         edycji i usuwania — grupa-matka typu `client` ma sam podgląd
                         (utils/orderStatusGuard.js). #}
                      {% if not clientOwnedOrder %}
                      <div class="position-controls d-flex flex-column align-items-center me-2">
                        <button class="btn move-up-btn has-tooltip" data-tooltip="{{ __('order.move_up') }}" data-id="{{ rowObj.item.id }}" onclick="event.stopPropagation()">
                          <svg viewbox="0 0 16 16">
                            <path
                              fill-rule="evenodd"
                              d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5
                                5.707V11.5a.5.5 0 0 0 .5.5z"/>
                          </svg>
                        </button>
                        <button class="btn move-down-btn has-tooltip" data-tooltip="{{ __('order.move_down') }}" data-id="{{ rowObj.item.id }}" onclick="event.stopPropagation()">
                          <svg viewbox="0 0 16 16">
                            <path
                              fill-rule="evenodd"
                              d="M8 4a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5
                                10.293V4.5A.5.5 0 0 1 8 4z"/>
                          </svg>
                        </button>
                      </div>
                      <button class="action-btn action-btn-duplicate me-1 p-1 duplicate-btn has-tooltip" data-tooltip="{{ __('order.duplicate_pos') }}" data-id='{{ rowObj.item.id }}' onclick="event.stopPropagation()">
                        <img src="/img/duplicate.png" class='icon' alt="{{ __('order.edit') }}"></button>
                        <a class="action-btn action-btn-edit me-1 p-1 edit-position-btn has-tooltip" data-tooltip="{{ __('order.edit_pos') }}" href="/position/{{ rowObj.item.id }}/edit?id={{ rowObj.item.id }}" onclick="event.stopPropagation()">
                          <img src="/img/edit-text.png" alt="{{ __('order.edit') }}"></a>
                          <button class="action-btn action-btn-delete p-1 delete-position-btn has-tooltip" data-tooltip="{{ __('order.delete_pos') }}" type="button" data-id="{{ rowObj.item.id }}" data-href="/position/{{ rowObj.item.id }}/delete" onclick="event.stopPropagation()">
                            <img src="/img/delete.png" alt="{{ __('order.delete') }}"/>
                          </button>
                      {% endif %}
                        {% endblock %}
                      </td>
                      <th scope="row">{{ globalIndex }}</th>
                      {% for header in table.headers1 %}
                        {% if (not(header in rowObj.item.lockedParams)) %}
                          <td class="td-val">{{ rowObj.row.row1[header] or '-' }}</td>
                        {% endif %}
                      {% endfor %}
                      <td>{{ rowObj.item.department or '-' }}</td>
                      <td>{{ rowObj.item.group_name or '-' }}</td>
                      <td>{{ rowObj.item.commision | truncate(20, true, "...") or "-" }}</td>
                      <td>{{ rowObj.item.comment | truncate(30, true, "...") }}</td>
                    </tr>
                    {% if not (isClient and hasSubPrices) and showCatalogPrices %}
                    <tr class="price-row">
                      <td colspan="100%" class="sub-params-cell">
                        <div class="sub-params-container">
                          {% for header in table.headers2 %}
                            {% if (not(header in rowObj.item.lockedParams)) %}
                              {% set value = rowObj.row.row2[header] %}
                              {% if value and value != '-' and value != '' %}
                                <span class="sub-param-item">
                                  <span class="sub-param-label">{{ header }}:</span>
                                  <b class="sub-param-value">{{ value }}</b>
                                </span>
                              {% endif %}
                            {% endif %}
                          {% endfor %}
                        </div>
                      </td>
                    </tr>
                      {% if total and not hasSubPriceToggle %}
                        <tr class="price-row sub-params-locked-row">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for header in table.headers1 %}
                                {% if (header in rowObj.item.lockedParams) %}
                                  {% set lockedVal = rowObj.row.row1[header] or rowObj.row.row2[header] %}
                                  {% if lockedVal and lockedVal != '-' and lockedVal != '' %}
                                    <span class="sub-param-item gold">
                                      <span class="sub-param-label">{{ header }}:</span>
                                      <b class="sub-param-value">{{ lockedVal }}</b>
                                    </span>
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                              {% for header in table.headers2 %}
                                {% if (header in rowObj.item.lockedParams) %}
                                  {% set value = rowObj.row.row1[header] or rowObj.row.row2[header] %}
                                  {% if value and value != '-' and value != '' %}
                                    <span class="sub-param-item gold">
                                      <span class="sub-param-label">{{ header }}:</span>
                                      <b class="sub-param-value">{{ value }}</b>
                                    </span>
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                                {% endif %}
                      {% endif %}
                      {% if isClient and hasSubPrices and rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                        <tr class="sub-params-row" style="display: table-row;">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for entry in rowObj.item.subParamValues %}
                                {% if entry.value and entry.value != '-' and entry.value != '' and not entry.locked %}
                                  <span class="sub-param-item">
                                    <span class="sub-param-label">{{ entry.display }}:</span>
                                    <b class="sub-param-value">{{ entry.value }}</b>
                                  </span>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                        <tr class="sub-params-row sub-params-locked-row" style="display: table-row;">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for entry in rowObj.item.subParamValues %}
                                {% if entry.value and entry.value != '-' and entry.value != '' and entry.locked %}
                                  <span class="sub-param-item">
                                    <span class="sub-param-label">{{ entry.display }}:</span>
                                    <b class="sub-param-value">{{ entry.value }}</b>
                                  </span>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                      {% endif %}
                      {% if hasSubPriceToggle and rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                        <tr class="sub-params-row" style="display: table-row;">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for entry in rowObj.item.subParamValues %}
                                {% if entry.value and entry.value != '-' and entry.value != '' and not entry.locked %}
                                  <span class="sub-param-item">
                                    <span class="sub-param-label">{{ entry.display }}:</span>
                                    <b class="sub-param-value">{{ entry.value }}</b>
                                  </span>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                        <tr class="sub-params-row sub-params-locked-row" style="display: table-row;">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for entry in rowObj.item.subParamValues %}
                                {% if entry.value and entry.value != '-' and entry.value != '' and entry.locked %}
                                  <span class="sub-param-item gold">
                                    <span class="sub-param-label">{{ entry.display }}:</span>
                                    <b class="sub-param-value">{{ entry.value }}</b>
                                  </span>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                      {% endif %}
                      {% set itemHasSubVals = rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                      {% if (isClient or hasSubPriceToggle or canViewSubPrices or viewAsOrganization) and not itemHasSubVals and total %}
                        <tr class="price-row">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for header in table.headers2 %}
                                {% if (not(header in rowObj.item.lockedParams)) %}
                                  {% set value = rowObj.row.row2[header] %}
                                  {% if value and value != '-' and value != '' %}
                                    <span class="sub-param-item">
                                      <span class="sub-param-label">{{ header }}:</span>
                                      <b class="sub-param-value">{{ value }}</b>
                                    </span>
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                        <tr class="price-row sub-params-locked-row">
                          <td colspan="100%" class="sub-params-cell">
                            <div class="sub-params-container">
                              {% for header in table.headers1 %}
                                {% if (header in rowObj.item.lockedParams) %}
                                  {% set lockedVal = rowObj.row.row1[header] or rowObj.row.row2[header] %}
                                  {% if lockedVal and lockedVal != '-' and lockedVal != '' %}
                                    <span class="sub-param-item gold">
                                      <span class="sub-param-label">{{ header }}:</span>
                                      <b class="sub-param-value">{{ lockedVal }}</b>
                                    </span>
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                              {% for header in table.headers2 %}
                                {% if (header in rowObj.item.lockedParams) %}
                                  {% set value = rowObj.row.row1[header] or rowObj.row.row2[header] %}
                                  {% if value and value != '-' and value != '' %}
                                    <span class="sub-param-item gold">
                                      <span class="sub-param-label">{{ header }}:</span>
                                      <b class="sub-param-value">{{ value }}</b>
                                    </span>
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                            </div>
                          </td>
                        </tr>
                      {% endif %}
                      {% set itemProdDays = itemProductionDays[rowObj.item.id] %}
                      <tr class="prod-time-row">
                        <td colspan="100%">
                          <div class="prod-time-row-cell">
                            <span class="prod-time-label">{{ __('order.production_time_label') }}</span>
                            {% if itemProdDays %}
                              <span class="prod-days-item">{{ itemProdDays }} {{ __('termin.days') }}</span>
                              <span class="prod-days-max">/ {{ maxProdDays }} {{ __('termin.days') }}</span>
                            {% else %}
                              <span class="text-muted">-</span>
                            {% endif %}
                          </div>
                        </td>
                      </tr>
                                {% set globalIndex = globalIndex + 1 %}
                              {% endfor %}
                            </tbody>
                          </table>

                          <div class="mobile-items-list d-block d-md-none">
                            {% set mobileIndex = globalIndex - table.rows.length %}
                            {% for rowObj in table.rows %}
                              {% set mobileIndex = mobileIndex + 1 %}
                              <div class="mobile-item-card" data-position-url="/position/{{ rowObj.item.id }}">
                                <div class="mobile-item-header">
                                  <div class="mobile-item-basic">
                                    <span class="mobile-item-name">{{ rowObj.item.commision | truncate(25, true, "...") or "-" }}</span>
                                    <span class="mobile-item-group">{{ rowObj.item.group_name or '-' }}</span>
                                  </div>
                                  <span class="mobile-item-number">#{{ mobileIndex }}</span>
                                </div>
                                <div class="mobile-item-details">
                                  <div class="mobile-item-detail">
                                    <strong>{{ __('order.department') }}:</strong>
                                    <br>
                                      {{ rowObj.item.department or '-' }}
                                    </div>
                                  {% set itemProdDays = itemProductionDays[rowObj.item.id] %}
                                  {% if itemProdDays %}
                                    <div class="mobile-item-detail">
                                      <strong>{{ __('order.production_time_short_label') }}</strong>
                                      <br>
                                        <span class="prod-days-item">{{ itemProdDays }} {{ __('termin.days') }}</span>
                                        <span class="prod-days-max">({{ __('order.commission_time_prefix') }} {{ maxProdDays }} {{ __('termin.days') }})</span>
                                    </div>
                                  {% endif %}
                                  </div>
                                  {% if table.headers1.length > 0 %}
                                    <div class="mobile-item-specs">
                                      {% for header in table.headers1 %}
                                        {% if not(header in rowObj.item.lockedParams) %}
                                          <div class="mobile-spec-item">
                                            <strong>{{ header }}:</strong>
                                            {{ rowObj.row.row1[header] or '-' }}
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                  {% endif %}
                                  {% if table.headers2.length > 0 and not (isClient and hasSubPrices) and showCatalogPrices %}
                                    <div class="mobile-sub-params mobile-item-prices">
                                      {% for header in table.headers2 %}
                                        {% if not(header in rowObj.item.lockedParams) %}
                                          <div class="mobile-sub-param-item">
                                            <strong>{{ header }}:</strong>
                                            <b class="sub-param-value">{{ rowObj.row.row2[header] or '-' }}</b>
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                  {% endif %}
                                  {% if isClient and hasSubPrices and rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                                    <div class="mobile-sub-params" style="display: block;">
                                      {% for entry in rowObj.item.subParamValues %}
                                        {% if entry.value and entry.value != '-' and entry.value != '' and not entry.locked %}
                                          <div class="mobile-sub-param-item">
                                            <strong>{{ entry.display }}:</strong> <b class="sub-param-value">{{ entry.value }}</b>
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                    <div class="mobile-sub-params mobile-sub-params-locked" style="display: block;">
                                      {% for entry in rowObj.item.subParamValues %}
                                        {% if entry.value and entry.value != '-' and entry.value != '' and entry.locked %}
                                          <div class="mobile-sub-param-item">
                                            <strong>{{ entry.display }}:</strong> <b class="sub-param-value">{{ entry.value }}</b>
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                  {% endif %}
                                  {% if hasSubPriceToggle and rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                                    <div class="mobile-sub-params" style="display: block;">
                                      {% for entry in rowObj.item.subParamValues %}
                                        {% if entry.value and entry.value != '-' and entry.value != '' and not entry.locked %}
                                          <div class="mobile-sub-param-item">
                                            <strong>{{ entry.display }}:</strong> <b class="sub-param-value">{{ entry.value }}</b>
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                    <div class="mobile-sub-params mobile-sub-params-locked" style="display: block;">
                                      {% for entry in rowObj.item.subParamValues %}
                                        {% if entry.value and entry.value != '-' and entry.value != '' and entry.locked %}
                                          <div class="mobile-sub-param-item gold">
                                            <strong>{{ entry.display }}:</strong> <b class="sub-param-value">{{ entry.value }}</b>
                                          </div>
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                  {% endif %}
                                  {% set itemHasSubValsM = rowObj.item.subParamValues and rowObj.item.subParamValues.length > 0 %}
                                  {% if (isClient or hasSubPriceToggle or canViewSubPrices or viewAsOrganization) and not itemHasSubValsM and total %}
                                    <div class="mobile-sub-params mobile-item-prices" style="display: block;">
                                      {% for header in table.headers2 %}
                                        {% if not(header in rowObj.item.lockedParams) %}
                                          {% set value = rowObj.row.row2[header] %}
                                          {% if value and value != '-' and value != '' %}
                                            <div class="mobile-sub-param-item">
                                              <strong>{{ header }}:</strong> <b class="sub-param-value">{{ value }}</b>
                                            </div>
                                          {% endif %}
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                    <div class="mobile-sub-params mobile-sub-params-locked" style="display: block;">
                                      {% for header in table.headers1 %}
                                        {% if (header in rowObj.item.lockedParams) %}
                                          {% set lockedVal = rowObj.row.row1[header] or rowObj.row.row2[header] %}
                                          {% if lockedVal and lockedVal != '-' and lockedVal != '' %}
                                            <div class="mobile-sub-param-item gold">
                                              <strong>{{ header }}:</strong> <b class="sub-param-value">{{ lockedVal }}</b>
                                            </div>
                                          {% endif %}
                                        {% endif %}
                                      {% endfor %}
                                      {% for header in table.headers2 %}
                                        {% if (header in rowObj.item.lockedParams) %}
                                          {% set value = rowObj.row.row1[header] or rowObj.row.row2[header] %}
                                          {% if value and value != '-' and value != '' %}
                                            <div class="mobile-sub-param-item gold">
                                              <strong>{{ header }}:</strong> <b class="sub-param-value">{{ value }}</b>
                                            </div>
                                          {% endif %}
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                  {% endif %}
                                  {% if rowObj.item.comment %}
                                    <div class="mobile-item-comment">
                                      <strong>{{ __('order.comment') }}:</strong>
                                      <br>
                                        {{ rowObj.item.comment }}
                                      </div>
                                    {% endif %}
                                    <div class="mobile-item-actions">
                                      <div
                                        {# Pozycje zamówienia klienta grupy: bez przenoszenia, duplikowania,
                                           edycji i usuwania — grupa-matka typu `client` ma sam podgląd
                                           (utils/orderStatusGuard.js). #}
                                        {% if not clientOwnedOrder %}
                                        class="position-controls d-flex flex-column align-items-start me-2"
                                        style="display: inline-flex !important; flex-direction: row !important;">
                                        <button class="btn move-up-btn has-tooltip" data-tooltip="{{ __('order.move_up') }}" data-id="{{ rowObj.item.id }}" onclick="event.stopPropagation()">
                                          <svg viewbox="0 0 16 16">
                                            <path
                                              fill-rule="evenodd"
                                              d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5
                                                5.707V11.5a.5.5 0 0 0 .5.5z"/>
                                          </svg>
                                        </button>
                                        <button class="btn move-down-btn has-tooltip" data-tooltip="{{ __('order.move_down') }}" data-id="{{ rowObj.item.id }}" onclick="event.stopPropagation()">
                                          <svg viewbox="0 0 16 16">
                                            <path
                                              fill-rule="evenodd"
                                              d="M8 4a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5
                                                10.293V4.5A.5.5 0 0 1 8 4z"/>
                                          </svg>
                                        </button>
                                      </div>
                                      <button class="action-btn action-btn-duplicate duplicate-btn" data-id='{{ rowObj.item.id }}' onclick="event.stopPropagation()">
                                        {{ __('order.duplicate') }}
                                      </button>
                                      <a
                                        class="action-btn action-btn-edit"
                                        href="/position/{{ rowObj.item.id }}/edit?id={{ rowObj.item.id }}"
                                        onclick="event.stopPropagation()">
                                        {{ __('order.edit') }}
                                      </a>
                                      <button class="action-btn action-btn-delete delete-position-btn" data-id="{{ rowObj.item.id }}" data-href="/position/{{ rowObj.item.id }}/delete" onclick="event.stopPropagation()">
                                        {{ __('order.delete') }}
                                      </button>
                                        {% endif %}
                                    </div>
                                  </div>
                                {% endfor %}
                              </div>
                            </div>
                          {% endfor %}
                          {% if totalPrice %}
                            <div id='total-container' data-sub-total="{{ totalPrice.subVisible or 0 }}" data-prices-unlocked="true">
                              {% if isClient and hasSubPrices %}
                                <div class="total-price d-flex justify-content-end align-items-center col-12">
                                  <span class='total price-label sub-total col-3 text-center p-price'>
                                    {% if totalPrice.subVisible and totalPrice.subVisible != 0 %}
                                    HKL {{ __('order.total') }}: {{ totalPrice.subVisible }}&#8364;</span>
                                    {% else %}
                                      {{ __('order.according_to_price') }}</span>
                                    {% endif %}
                                </div>
                                {% if totalPrice.subLocked and totalPrice.subLocked != 0 %}
                                <div class="total-price d-flex justify-content-end align-items-center col-12">
                                  <span class='total gold price-label col-3 text-center'>
                                    {{ __('order.total_hidden') }}: {{ totalPrice.subLocked }}&#8364; netto</span>
                                </div>
                                {% endif %}
                              {% elif hasSubPriceToggle and hasSubPrices %}
                                {% if showCatalogPrices %}
                                <div class="total-price d-flex justify-content-end align-items-center col-12">
                                  <span class='total price-label col-3 text-center'>
                                    {% if totalPrice.visible != '0.00' %}
                                      HKL {{ __('order.total') }}: {{ totalPrice.visible | applyFactor(priceFactor) }}&#8364;</span>
                                    {% else %}
                                      {{ __('order.according_to_price') }}</span>
                                    {% endif %}
                                </div>
                                {% endif %}
                                {% if totalPrice.subVisible and totalPrice.subVisible != 0 %}
                                <div class="total-price d-flex justify-content-end align-items-center col-12">
                                  <span class='total price-label sub-total col-3 text-center'>
                                    {% if showCatalogPrices %}{% endif %}{{ __('order.total') }}: {{ totalPrice.subVisible | applyFactor(priceFactor) }}&#8364;</span>
                                </div>
                                {% endif %}
                                {% if totalPrice.subLocked and totalPrice.subLocked != 0 %}
                                <div class="total-price d-flex justify-content-end align-items-center col-12">
                                  <span class='total gold price-label col-3 text-center'>
                                    {{ __('order.total_hidden') }}: {{ totalPrice.subLocked | applyFactor(priceFactor) }}&#8364; netto</span>
                                </div>
                                {% endif %}
                              {% else %}
                              <div class="total-price d-flex justify-content-end align-items-center col-12">
                                <span class='total price-label col-3 text-center'>
                                  {% if totalPrice.visible != '0.00' %}
                                    {% if not (isClient or hasSubPriceToggle or canViewSubPrices or viewAsOrganization) %}HKL{% endif %}{{ __('order.total') }}: {{ totalPrice.visible }}&#8364;</span>
                                {% else %}
                                  {{ __('order.according_to_price') }}</span>
                              {% endif %}
                            </div>
                            <div class="total-price d-flex justify-content-end align-items-center col-12">
                              <span class='total gold price-label col-3  text-center'>
                                {% if totalPrice.hidden != '0.00' %}
                                  {{ __('order.total_hidden') }}: {{ totalPrice.hidden }}&#8364; netto</span>
                              {% else %}
                                {{ __('order.according_to_price') }}</span>
                            {% endif %}
                              {% endif %}
                          {% endif %}
                        </div>
                      </div>
                    {% endblock %}
                    {% block print_template %}
                      {% include 'order_to_print.njk' %}
                    {% endblock %}
                  </tr>
                </td>
              </tr>