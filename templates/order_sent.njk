{% block head %}
    <link rel="stylesheet" href="/styles/order_details.css">
    <link rel="stylesheet" href="/styles/mobile/order_details.css">
        <link rel="stylesheet" href="/styles/order_sent.css">
            <link rel="stylesheet" href="/styles/mobile/order_sent.css">
                <link rel="stylesheet" href="/styles/dialog.css">
                <link rel="stylesheet" href="/styles/mobile/dialog.css">
                <link rel="stylesheet" href="/styles/mobile/order-view.css?v={{ assetVersion }}">
                <link rel="stylesheet" href="/styles/orderCancel.css?v={{ assetVersion }}">
                    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/canvg@3.0.10/lib/umd.min.js"></script>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                {% endblock head %}
                {% extends "order.njk" %}
                {% block order_del_btn %}{% endblock %}
                {% block mobile_order_buttons %}{% endblock %}
                {% block order_title_mobile %}{{ __('history_order.title') }}{% endblock %}
                {% block order_title %}
                    {{ __('history_order.title') }}
                {% endblock %}
                {% block order_notice %}
                    {% include 'partials/order_cancellation.njk' %}
                    {# „Zgłoś problem” → kreator serwisu z tym zleceniem (partials/service_report_btn.njk).
                       Pulpit tutaj; telefon przy sumie (blok send_order_btn), bo górę przykrywa #order-nav. #}
                    {% set svcOrderId = orderDetails.id %}{% set svcOrderStatus = orderDetails.status %}
                    <div class="svc-report-wrap d-none d-md-flex">{% include 'partials/service_report_btn.njk' %}</div>
                {% endblock %}
                {% block table_style %}
                    <table class="table align-left table-striped order-table">
                        <thead class='thead-dark'>
                        {% endblock %}
                        {% block item_redirect %}
                            <tr style="cursor: pointer" onclick="window.location.href='/position/{{ rowObj.item.id }}'">
                            {% endblock %}
                            {% block btns_head %}{% endblock %}
                            {% block pos_btns %}{% endblock %}
                            {% block extra_rows %}
                                {% set statusIdx = globalIndex - 1 %}
                                <tr class="status-row" id='status-row-{{ rowObj.item.id }}'>
                                    <td class="status-cell" colspan="100%">{% include 'partials/sent_status_cards.njk' %}</td>
                                </tr>
                            {% endblock %}
                            {% block mobile_item_actions %}
                                {# Telefon: wysłanego się nie edytuje — zamiast Duplikuj/Edytuj/Usuń status pozycji (ten sam fragment co w tabeli). #}
                                {% set statusIdx = mobileIndex - 1 %}
                                {% set itemProdDays = itemProductionDays[rowObj.item.id] %}
                                <div class="mobile-item-status">{% include 'partials/sent_status_cards.njk' %}</div>
                            {% endblock %}
                            {% block new_pos_btn %}{% endblock %}
                            {% block send_order_btn %}
                                {# Telefon: ten sam komunikat przy sumie (patrz partials/order_cancellation.njk). #}
                                {% set noticePlacement = 'bottom' %}
                                {% include 'partials/order_cancellation.njk' %}
                                <div class="svc-report-wrap d-flex d-md-none">{% include 'partials/service_report_btn.njk' %}</div>
                                {# Anulowanego nie cofamy do aktywnych — serwer i tak odmówi
                                   (routes/orders.js toggle-status). #}
                                {% if admin and orderDetails.status != 'canceled' %}
                                    <div class="d-flex justify-content-end w-100 p-2">
                                        <button class="btn btn-sm"
                                            style="background:#fff3cd;border:1px solid #ffc107;color:#664d03;font-size:0.8rem;"
                                            data-order-id="{{ orderDetails.id }}"
                                            onclick="adminToggleOrderStatus(this)">
                                            &#9881; Cofnij do aktywnych
                                        </button>
                                    </div>
                                {% endif %}
                            {% endblock %}
                            {% block order_space %}
                                <div class="floating-history-order d-none d-md-block">
                                {% endblock %}
                                {% block scripts %}
                                    <script type='module' src="/scripts/order.js"></script>
                                    <script src="/scripts/mobileCards.js"></script>
                                    <script src="/scripts/stickyColumns.js"></script>
                                                                    <script src="/scripts/tableTooltips.js"></script>
                                    <script type='module' src="/scripts/order_sent.js"></script>
                                    <script type='module' src="/scripts/orderCancel.js?v={{ assetVersion }}"></script>
                                    {% if admin %}
                                    <script>
                                    async function adminToggleOrderStatus(btn) {
                                        btn.disabled = true;
                                        try {
                                            const orderId = btn.dataset.orderId;
                                            const res = await fetch(`/orders/order/${orderId}/toggle-status`, {
                                                method: 'PATCH',
                                                headers: { 'Content-Type': 'application/json' }
                                            });
                                            const data = await res.json();
                                            if (data.success) {
                                                if (data.status === 'sent') {
                                                    location.href = `/orders/history/order/${orderId}`;
                                                } else {
                                                    location.href = `/orders/order/${orderId}`;
                                                }
                                            } else {
                                                alert('B\u0142\u0105d: ' + (data.message || 'Nieznany b\u0142\u0105d'));
                                                btn.disabled = false;
                                            }
                                        } catch (e) {
                                            alert('B\u0142\u0105d po\u0142\u0105czenia');
                                            btn.disabled = false;
                                        }
                                    }
                                    </script>
                                    {% endif %}
                                {% endblock %}
                                {% block edit_order_btn %}{% endblock %}
                                {% block estimatedProdDate %}{% endblock estimatedProdDate %}