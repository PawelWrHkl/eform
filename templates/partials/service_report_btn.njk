{# „Zgłoś problem” — wejście do kreatora serwisu z wybranym zleceniem (routes/service.js GET /service/new?order=ID).
   Tylko przy włączonym module (`serviceEnabled`, server.js) i dla zlecenia wysłanego, nieanulowanego.
   Zakres konta sprawdza serwer; ten przycisk renderują listy, które już pokazują tylko zlecenia konta.
   Wymaga `svcOrderId` i `svcOrderStatus` ustawionych przed include. #}
{% if serviceEnabled and svcOrderStatus == 'sent' %}
    <a href="/service/new?order={{ svcOrderId }}"
       class="btn svc-report-btn stop-propagation has-tooltip"
       data-tooltip="{{ __('service.report_button') }}"
       aria-label="{{ __('service.report_button') }}"
       onclick="event.stopPropagation()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <span>{{ __('service.report_button') }}</span>
    </a>
{% endif %}
