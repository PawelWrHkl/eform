{% extends "base.njk" %}
{% block title %}
  {{ __('form.title') }}
{% endblock title %}
{% block head %}
  <link rel="stylesheet" href="/styles/dialog.css">
    <link rel="stylesheet" href="/styles/slope.css">
      <link rel="stylesheet" href="/styles/components.css">
        <link rel="stylesheet" href="/styles/form_btn.css">
          <link rel="stylesheet" href="/styles/mobile/dialog.css">
            <link rel="stylesheet" href="/styles/mobile/slope.css">
              <link rel="stylesheet" href="/styles/mobile/components.css">
              {# Mobile ETAP 1 - layout konfiguratora. Musi byc ostatni,
                 bo nadpisuje mobile/form.css i mobile/components.css. #}
              <link rel="stylesheet" href="/styles/mobile/configurator.css?v={{ assetVersion }}">
              {# Mobile - przebudowa dialogu wyboru wartosci. Po configurator.css,
                 bo nadpisuje takze mobile/dialog.css z linii wyzej. #}
              <link rel="stylesheet" href="/styles/mobile/dialog-view.css?v={{ assetVersion }}">
              {% endblock head %}
              {% block key_nav %}
              {% endblock %}
              {% block back_link %}
                <button class="modern-back-btn" onclick="window.location.href='/orders/order/{{ orderId }}'">
                {% endblock %}
                {% block content %}
                  <form action="save" class='full-form' id="commission-form">
                    <p id="orderId" class='d-none'>{{ orderId }}</p>
                    <div class='content'>
                      <h1>{{ __('form.header') }}</h1>
                      <div class="container asortment-container">
                        <div class='d-flex justify-content-xxl-start asortment-inputs'>
                          <div class='commission-space d-flex col-3'>
                            <div class="comm-input d-grid col-12">
                              <label for="commision-inputs">1.{{ __('form.commission_label') }}</label>
                              <input type="text" class='validate' id="commission-input" maxlength="32" placeholder="{{ __('form.commission_placeholder') }}" "></div>
                            </div>
                            <div class="col-2 d-flex flex-column gr-select">
                              <label for="department">2.{{ __('form.department_label') }}</label>
                              <select name="department" id="department-select" class="form-select"></select>
                            </div>
                            <div class="col-2 d-flex flex-column gr-select">
                              <label for="asortment-group">3.{{ __('form.group_label') }}</label>
                              <select name="asortment-group" id="asortment-group-select" class="form-select"></select>
                            </div>
                          </div>
                        </div>
                        <div class="container order-reminder">
                          <h3>{{ __('form.reminder') }}</h3>
                          <div id="dynamic-form"></div>
                          <div id="file-error-message" class="alert alert-danger d-none w-100" role="alert"></div>
                          <div id="buttons-space" class='justify-content-center'>
                            <button class="btn btn-outline-success form-button col-9" type='button' id='show-button'>
                              {{ __('form.save_button') }}
                            </button>
                            <button class="btn btn-outline-danger form-button mt-3" type='button' id='reset-button'>
                              {{ __('form.reset_button') }}
                            </button>
                            <div id="attachment-space">
                              <div class="attachment-label"></div>
                              <div id="attachment-container">

                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </form>
                    <dialog id="color-dialog">
                      <div id="dialog-toast-container"></div>
                      <div id="dialog-container" class="d-grid">
                        <h3 id="dialog-title" class="text-center">{{ __('form.dialog_title') }}</h3>
                        <div id="dynamic-options-list" class="options-scrollable"></div>
                        <div id='additional-info' class='d-grid col-12 w-100'></div>
                        <div class="bottom">
                          <div class="button-wrapper">
                            <button id="dialog-confirm" class="btn btn-success me-2" type="button">
                              {{ __('form.apply_button') }}
                            </button>
                            <button id="dialog-close" class="btn btn-secondary" type="button">
                              {{ __('form.cancel_button') }}
                            </button>
                          </div>
                          <div class="obj-counter">
                            <label for="object-count">{{ __('form.object_count') }}:</label>
                            <span id="object-count">sdassd</span>
                          </div>
                        </div>
                      </div>
                    </dialog>
                    <dialog id="image-preview-dialog" class="image-preview-dialog">
                      <button id="close-dialog-btn" class="close-dialog-btn" type='button'>✖</button>
                      <img id="preview-image" src="" alt="{{ __('form.preview_alt') }}"/>
                    </dialog>
                    <div id='version-space'></div>
                    <div class="hourglass"></div>
                    <div class="overlay"></div>
                  {% endblock content %}
                  {% block scripts %}
                    {# Whole VAT block only exists while features.vat is on (config.js).
                       Off — production default — nothing below is emitted, so
                       window.vatEnabled stays undefined and form.js builds no VAT fields. #}
                    {# Rabat klienta grupy (`group_user.discount_percent`) — doliczany po
                       przeliczeniu ceny przez silnik, patrz pricesCalculator.js
                       (applyClientDiscount). 0 = brak rabatu, czyli zachowanie jak dotąd. #}
                    <script>
                      window.clientDiscountPercent = {{ clientDiscountPercent | default(0) | dump | safe }};
                      // Ile z powyzszego to 1% za korzystanie z serwisu (nowi klienci
                      // LUXANGMBH) — do WIDOCZNEGO wiersza informacyjnego w
                      // pricesCalculator.applyClientDiscount(). Sam procent jest juz
                      // wliczony w clientDiscountPercent, wiec kwota schodzi raz.
                      window.portalUsageDiscountPercent = {{ portalUsageDiscountPercent | default(0) | dump | safe }};
                    </script>
                    {% if vatEnabled %}
                    <script>
                      // Server-computed VAT rate (services/vatCalculator.js) — domestic sale
                      // (organization country == user country) uses that country's rate,
                      // cross-border sale is 0%. Read by pricesCalculator.js when computing
                      // WARTOSC_BRUTTO from SUB___SUMA_BRUTTO (net despite its "BRUTTO" name;
                      // falls back to SUB___WARTOSC_KONCOWA where SUB___SUMA_BRUTTO doesn't exist).
                      window.vatEnabled = true;
                      window.vatRate = {{ vatRate | default(0) | dump | safe }};
                      window.vatReason = {{ vatReason | default("unknown") | dump | safe }};
                      window.isHklOrg = {{ isHklOrg | default(false) | dump | safe }};
                    </script>
                    {% endif %}
                    <script type="module" src="/scripts/main.js"></script>
                    <script type="module" src="/scripts/tools/betterNumberValidator.js"></script>
                    {# Mobile ETAP 1 - stepper (wskaznik postepu + scroll do sekcji).
                       Czysto prezentacyjny, nie dotyka wartosci ani widocznosci pol -
                       szczegoly w naglowku samego pliku. Na desktopie konczy dzialanie
                       na pierwszym `matchMedia`, wiec nie wykonuje tam nic. #}
                    <script src="/scripts/mobile/configuratorStepper.js?v={{ assetVersion }}" defer></script>
                  {% endblock scripts %}