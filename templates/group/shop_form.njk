{% extends "base.njk" %}
{% block title %}
    {% if mode === 'edit' %}{{ __(gk('shop_form_title_edit')) }}{% else %}{{ __(gk('shop_form_title_new')) }}{% endif %}
{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/styles/group/shops.css">
{% endblock %}

{% block key_nav %}
    window.history.back()
{% endblock %}

{% block back_link %}
    <button class="modern-back-btn" onclick="window.history.back()">
{% endblock %}

{% block content %}
    <div class="content col-12 center-content">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-secondary text-white">
                        <h3 class="mb-0">
                            {% if mode === 'edit' %}
                                {{ __(gk('shop_form_title_edit')) }}
                            {% else %}
                                {{ __(gk('shop_form_title_new')) }}
                            {% endif %}
                        </h3>
                    </div>
                    <div class="card-body">

                        {% if error %}
                            <div class="alert alert-danger">{{ error }}</div>
                        {% endif %}

                        <form method="POST" novalidate
                              action="{% if mode === 'edit' %}/group/shops/{{ shop.id }}{% else %}/group/shops{% endif %}">

                            <div class="row g-3">

                                {% if mode === 'new' %}
                                <div class="col-12">
                                    <div class="sf-preview">
                                        <div class="sf-preview-item">
                                            <span class="sf-preview-label">{{ __('group.sf_ident') }}</span>
                                            <span class="sf-preview-value">{{ ident }}</span>
                                        </div>
                                        <div class="sf-preview-divider"></div>
                                        <div class="sf-preview-item">
                                            <span class="sf-preview-label">{{ __('group.sf_pin_login') }}</span>
                                            <span class="sf-preview-value font-monospace">{{ pin }}</span>
                                        </div>
                                    </div>
                                    <small class="form-text text-muted">{{ __('group.sf_pin_auto_hint') }}</small>
                                </div>
                                {% endif %}

                                {% if mode === 'edit' %}
                                <div class="col-md-6">
                                    <label class="form-label">{{ __('group.sf_ident') }}</label>
                                    <input type="text" class="form-control" value="{{ shop.ident }}" readonly disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">{{ __('group.sf_pin_login') }}</label>
                                    <input type="text" class="form-control" value="{{ shop.pin }}" readonly disabled>
                                </div>
                                {% endif %}

                                <div class="col-md-6">
                                    <label for="password" class="form-label {% if mode !== 'edit' %}required{% endif %}">
                                        {{ __('group.sf_password') }}{% if mode === 'edit' %} <small class="text-muted">({{ __('group.sf_password_keep_blank') }})</small>{% endif %}
                                    </label>
                                    <div class="input-group">
                                        <input type="password"
                                               class="form-control"
                                               id="password"
                                               name="password"
                                               {% if mode !== 'edit' %}required minlength="5"{% endif %}
                                               placeholder="{% if mode === 'edit' %}{{ __('group.sf_password_new_placeholder') }}{% else %}{{ __('group.sf_password') }}{% endif %}"
                                               autocomplete="new-password">
                                        <button class="btn btn-outline-secondary" type="button" id="toggle-password" title="{{ __('group.sf_password_toggle') }}">
                                            <img class="icon" src="/img/eye.png" id="password-icon">
                                        </button>
                                        <button class="btn btn-outline-secondary" type="button" id="gen-password" title="{{ __('group.sf_password_generate') }}">
                                            &#x21bb;
                                        </button>
                                    </div>
                                    {% if mode !== 'edit' %}
                                        <small class="form-text text-muted">{{ __('group.sf_password_min_or_gen') }} <span id="gen-hint"></span></small>
                                    {% endif %}
                                    <div class="invalid-feedback">{{ __('group.sf_password_invalid') }}</div>
                                </div>

                                {# `group_user.send_order_policy` — ukryte `0` idzie zawsze,
                                   bo odznaczony checkbox nie wysyła nic (routes/group.js
                                   parseSendOrderPolicy). #}
                                <div class="col-12">
                                    <input type="hidden" name="send_order_policy" value="0">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               id="send_order_policy"
                                               name="send_order_policy"
                                               value="1"
                                               {% if sendOrderPolicy %}checked{% endif %}>
                                        <label class="form-check-label" for="send_order_policy">{{ __('group.sf_send_order_policy') }}</label>
                                    </div>
                                    <small class="form-text text-muted">{{ __('group.sf_send_order_policy_hint') }}</small>
                                </div>

                                <hr class="col-12 mt-2">
                                <p class="col-12 mb-0 fw-semibold text-secondary">{{ __('group.sf_address_data') }}</p>

                                <div class="col-12">
                                    <label for="name" class="form-label">{{ __(gk('sf_shop_name')) }}</label>
                                    <input type="text"
                                           class="form-control"
                                           id="name"
                                           name="name"
                                           maxlength="150"
                                           value="{{ shop.name or '' }}"
                                           placeholder="{{ __(gk('sf_shop_name_placeholder')) }}">
                                    <small class="form-text text-muted">{{ __(gk('sf_shop_name_hint')) }}</small>
                                </div>

                                <div class="col-12">
                                    <label for="street" class="form-label">{{ __('group.sf_street') }}</label>
                                    <input type="text"
                                           class="form-control"
                                           id="street"
                                           name="street"
                                           maxlength="200"
                                           value="{{ shop.street or '' }}"
                                           placeholder="{{ __('new-order.street_placeholder') }}">
                                </div>

                                <div class="col-md-4">
                                    <label for="zip" class="form-label">{{ __('group.sf_zip') }}</label>
                                    <input type="text"
                                           class="form-control"
                                           id="zip"
                                           name="zip"
                                           maxlength="20"
                                           value="{{ shop.zip or '' }}"
                                           placeholder="12345">
                                </div>

                                <div class="col-md-8">
                                    <label for="city" class="form-label">{{ __('group.sf_city') }}</label>
                                    <input type="text"
                                           class="form-control"
                                           id="city"
                                           name="city"
                                           maxlength="100"
                                           value="{{ shop.city or '' }}"
                                           placeholder="{{ __('new-order.city_placeholder') }}">
                                </div>

                                <div class="col-md-6">
                                    <label for="tax_id" class="form-label">{{ __('group.sf_tax_id') }}</label>
                                    <input type="text"
                                           class="form-control"
                                           id="tax_id"
                                           name="tax_id"
                                           maxlength="30"
                                           value="{{ shop.tax_id or '' }}">
                                </div>

                                <div class="col-md-6">
                                    <label for="phone" class="form-label">{{ __('group.sf_phone') }}</label>
                                    <input type="tel"
                                           class="form-control"
                                           id="phone"
                                           name="phone"
                                           maxlength="50"
                                           pattern="^\+?[\d\s\-().]{6,}$"
                                           value="{{ shop.phone or '' }}"
                                           placeholder="+1 234 567 890">
                                    <div class="invalid-feedback">{{ __('group.sf_phone_invalid') }}</div>
                                </div>

                                {# Rabat klienta — tylko dla grupy typu `client`
                                   (`user.group_type`). Doliczany po przeliczeniu ceny w
                                   formularzu pozycji, patrz services/groupDiscount.js. #}
                                {% if isGroupClientType %}
                                <div class="col-md-6">
                                    <label for="discountPercent" class="form-label">{{ __('group.sf_discount') }}</label>
                                    <div class="input-group">
                                        <input type="number"
                                               class="form-control"
                                               id="discountPercent"
                                               name="discountPercent"
                                               min="0"
                                               max="100"
                                               step="0.01"
                                               value="{{ shop.discount_percent if shop and shop.discount_percent else '0' }}">
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <small class="form-text text-muted">{{ __('group.sf_discount_hint') }}</small>
                                </div>
                                {% endif %}

                                <div class="col-md-6">
                                    <label for="email" class="form-label">{{ __('group.sf_email') }}</label>
                                    <input type="email"
                                           class="form-control"
                                           id="email"
                                           name="email"
                                           maxlength="100"
                                           value="{{ shop.email or '' }}"
                                           placeholder="shop@example.com">
                                    <div class="invalid-feedback">{{ __('group.sf_email_invalid') }}</div>
                                </div>

                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="/group/panel?tab=shops" class="btn btn-secondary">
                                    {{ __('group.cancel_btn') }}
                                </a>
                                <button type="submit" class="btn btn-dark">
                                    {% if mode === 'edit' %}{{ __('group.sf_save_edit') }}{% else %}{{ __(gk('sf_save_new')) }}{% endif %}
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block scripts %}
<script src="/scripts/group/shop_form.js"></script>
{% endblock %}
