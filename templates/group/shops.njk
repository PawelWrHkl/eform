{% extends "base.njk" %}
{% block title %}{{ __(gk('shops_page_title')) }}{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/styles/group/shops.css">
{% endblock %}

{% block key_nav %}
    window.location.href = '/'
{% endblock %}

{% block back_link %}
    <button class="modern-back-btn" onclick="window.location.href='/'">
{% endblock %}

{% block content %}
    <div class="content col-9 center-content">
        <div class="container my-4">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="mb-0">{{ __(gk('shops_page_title')) }}</h2>
                <a href="/group/shops/new" class="action-btn action-btn-add">
                    + {{ __(gk('add_shop_btn')) }}
                </a>
            </div>

            {% if success === 'added' %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ __(gk('alert_shop_added')) }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% elif success === 'updated' %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ __(gk('alert_shop_updated')) }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            {% if error === 'notfound' %}
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    {{ __(gk('alert_shop_notfound')) }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            {% if shops and shops.length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover table-bordered group-shops-table">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>{{ __('group.col_name') }}</th>
                                <th>{{ __('group.sf_ident') }}</th>
                                <th>{{ __('group.col_pin_login') }}</th>
                                <th>{{ __('group.sf_city') }}</th>
                                <th>{{ __('group.col_email') }}</th>
                                <th class="text-center">{{ __('group.col_actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for shop in shops %}
                                <tr data-shop-id="{{ shop.id }}">
                                    <td>{{ loop.index }}</td>
                                    <td>{{ shop.name or '—' }}</td>
                                    <td>
                                        <span class="fw-semibold">{{ shop.name or shop.ident }}</span>
                                    </td>
                                    <td>
                                        <code>{{ shop.pin }}</code>
                                    </td>
                                    <td>{{ shop.city or '—' }}</td>
                                    <td>{{ shop.email or '—' }}</td>
                                    <td class="text-center shop-actions">
                                        <a href="/group/shops/{{ shop.id }}/edit"
                                           class="action-btn action-btn-edit me-1"
                                           title="{{ __('group.edit_btn') }}">
                                            {{ __('group.edit_btn') }}
                                        </a>
                                        <button type="button"
                                                class="action-btn action-btn-delete btn-delete-shop"
                                                data-shop-id="{{ shop.id }}"
                                                data-shop-name="{{ shop.name or shop.ident }}"
                                                title="{{ __('group.delete_btn') }}">
                                            {{ __('group.delete_btn') }}
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state text-center py-5">
                    <p class="text-muted mb-3">{{ __(gk('shops_empty')) }}</p>
                    <a href="/group/shops/new" class="action-btn action-btn-add">
                        + {{ __(gk('add_first_shop_btn')) }}
                    </a>
                </div>
            {% endif %}

        </div>
    </div>

    <!-- Modal potwierdzenia usunięcia -->
    <div class="modal fade" id="deleteShopModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ __(gk('modal_delete_shop_title')) }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    {{ __(gk('modal_delete_shop_q')) }}
                    <strong id="deleteShopName"></strong>?
                    <br>
                    <small class="text-muted">{{ __('group.modal_irreversible') }}</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('group.cancel_btn') }}</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteShop">{{ __('group.delete_btn') }}</button>
                </div>
            </div>
        </div>
    </div>

    <script type="module" src="/scripts/group/shops.js"></script>
{% endblock %}
