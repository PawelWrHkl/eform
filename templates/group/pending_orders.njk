{% extends "base.njk" %}
{% block title %}{{ __('group.pending_page_title') }}{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/styles/group/shops.css">
{% endblock %}

{% block key_nav %}
    window.location.href = '/group/shops'
{% endblock %}

{% block back_link %}
    <button class="modern-back-btn" onclick="window.location.href='/group/shops'">
{% endblock %}

{% block content %}
    <div class="content col-9 center-content">
        <div class="container my-4">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="mb-0">{{ __(gk('pending_h2')) }}</h2>
                <a href="/group/shops" class="btn btn-outline-secondary btn-sm">
                    ← {{ __(gk('back_to_shops')) }}
                </a>
            </div>

            {% if orders and orders.length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>{{ __('group.col_order_no') }}</th>
                                <th>{{ __(gk('col_shop')) }}</th>
                                <th>{{ __('group.col_commission') }}</th>
                                <th>{{ __('group.col_comment') }}</th>
                                <th>{{ __('group.col_date') }}</th>
                                <th class="text-end">{{ __('group.col_actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr>
                                    <td>
                                        <a href="/orders/order/{{ order.id }}" target="_blank" class="fw-semibold">
                                            {{ order.order_idx or '—' }}
                                        </a>
                                    </td>
                                    <td>{{ order.shop_name or order.shop_ident }}</td>
                                    <td>{{ order.commission or '—' }}</td>
                                    <td class="text-muted small">{{ order.comment or '—' }}</td>
                                    <td class="text-muted small">{{ order.created_at | date if order.created_at else '—' }}</td>
                                    <td class="text-end">
                                        <button class="btn btn-success btn-sm me-1 js-approve-btn"
                                                data-order-id="{{ order.id }}">
                                            {{ __('group.approve_send_btn') }}
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm js-reject-btn"
                                                data-order-id="{{ order.id }}">
                                            {{ __('group.reject_btn') }}
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info" role="alert">
                    {{ __('group.pending_empty') }}
                </div>
            {% endif %}

        </div>
    </div>

    {# Modal potwierdzenia zatwierdzenia #}
    <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="approveModalLabel">{{ __('group.modal_approve_title') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('group.close_btn') }}"></button>
                </div>
                <div class="modal-body">
                    {{ __('group.modal_approve_body') }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('group.cancel_btn') }}</button>
                    <button type="button" class="btn btn-success" id="approveConfirmBtn">{{ __('group.approve_send_btn') }}</button>
                </div>
            </div>
        </div>
    </div>

    {# Modal potwierdzenia odrzucenia #}
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">{{ __('group.modal_reject_title') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('group.close_btn') }}"></button>
                </div>
                <div class="modal-body">
                    {{ __(gk('modal_reject_body')) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('group.cancel_btn') }}</button>
                    <button type="button" class="btn btn-danger" id="rejectConfirmBtn">{{ __('group.reject_btn') }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/scripts/group/pending_orders.js"></script>
{% endblock %}
