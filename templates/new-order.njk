                                                        {# <input type="hidden" id="country_code"/> #}
                                                        {# {% endblock country_input %} #}
                                                    </div>
                                                </div>
                                                <div class="row mb-3 align-items-start mt-3 d-flex">
                                                    <div class="col-md-3 text-start fw-semibold pt-2 mobile-d-none">
                                                        <label for="address-select" class="mb-0"></label>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2 col-9" id="send-address-checkbox-container">
                                                        <input type="checkbox" class="form-check-input m-0" id="show-send-address-checkbox"/>
                                                        <label class="form-check-label m-0" for="show-send-address-checkbox">
                                                            {% block checkbox_address2 %}
                                                                {{ __('new-order.send_chcekbox_address_label') }}
                                                            {% endblock %}
                                                        </label>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none pt-3">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendName">{{ __('new-order.client_name') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_name_input %}
                                                                <input type="text" class="form-control" id="sendName" placeholder="{{ __('new-order.client_name_placeholder') }}" value=""/>
                                                            {% endblock send_name_input %}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendEmail">{{ __('new-order.email') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_email_input %}
                                                                <input type="text" class="form-control" id="sendEmail" placeholder="{{ __('new-order.email_placeholder') }}" value=""/>
                                                            {% endblock send_email_input %}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendPhone">{{ __('new-order.phone') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_phone_input %}
                                                                <input type="tel" class="form-control" id="sendPhone" pattern="^(?:\+|00)?[\d\s\-().]{6,}$" placeholder="{{ __('new-order.phone_placeholder') }}" value=""/>
                                                            {% endblock send_phone_input %}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendStreet">{{ __('new-order.street') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_street_input %}
                                                                <input type="text" class="form-control" id="sendStreet" placeholder="{{ __('new-order.street_placeholder') }}" value=""/>
                                                            {% endblock send_street_input %}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendCity">{{ __('new-order.city') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_city_input %}
                                                                <input type="text" class="form-control" id="sendCity" placeholder="{{ __('new-order.city_placeholder') }}" value=""/>
                                                            {% endblock send_city_input %}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendZip">{{ __('new-order.zip') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_zip_input %}
                                                                <input type="text" class="form-control" id="sendZip" placeholder="{{ __('new-order.zip_placeholder') }}" value=""/>
                                                            {% endblock send_zip_input %}
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center new-send-addr d-none">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="sendCountry">{{ __('new-order.country') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block send_country_input %}
                                                                <input class="form-control" type="text" id="sendCountry"/>
                                                                <input type="hidden" id="sendCountry_code"/>
                                                            {% endblock send_country_input %}
                                                        </div>
                                                    </div>
                                                    <!--noeeew end -->
                                                    <div class="row mb-3 align-items-center mobile-rm-row-paddding">
                                                        <div class="col-md-3 text-start fw-semibold">
                                                            <label for="comment">{{ __('new-order.comments') }}</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            {% block comment_input %}
                                                                <textarea type="text" class="form-control" id="comment" placeholder="{{ __('new-order.comments_placeholder') }}" cols="20" rows="2" maxlength="250"></textarea>
                                                                <small id="charCount">0/250</small>
                                                            {% endblock comment_input %}
                                                        </div>
                                                    </div>
                                                    <div class="d-flex justify-content-center gap-3 text-center ms-5 mobile-rm-d-flex">
                                                        {% block sendBbtn %}
                                                            <button class="btn btn-outline-success p-2 col-3" type="button" id="save-order-btn" data-href="/orders/save-order">
                                                                {{ __('new-order.save_button') }}
                                                            </button>
                                                        {% endblock sendBbtn %}
                                                        <a href="/" class='btn btn-outline-danger p-2 col-3'>
                                                            {{ __('form.cancel_button') }}</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endblock content %}
                            {% block scripts %}
                                <script src="/vendor/country-select-js/build/js/countrySelect.min.js"></script>
                                <script type="module" src="/scripts/orders.js"></script>
                                <script type="module" src="/scripts/new-order.js"></script>
                                <script type="module" src="/scripts/createNewAddress.js"></script>
                                {% if invoicesEnabled %}
                                  {# Moduł faktur wyłączony flagą → nie ładujemy nawet skryptu sekcji odbiorcy #}
                                  <script type="module" src="/scripts/orderEndClient.js"></script>
                                {% endif %}
                            {% endblock scripts %}