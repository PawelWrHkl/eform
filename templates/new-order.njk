{% extends "base.njk" %}
{% block title %}
    {{ __('new-order.page_title') }}
{% endblock title %}
{% block key_nav %}
    window.location.href='/'
{% endblock %}
{% block back_link %}
    <button class="modern-back-btn" onclick="window.location.href='/'">
    {% endblock %}
    {% block head %}
        <link rel="stylesheet" href="/styles/mobile/new-order.css">
            <link rel="stylesheet" href="/vendor/country-select-js/build/css/countrySelect.css"/>
            <link rel="stylesheet" href="/styles/new-order.css">
                <link rel="stylesheet" href="/styles/new-address-modal.css">
                    <style>
                        .country-select .flag {
                            background-image: url("/vendor/country-select-js/build/img/flags.png");
                        }
                    </style>
                    <script src="/vendor/country-select-js/build/js/countrySelect.min.js"></script>
                    {# Mobile ETAP 2 - ostatni w bloku, bo nadpisuje mobile/new-order.css
                       (ktory ma wlasny breakpoint 935px i jest ladowany tuz wyzej). #}
                    <link rel="stylesheet" href="/styles/mobile/order-form.css?v={{ assetVersion }}">
                {% endblock %}
                {% block content %}
                    <div class="content col-9 center-content mobile-bg-white">
                        <div class="my-5">
                            <h2 class="p-3 mobile-rm-p">
                                {% block order_title %}
                                    {{ __('new-order.h1') }}
                                {% endblock order_title %}
                            </h2>
                            <div class="row justify-content-center">
                                <div id="new-order-card" class="card m-3 mb-5 col-md-6 shadow-lg mobile-rm-card mobile-rm-m">
                                    <div class="card-body">
                                        <div class="row mb-3 align-items-center mt-3">
                                            <div class="col-md-3 text-start fw-semibold">
                                                <label for="commission-input">{{ __('new-order.order_name') }}</label>
                                            </div>
                                            <div class="col-md-9">
                                                {% block commision_input %}
                                                    <input type="text" maxlength="60" class="form-control validate" id="commission-input" placeholder="{{ __('new-order.order_name_placeholder') }}" value=""/>
                                                {% endblock commision_input %}
                                            </div>
                                        </div>
                                        {# ---------- Odbiorca końcowy (opcjonalnie) ----------
                                           Spięcie zamówienia z odbiorcą z kartoteki fakturowej: dzięki
                                           temu fakturę dla niego wystawia się potem wprost z panelu
                                           faktur, bez szukania zamówienia po numerze. Sekcja jest
                                           zwinięta pod checkboxem, bo dotyczy mniejszości zamówień. #}
                                        {% block end_client_section %}
                                          {% if invoicesEnabled %}
                                            <div class="row mb-3 align-items-start mt-3" id="end-client-row">
                                                <div class="col-md-3 text-start fw-semibold pt-2 mobile-d-none">
                                                    <label class="mb-0" for="end-client-input">{{ __('new-order.end_client') }}</label>
                                                </div>
                                                <div class="col-md-9">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <input type="checkbox" class="form-check-input m-0" id="end-client-checkbox"
                                                               {% if selectedEndClient %}checked{% endif %}/>
                                                        <label class="form-check-label m-0" for="end-client-checkbox">
                                                            {{ __('new-order.end_client_checkbox') }}
                                                        </label>
                                                    </div>
                                                    {# Pole wyszukiwania, NIE lista <select>: odbiorców salonu może
                                                       być bardzo dużo, więc podpowiedzi lecą z endpointu. #}
                                                    <div id="end-client-container" class="d-flex align-items-center gap-2 mt-2 {% if not selectedEndClient %}d-none{% endif %}">
                                                        <div class="end-client-combo flex-grow-1">
                                                            <input type="text" class="form-control" id="end-client-input"
                                                                   placeholder="{{ __('new-order.end_client_placeholder') }}"
                                                                   value="{{ selectedEndClient.name if selectedEndClient else '' }}"
                                                                   role="combobox" aria-expanded="false" aria-controls="end-client-list" aria-autocomplete="list"
                                                                   autocomplete="off"/>
                                                            {# `data-was-linked` mówi skryptowi, że zamówienie MA już odbiorcę — dzięki
                                                               temu odznaczenie checkboxa wysyła odpięcie, a nie milczy. #}
                                                            <input type="hidden" id="end-client-id" value="{{ selectedEndClient.id if selectedEndClient else '' }}"
                                                                   {% if selectedEndClient %}data-was-linked="1"{% endif %}/>
                                                            <div class="end-client-combo__list" id="end-client-list" role="listbox"></div>
                                                        </div>
                                                        <button type="button" id="add-end-client-btn" class="btn btn-outline-success"
                                                                title="{{ __('new-order.end_client_add') }}">+</button>
                                                    </div>
                                                    <small class="text-muted d-block mt-1 {% if not selectedEndClient %}d-none{% endif %}" id="end-client-hint">
                                                        {{ __('new-order.end_client_hint') }}
                                                    </small>
                                                </div>
                                            </div>
                                          {% endif %}
                                        {% endblock end_client_section %}

                                        <div class="row mb-3 align-items-start mt-3 ">
                                            <div class="col-md-3 text-start fw-semibold pt-2 mobile-d-none">
                                                <label for="address-select" class="mb-0" id='address-label'>{{ __('new_order.address') }}</label>
                                            </div>
                                            <div class="col-md-9">
                                                <div class="d-flex align-items-center gap-2" id="address-checkbox-container">
                                                    <input type="checkbox" class="form-check-input m-0" id="show-addresses-checkbox"/>
                                                    <label class="form-check-label m-0" for="show-addresses-checkbox">
                                                        {% block checkbox_label %}
                                                            {{ __('new-order.chcekbox_address_label') }}
                                                        {% endblock %}
                                                    </label>
                                                </div>
                                                <div id="address-dropdown-container" class="d-flex align-items-center gap-2">
                                                    {% block client_select %}
                                                        <select id="address-select" name="selected_address" class="form-select mb-0 flex-grow-1">
                                                            {% block selected_address_option %}
                                                                <option value="" {% if not selectedAddrId %} selected {% endif %} disabled>{{ __('new-order.select_address') }}</option>
                                                            {% endblock %}
                                                            {% for address in addr %}
                                                                <option value="{{ address.id }}" {% if selectedAddrId and address.id == selectedAddrId %} selected {% endif %}>
                                                                    <p class='fw-bold'>{{ address.name }} &nbsp;&nbsp; {{ address.mail }} ({{ address.street }}
                                                                        {{ address.city }}
                                                                        {{ address.zip }}
                                                                        {{ address.country }})
                                                                    </option>
                                                                {% endfor %}
                                                            </select>
                                                        {% endblock %}
                                                        <div class='manipulate-address d-flex'>
                                                            <button id='edit-delivery-address-btn' class='btn p-0 ms-1 has-tooltip d-none' data-tooltip="{{ __('order.edit_address') }}">
                                                                <img src="/img/edit_address.png" alt="edit address" class='icon '/>
                                                            </button>
                                                            <button id='delete-delivery-address-btn' class='btn p-0 ms-2 has-tooltip d-none' data-tooltip="{{ __('order.delete_address') }}">
                                                                <img src="/img/delete_address.png" alt="delete address" class='icon '/>
                                                            </button>
                                                        </div>
                                                        <div class='add-new-address'>
                                                            <button id='add-delivery-address-btn' class='btn p-0 ms-4 has-tooltip' data-tooltip="{{ __('order.create_address') }}">
                                                                <img src="/img/add_address.png" alt="add new address" class='icon'/>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div id="mail-dropdown-container" class="d-flex align-items-center gap-2 mt-2">
                                                        <select id="mail-select" name="selected_mail" class="form-select mb-0 flex-grow-1">
                                                            <option value="" {% if not selectedMailId %} selected {% endif %} disabled>{{ __('order.select_email_address') }}</option>
                                                            {% for email in emails %}
                                                                <option value="{{ email.id }}" {% if selectedMailId and email.id == selectedMailId %} selected {% endif %}>
                                                                    <p class='fw-bold'>{{ email.email }}</option>
                                                                {% endfor %}
                                                            </select>
                                                            <div class='manipulate-mail d-flex'>
                                                                <button id='edit-mail-btn' class='btn p-0 ms-1 has-tooltip d-none' data-tooltip="{{ __('order.edit_mail') }}">
                                                                    <img src="/img/edit_mail.png" alt="edit address" class='icon '/>
                                                                </button>
                                                                <button id='delete-mail-btn' class='btn p-0 ms-2 has-tooltip d-none' data-tooltip="{{ __('order.delete_mail') }}">
                                                                    <img src="/img/delete_mail.png" alt="delete address" class='icon '/>
                                                                </button>
                                                            </div>
                                                            <div class='add-new-address'>
                                                                <button id='add-mail-btn' class='btn p-0 ms-4 has-tooltip' data-tooltip="{{ __('order.create_mail') }}">
                                                                    <img src="/img/mail.png" alt="add new address" class='icon'/>
                                                                </button>
                                                            </div>
                                                        </div>
