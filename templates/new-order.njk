                                                        {# {% block city_input %} #}
                                                        {# <input type="text" class="form-control" id="city" placeholder="{{ __('new-order.city_placeholder') }}" value=""/> #}
                                                        {# {% endblock city_input %} #}
                                                        {# </div> #}
