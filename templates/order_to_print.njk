{% from "_pdf_cell.njk" import pdfCell, pdfCellBold %}
{% block title %}{% endblock title %}
{% block head %}
    <style>
        .order-print {
            font-family: 'Segoe UI', 'DejaVu Sans', Arial, 'Liberation Sans', sans-serif;
            padding: 0;
            margin: 0;
        }
        .margin {
            height: 10px !important;
        }
        .print-logo {
            width: 200px;
            margin: 0;
            display: block;
        }
        .print-header {
            font-size: 18px;
            font-weight: bold;
            text-align: center;
            margin: 0 0 10px;
            padding: 0;
        }
        .print-header-subtitle {
            font-size: 16px;
            text-align: center;
            margin: 0 0 5px;
        }
        .print-header-comment {
            text-align: center;
            margin: 0 0 10px;
            font-size: 14px;
        }
        .print-table-container {
            margin-bottom: 40px !important;
            page-break-inside: avoid;
            break-inside: avoid;
        }
        .print-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #000;
            font-size: 14px;
            margin-bottom: 20px;
            page-break-inside: avoid;
            break-inside: avoid;
        }
        .print-table td,
        .print-table th {
            border: 1px solid #000;
            padding: 4px 6px;
            text-align: left;
            vertical-align: top;
            word-break: normal;
            overflow-wrap: break-word;
            hyphens: auto;
        }
        .print-table th {
            background-color: #e0e0e0;
            font-weight: bold;
            font-size: 14px;
        }
        .print-table td {
            font-size: 14px;
        }
        .pdf-val {
            font-size: 200%;
        }
        .print-table tr {
            page-break-inside: avoid;
            break-inside: avoid;
        }
        .print-table tbody tr:not(.print-price-row) {
            page-break-after: avoid;
        }
        .print-price-row td {
            background-color: #f5f5f5;
            font-size: 14px;
            padding: 2px 4px 10px !important;
        }
        .print-price {
            padding-bottom: 10px !important;
            font-size: 14px;
        }
        .print-price-label {
            font-weight: bold;
            margin-right: 3px;
        }
        .print-hidden-price {
            background-color: #b7b8a8ff !important;
            font-size: 14px !important;
            padding-bottom: 10px !important;
        }
        /* Rabat klienta grupy — bursztynowy akcent, ten sam co na ekranie
           (`.client-discount-row`, public/styles/order_details.css).
           Specificity musi bić `.print-price-row td` (szare tło wiersza cen)
           — sam `.print-discount-price` by przegrał. */
        .print-price-row td.print-discount-price {
            background-color: hsl(28 75% 95%) !important;
        }
        /* Ta sama informacja w podsumowaniu, pod ilością sztuk — tu wystarczy
           sam kolor tekstu, bez tła (nie siedzi w tabeli cen). */
        .print-total-items.print-discount-price {
            color: hsl(28 55% 32%) !important;
        }
        .print-total-price {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 20px;
            font-size: 14px;
            font-weight: bold;
            margin-top: 20px;
            padding: 10px 10% 10px 10px;
        }
        .print-total-items {
            font-size: 14px;
            font-weight: bold;
            text-align: right;
            margin-top: 10px;
            margin-bottom: 20px;
            padding: 6px 10% 6px 10px;
        }
        .order-details {
            font-size: 12px !important;
            line-height: 1.4 !important;
            border: 1px solid #ccc !important;
            border-radius: 5px !important;
            padding: 10px !important;
            margin: 20px 0 !important;
            width: 40% !important;
            min-width: 40% !important;
            max-width: 40% !important;
            box-sizing: border-box !important;
        }
        .client-details {
            display: flex !important;
            gap: 270px !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
        .order-details-line {
            font-size: 20px !important;
            margin: 4px 0 !important;
        }
        .header-3 {
            font-size: 26px !important;
            font-weight: bold !important;
            margin-bottom: 10px !important;
        }
        .mb-4,
        .p-4,
        .position-relative {
            margin: 0 !important;
            padding: 0 !important;
        }
        .d-flex {
            display: flex;
        }
        .justify-content-end {
            justify-content: flex-end;
        }
        .align-items-center {
            align-items: center;
        }
        @media print {
            .print-table-container {
                page-break-inside: avoid !important;
            }
            .print-table {
                page-break-inside: avoid !important;
            }
            .print-table tr {
                page-break-inside: avoid !important;
            }
        }
    </style>
{% endblock head %}
<div class="order-print">
    <div class="position-relative mb-4">
        {% if logoPath %}
            <img alt="logo" class="print-logo" src="{{ logoPath }}">
            {% else %}
                <img alt="logo" class="print-logo" src="/img/logo.png">
                {% endif %}
                <h2 class="fw-bold print-header text-center p-4">
                    {{ __('order.title') }}
                    <span class="pdf-val">{{ orderDetails.order_idx }}</span>
                </h2>
                {% if orderDetails.commision %}
                    <h2 class="print-header-subtitle">"<span class="pdf-val">{{ orderDetails.commision }}</span>"</h2>
                {% endif %}
                {% if orderDetails.comment %}
                    <div class="print-header-comment">
                        <strong>{{ __('order.comment') }}:</strong>
                        <span class="pdf-val">{{ orderDetails.comment }}</span>
                    </div>
                {% endif %}
            </div>
            {% set clientView = clientView | default(false) %}
            {% set showBoth = showBoth | default(false) %}
            {% set showClientDiscount = showClientDiscount | default(false) %}
            {% set hideClientVat = hideClientVat | default(false) %}
            {% set globalIndex = 1 %}
            {% for table in cleanOrderItems %}
                <div class="print-table-container">
                    <table class="print-table table align-left table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                {% for header in table.headers1 %}
                                    {% if not(header in table.locked) %}
                                        <th class="print-th-field">{{ header }}</th>
                                    {% endif %}
                                {% endfor %}
                                <th>{{ __('order.department') }}</th>
                                <th>{{ __('order.group_name') }}</th>
                                <th>{{ __('order.name') }}</th>
                                <th>{{ __('order.comment') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rowObj in table.rows %}
                                <tr>
                                    <td><span class="pdf-val">{{ globalIndex }}</span></td>
                                    {% for header in table.headers1 %}
                                        {% if not(header in rowObj.item.lockedParams) %}
                                            {% block values_representation %}
                                                <td class="print-td-val">{{ pdfCell(rowObj.row.row1[header]) }}</td>
                                            {% endblock %}
                                        {% endif %}
                                    {% endfor %}
                                    <td>{{ pdfCell(rowObj.item.department) }}</td>
                                    <td>{{ pdfCell(rowObj.item.group_name) }}</td>
                                    <td>{{ pdfCell(rowObj.item.commision) }}</td>
                                    <td>{{ pdfCell(rowObj.item.comment) }}</td>
                                </tr>
                                <tr class="print-price-row">
                                    {# ⚠️ Konto podrzędne grupy (`group_user`) traktujemy tu jak widok klienta:
                                       NIE dostaje cen katalogowych (`table.headers2`), tylko własne ceny
                                       `SUB___` niżej. Bez tego druk/PDF pokazywał mu „CENA HKL" i wartości
                                       zakupu grupy. #}
                                    {% if not clientView and not isGroupShop %}
                                    {% for header in table.headers2 %}
                                        {# ⚠️ VAT katalogowy (organizacje HKL: klucze `VAT`/`WARTOSC_VAT`/
                                           `WARTOSC_BRUTTO` bez prefiksu `SUB___`, patrz pricesCalculator.js
                                           `isHklOrg`) idzie tu jak zwykły parametr — grupa typu `client`
                                           nie ma go widzieć, tak jak wersji SUB niżej. #}
                                        {% set headerKey = table.headerKeys2[loop.index0] or '' %}
                                        {% set isVatRow = hideClientVat and (headerKey.endsWith('||VAT') or headerKey.endsWith('||WARTOSC_VAT') or headerKey.endsWith('||WARTOSC_BRUTTO')) %}
                                        {% if not(header in rowObj.item.lockedParams) and not isVatRow %}
                                            <td class="print-price" colspan="2">
                                                <span class="print-price-label">{{ header }}:</span>
                                                <b>{{ pdfCellBold(rowObj.row.row2[header]) }}</b>
                                            </td>
                                        {% endif %}
                                    {% endfor %}
                                    {% endif %}
                                    {% if clientView or showBoth or isGroupShop %}
                                    {% for entry in rowObj.item.subParamValues %}
                                        {# ⚠️ VAT nie jest `locked`, więc bez tego warunku wychodziłby razem
                                           z resztą SUB — grupa typu `client` nie ma go widzieć w PDF, tak
                                           jak na ekranie (`templates/order.njk`). #}
                                        {% set isVatRow = hideClientVat and (entry.key == 'SUB___VAT' or entry.key == 'SUB___WARTOSC_VAT' or entry.key == 'SUB___WARTOSC_BRUTTO') %}
                                        {% if entry.value and entry.value != '-' and entry.value != '' and not entry.locked and not isVatRow %}
                                            <td class="print-price" colspan="2">
                                                <span class="print-price-label">{{ entry.display }}:</span>
                                                <b>{{ pdfCellBold(entry.value) }}</b>
                                            </td>
                                        {% endif %}
                                    {% endfor %}
                                    {% endif %}
                                    {# Rabat klienta grupy — kłódka "Pokaż cenę po rabacie" (order.njk),
                                       rozstrzygnięta server-side przy generowaniu PDF (routes/orders.js). #}
                                    {% if showClientDiscount and rowObj.item.clientDiscountValues and rowObj.item.clientDiscountValues.length > 0 %}
                                    {% for entry in rowObj.item.clientDiscountValues %}
                                        {% if entry.value and entry.value != '-' and entry.value != '' %}
                                            <td class="print-price print-discount-price" colspan="2">
                                                <span class="print-price-label">{{ entry.display }}:</span>
                                                <b>{{ pdfCellBold(entry.value) }}</b>
                                            </td>
                                        {% endif %}
                                    {% endfor %}
                                    {% endif %}
                                </tr>
                                {# ⚠️ Ceny „złote" (parametry `locked` bez SUB___) to ceny wewnętrzne
                                   HKL — przy zamówieniu z cenami klienta nie idą na wydruk, tak samo
                                   jak na ekranie (patrz komentarz w services/mailBot/order-pdf.njk). #}
                                {% if prices and not clientView and not isGroupShop and not hasSubPrices %}
                                    <tr class="print-price-row">
                                        {% for header in table.headers1 %}
                                            {% if header in rowObj.item.lockedParams %}
                                                <td class="print-price" colspan="2">
                                                    <span class="print-price-label">{{ header }}:</span>
                                                    <b>{{ pdfCellBold(rowObj.row.row1[header] or rowObj.row.row2[header]) }}</b>
                                                </td>
                                            {% endif %}
                                        {% endfor %}
                                        {% for header in table.headers2 %}
                                            {% if header in rowObj.item.lockedParams %}
                                                <td class="print-hidden-price" colspan="2">
                                                    <span class="print-price-label">{{ header }}:</span>
                                                    <b>{{ pdfCellBold(rowObj.row.row1[header] or rowObj.row.row2[header]) }}</b>
                                                </td>
                                            {% endif %}
                                        {% endfor %}
                                    </tr>
                                {% endif %}
                                {% if prices and (clientView or showBoth) %}
                                    <tr class="print-price-row">
                                        {% for entry in rowObj.item.subParamValues %}
                                            {% if entry.value and entry.value != '-' and entry.value != '' and entry.locked %}
                                                <td class="print-hidden-price" colspan="2">
                                                    <span class="print-price-label">{{ entry.display }}:</span>
                                                    <b>{{ pdfCellBold(entry.value) }}</b>
                                                </td>
                                            {% endif %}
                                        {% endfor %}
                                    </tr>
                                {% endif %}
                                {% set globalIndex = globalIndex + 1 %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endfor %}
            {% if maxProdDays %}
                <div class="print-total-items">
                    {{ __('order.production_time_label') }} <span class="pdf-val">{{ maxProdDays }}</span> {{ __('termin.days') }}
                </div>
            {% endif %}
            <div class="print-total-items">
                {{ __('order.total_items') }}: <span class="pdf-val">{{ globalIndex - 1 }}</span>
            </div>
            {# Rabat eForma zaraz pod ilością sztuk — ta sama informacja co przy
               pozycjach (routes/orders.js → `clientDiscountSummary`). #}
            {% if clientDiscountSummary %}
                <div class="print-total-items print-discount-price">
                    {{ clientDiscountSummary.label or __('form.client_discount_label') }}:
                    <span class="pdf-val">{{ clientDiscountSummary.percent }}</span>
                </div>
            {% endif %}
            {# ⚠️ Konto podrzędne grupy (`group_user`) NIE MOŻE widzieć sumy katalogowej
   (to cena zakupu grupy) — ani na ekranie, ani w druku/PDF generowanym z tego
   szablonu. Dostaje wyłącznie swoją sumę (`totalPrice.sub`) niżej. #}
{% if prices and sendData and sendData.total and not isGroupShop %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label col-3 text-center'>
                            {{ sendData.total | replace(__('order.total') + ': ', '') }}
                        </span>
                    </div>
                </div>
            {% elif totalPrice and not clientView and not isGroupShop %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label col-3 text-center'>
                            {% if totalPrice.visible != '0.00' %}
                                {{ __('order.total') }}: <span class="pdf-val">{{ totalPrice.visible }}&#8364;</span>
                            {% else %}
                                Według cennika
                            {% endif %}
                        </span>
                    </div>
                </div>
            {% elif isGroupShop and totalPrice and totalPrice.subVisible and totalPrice.subVisible != 0 %}
                {# Konto podrzędne dostaje w druku tę samą sumę, którą widzi na ekranie
                   przed kłódką: sumę „WARTOŚĆ BR.[€]" swoich pozycji. Wartość po rabacie
                   zostaje pod kłódką na ekranie i nie idzie do wydruku. #}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label col-3 text-center'>
                            {{ __('order.total') }}: <span class="pdf-val">{{ totalPrice.subVisible }}&#8364;</span>
                        </span>
                    </div>
                </div>
            {% elif totalPrice and clientView and totalPrice.subVisible and totalPrice.subVisible != 0 %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label col-3 text-center'>
                            {{ __('order.total') }}: <span class="pdf-val">{{ totalPrice.subVisible }}&#8364;</span>
                        </span>
                    </div>
                </div>
            {% endif %}
            {% if prices and sendData and sendData.total_hidden and not isGroupShop %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total gold price-label col-3 text-center'>
                            {{ sendData.total_hidden | replace(__('order.total_hidden') + ': ', '') }}
                        </span>
                    </div>
                </div>
            {% elif prices and not clientView and totalPrice %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total gold price-label col-3 text-center'>
                            {% if totalPrice.hidden != '0.00' %}
                                {{ __('order.total_hidden') }}: <span class="pdf-val">{{ totalPrice.hidden }}&#8364; netto</span>
                            {% else %}
                                Według cennika
                            {% endif %}
                        </span>
                    </div>
                </div>
            {% elif prices and clientView and totalPrice and totalPrice.subLocked and totalPrice.subLocked != 0 %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total gold price-label col-3 text-center'>
                            {{ __('order.total_hidden') }}: <span class="pdf-val">{{ totalPrice.subLocked }}&#8364; netto</span>
                        </span>
                    </div>
                </div>
            {% endif %}
            {# Ta sama zasada co w order.njk — bez dublowania kwoty z podsumowania. #}
{% if showClientDiscount and totalPrice and totalPrice.afterClientDiscount and totalPrice.afterClientDiscount != totalPrice.subLocked %}
                <div id='total-container' style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label print-discount-price col-3 text-center'>
                            {{ __('form.value_after_discount_label') }}: <span class="pdf-val">{{ totalPrice.afterClientDiscount }}&#8364;</span>
                        </span>
                    </div>
                </div>
            {% endif %}
            {% if not prices and discountInfo and discountInfo.type != 'none' %}
                <div style='padding-right: 10%;'>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label col-3 text-center' style="background: rgba(235,232,75,0.8); color: #333; font-weight: bold;">
                            {{ __('order.discount') }}: <span class="pdf-val">{{ discountInfo.discountValue }}{% if discountInfo.type == 'percentage' %}%{% else %} €{% endif %}</span>
                        </span>
                    </div>
                    <div class="total-price d-flex justify-content-end align-items-center col-12">
                        <span class='total price-label col-3 text-center' style="background: rgba(235,232,75,0.8); color: #333; font-weight: bold;">
                            {{ __('order.total_after_discount') }}: <span class="pdf-val">{{ discountInfo.result }} €</span>
                        </span>
                    </div>
                </div>
            {% endif %}
    <div class='client-details'>
        <div class="order-details">
            <h3 class='header-3'>{{ __('order.client_data') }}</h3>
            <div class="order-details-line">{{ __('new-order.client_name') }}: <span class="pdf-val">{{ sendData.client }}</span></div>
            <div class="order-details-line">{{ __('base.nip') }}: <span class="pdf-val">{{ sendData.tax }}</span></div>
            <div class="order-details-line">{{ __('orders.created_date') }}: <span class="pdf-val">{{ sendData.created_date }}</span></div>
        </div>
        <div class="order-details">
            <h3 class='header-3'>{{ __('order.send_data') }}</h3>
            {% if sendData.name %}
                <div class="order-details-line">{{ __('order.address_name') }}: <span class="pdf-val">{{ sendData.name }}</span></div>
            {% endif %}
            <div class="order-details-line">{{ __('new-order.street') }}: <span class="pdf-val">{{ sendData.address }}</span></div>
            <div class="order-details-line">{{ __('new-order.city') }}: <span class="pdf-val">{{ sendData.zip }}
                {{ sendData.city }}</span></div>
            <div class="order-details-line">{{ __('new-order.country') }}: <span class="pdf-val">{{ sendData.country }}</span></div>
            <div class="order-details-line">{{ __('new-order.email_placeholder') }}:
            <span class="pdf-val">{{ sendData.email }}</span></div>
            <div class="order-details-line">{{ __('new-order.phone') }}: <span class="pdf-val">{{ sendData.phone }}</span></div>
        </div>
    </div>
</div></div>{% block scripts %}
<script type='module' src='/scripts/base.js'></script>{% endblock %}