{% extends "base.njk" %}
{% block title %}
    {{ __('Pozycja') }}
{% endblock title %}
{% block head %}
    <link rel="stylesheet" href="/styles/order_details.css">
        <link rel="stylesheet" href="/styles/mobile/order_details.css">
            <link rel="stylesheet" href="/styles/dialog.css">
                <link rel="stylesheet" href="/styles/mobile/dialog.css">
                    <link rel="stylesheet" href="/styles/position_sent.css">
                        <link rel="stylesheet" href="/styles/mobile/position_sent.css">
                        {% endblock head %}
                        {% block key_nav %}
                            window.history.back()
                        {% endblock %}
                        {% block back_link %}
                            <button class="modern-back-btn" onclick="window.history.back()">
                            {% endblock %}
                            {% block content %}
                                <div class="content center-content col-10">
                                    <div class="container my-5">
                                        <div class="order-header">
                                            {{ __('position.position_label') }}: {{ position.name }}
                                            <span class="text-muted">#{{ position.id }}</span>
                                        </div>
                                        <div class="order-params-grid">
                                            {% for param in parameters %}
                                                {% set value = param[1].option_value %}
                                                {% set description = param[1].option_description or '' %}
                                                {% set param_desc = param[1].param_description or '' %}
                                                {# Zabezpieczenie przed null/undefined #}
                                                {% set value_str = (value or '') | string %}
                                                {% if (value_str and description) 
                            or(value_str and value_str.indexOf('|') > -1) %}
                                                    {% if value_str and value_str.indexOf('|') > -1 %}
                                                        {% set param_values = value_str.split('|') %}
                                                        {% for single_value in param_values %}
                                                            <div class="param-card-with-image">
                                                                <div class="param-img-container">
                                                                    <img src="/img/placeholder.png" alt="{{ param_desc }}" class="param-img" loading="lazy" data-photo-name="{{ single_value }}" data-group-number="{{ position.asortment_group_number }}" data-folder-name="{{ param[0] }}"></div>
                                                                    <div class="param-content">
                                                                        <div class="param-title">{{ param_desc }}</div>
                                                                        <div class="param-value">
                                                                            {{ single_value }}
                                                                            <span class="param-unit">{{ description }}</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            {% endfor %}
                                                        {% else %}
                                                            <div class="param-card-with-image">
                                                                <div class="param-img-container">
                                                                    {% set photo_name = value_str %}
                                                                    {% for key, val in values %}
                                                                        {% if param[0] ~ "_ALIAS" == key and val %}
                                                                            {% set photo_name = values[param[0]] or '' %}
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                    <img src="/img/placeholder.png" alt="{{ param_desc }}" class="param-img" loading="lazy" data-photo-name="{{ photo_name }}" data-group-number="{{ position.asortment_group_number }}" data-folder-name="{{ param[0] }}"></div>
                                                                    <div class="param-content">
                                                                        <div class="param-title">{{ param_desc }}</div>
                                                                        <div class="param-value">
                                                                            {{ value_str }}
                                                                            <span class="param-unit">{{ description }}</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            {% endif %}
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                                {% block table %}
                                                    <div class="d-flex gap-3 mt-4">
                                                        <div class="flex-fill">
                                                            <table class="params-table w-50">
                                                                <tbody>
                                                                    {% for param in parameters %}
                                                                        {% if param[1]
                                        .option_value and not param[1]
                                        .option_description and (not param[1]
                                        .locked or showUnlockedPrices) and param[1].row != '0' %}
                                                                            {% set isSub = param[1].sub or (param[0] | string).startsWith('SUB___') %}
                                                                            {% set isListsum = param[1].listsum or param[1].row == '2' %}
                                                                            {% set showRow = true %}
                                                                            {% set showSubPrices = isGroupShop or isClient %}
                                                                            {% if showSubPrices and isListsum and not isSub %}
                                                                                {% set showRow = false %}
                                                                            {% endif %}
                                                                            {% if not showSubPrices and isSub %}
                                                                                {% set showRow = false %}
                                                                            {% endif %}
                                                                            {% if showRow %}
                                                                            {# Klasy tylko dla wariantu wyglądu B (theme-efor-v2.css): tabela dzieli się
                                                                               tam na „Wymiary i ilość” oraz „Szczegóły ceny”. W wariancie A bez skutku. #}
                                                                            <tr class="{% if isListsum %}efor-price-tr{% endif %}{% if param[1].listsum %} efor-total-tr{% endif %}">
                                                                                <th>{{ param[1].param_description }}</th>
                                                                                <td>
                                                                                    {{ param[1].option_value }}
                                                                                    {% if 'WYSOKOSC' in param[0] or 'SZEROKOSC' in param[0] %}
                                                                                        <span class="param-unit">mm</span>
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                        {% if isAdmin == true %}
                                                            <div class="flex-fill d-none" id="json-data">
                                                                <table class="params-table w-75 me-3 ms-5 ">
                                                                    <tbody>
                                                                        {% for key in parameters_short.order %}
                                                                            <tr>
                                                                                <th>{{ key }}</th>
                                                                                <td>
                                                                                    {{ parameters_short.data[key] }}
                                                                                </td>
                                                                            </tr>
                                                                        {% endfor %}
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    {% if isAdmin == true %}
                                                        <button id='show-json' class='btn btn-secondary me-5 justify-content-center'>
                                                            Pokaż  Dane JSON</button>
                                                    {% endif %}
                                                {% endblock %}
                                                {% if position.comment %}
                                                    <div class="comment-section mt-4 p-3">
                                                        <small class="comment-label">{{ __('order.comment') }}:</small>
                                                        <div class="comment-text">{{ position.comment }}</div>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <script type='module' src='/scripts/position.js'></script>
                                    {% endblock %}