{
	"name": "eform",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"start": "node --openssl-legacy-provider server.js",
		"dev": "node --watch server.js",
		"test": "ROOT_DIR=/tmp/eform-test NODE_ENV=test node --test --test-force-exit \"services/**/__tests__/*.test.js\" \"middleware/**/__tests__/*.test.js\" \"utils/**/__tests__/*.test.js\"",
		"import:orders": "node scripts/runOrderImport.js",
		"import:preflight": "node scripts/orderImportPreflight.js",
		"import:repair-prices": "node scripts/repairOrderPrices.js",
		"import:daemon": "node scripts/orderImportDaemon.js",
		"import:restart": "sudo systemctl restart eform-import.service",
		"import:status": "systemctl status eform-import.service --no-pager",
		"import:logs": "journalctl -u eform-import.service -n 50 --no-pager -f",
		"prodstatus:run": "node scripts/prodStatusSync.js",
		"prodstatus:dry": "node scripts/prodStatusSync.js --dry-run",
		"prodstatus:full": "node scripts/prodStatusSync.js --full --no-invoices",
		"configtest:run": "node --max-old-space-size=2048 scripts/runConfiguratorTest.js",
		"configtest:daemon": "node --max-old-space-size=2048 scripts/configuratorTesterDaemon.js",
		"configtest:stop": "test -f configtest/configtest.pid && kill -TERM $(cat configtest/configtest.pid) && echo zatrzymany || echo 'demon nie chodzi'",
		"configtest:status": "test -f configtest/configtest.pid && ps -p $(cat configtest/configtest.pid) -o pid,etime,rss,cmd --no-headers || echo 'demon nie chodzi'",
		"configtest:logs": "tail -n 50 -f configtest/configtest.log",
		"configtest:install": "sudo cp deploy/eform-configtest.service deploy/eform-configtest-watchdog.service deploy/eform-configtest-watchdog.timer /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now eform-configtest && sudo systemctl enable --now eform-configtest-watchdog.timer && systemctl status eform-configtest --no-pager && systemctl list-timers eform-configtest-watchdog.timer --no-pager",
		"configtest:restart": "sudo systemctl restart eform-configtest.service",
		"configtest:service": "systemctl status eform-configtest.service --no-pager",
		"configtest:watchdog-status": "systemctl list-timers eform-configtest-watchdog.timer --no-pager",
		"configtest:enable": "rm -f configtest/DISABLED && echo 'odblokowany'"
	},
	"keywords": [],
	"author": "Pawel Woroniecki",
	"license": "ISC",
	"description": "Serwis do zarządzania zleceniami od klientów",
	"dependencies": {
		"@marsaud/smb2": "^0.18.0",
		"@vitalets/google-translate-api": "^9.2.1",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.2",
		"canvas": "^3.2.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"country-select-js": "^2.1.0",
		"csvtojson": "^2.0.10",
		"dayjs": "^1.11.18",
		"dotenv": "^16.4.7",
		"esbuild": "^0.28.0",
		"exceljs": "^4.4.0",
		"express": "^4.21.2",
		"express-session": "^1.18.1",
		"franc-min": "^6.2.0",
		"fs": "^0.0.1-security",
		"hot-formula-parser": "^4.0.0",
		"i18n": "^0.15.1",
		"i18next": "^25.1.2",
		"i18next-fs-backend": "^2.6.0",
		"i18next-http-middleware": "^3.7.4",
		"intro.js": "^8.3.2",
		"jsdom": "^27.0.1",
		"lodash": "^4.17.21",
		"mammoth": "^1.10.0",
		"md5": "^2.3.0",
		"multer": "^2.0.2",
		"mysql": "^2.18.1",
		"mysql2": "^3.13.0",
		"n_": "^4.0.1",
		"nodemailer": "^7.0.3",
		"normall": "^0.2.2",
		"nunjucks": "^3.2.4",
		"path": "^0.12.7",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.17.1",
		"playwright": "^1.54.2",
		"puppeteer": "^24.10.2",
		"sharp": "^0.34.5",
		"shepherd.js": "^14.5.1",
		"smb-enumerate-files": "^1.0.4",
		"smb2": "^0.2.11",
		"util": "^0.12.5"
	},
	"devDependencies": {
		"prettier": "^3.8.1"
	}
}
