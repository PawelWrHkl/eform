{# Stopka AB (POP-19) — baner targowy, wspólny dla maila (mailTemplate.njk) i PDF/HTML (order-pdf.njk).
   Tabele i style inline, bo klienci poczty gubią <style>. Dane: `abFooter` z services/mailBot/abFooter.js;
   `abFooter.compact` (PDF/HTML) = niższy baner, żeby AB z jednej strony nie dostał drugiej. #}
{% set c = abFooter.compact %}{% set imgW = 140 if c else 200 %}{% set imgH = 91 if c else 130 %}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;background-color:#231f20;font-family:Arial,Helvetica,sans-serif;">
  <tr>
    {% if abFooter.img %}
    <td width="{{ imgW }}" style="width:{{ imgW }}px;padding:0;vertical-align:middle;line-height:0;">
      <img src="{{ abFooter.img }}" width="{{ imgW }}" height="{{ imgH }}" alt="HKL" style="display:block;width:{{ imgW }}px;height:{{ imgH }}px;border:0;">
    </td>
    {% endif %}
    <td style="padding:{{ '8px 16px' if c else '16px 20px' }};vertical-align:middle;text-align:left;">
      <div style="color:#e5a82c;font-size:11px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;line-height:1.3;">{{ abFooter.label }}</div>
      <div style="color:#ffffff;font-size:{{ 16 if c else 20 }}px;font-weight:bold;line-height:1.25;margin:{{ 3 if c else 6 }}px 0;">{{ abFooter.title }}</div>
      <div style="color:#cfcbcb;font-size:{{ 12 if c else 13 }}px;line-height:1.4;">{{ abFooter.subtitle }}</div>
    </td>
    <td width="96" style="width:96px;padding:{{ '8px 14px 8px 0' if c else '16px 18px 16px 0' }};vertical-align:middle;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;background-color:#e5a82c;">
        <tr>
          <td style="padding:{{ '6px' if c else '10px 6px' }};text-align:center;color:#231f20;">
            <div style="font-size:10px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;line-height:1.2;">{{ abFooter.boothLabel }}</div>
            <div style="font-size:{{ 24 if c else 30 }}px;font-weight:bold;line-height:1.1;">{{ abFooter.booth }}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td colspan="{{ 3 if abFooter.img else 2 }}" style="padding:{{ '5px 16px' if c else '9px 20px' }};border-top:1px solid #3d3839;color:#a3a0a0;font-size:11px;font-weight:bold;letter-spacing:1px;text-align:center;">{{ abFooter.company }}</td>
  </tr>
</table>
