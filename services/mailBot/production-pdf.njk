{% from "_pdf_cell.njk" import pdfCell %}
<div class="page-wrap">

  <div class="doc-header">
    <img src="{{ logoPath }}" alt="logo" class="logo logo-{{ logoName }}">
    <div class="doc-title">
      <div class="doc-order-nr">Zamówienie nr <span class="pdf-val">{{ orderNr }}</span></div>
      {% if orderDetails.commision %}
        <div class="doc-commission">"<span class="pdf-val">{{ orderDetails.commision }}</span>"</div>
      {% endif %}
      {% if clientName %}
        <div class="doc-client">Klient: <span class="pdf-val">{{ clientName }}</span></div>
      {% endif %}
    </div>
  </div>

  {% if orderDetails.comment %}
    <div class="global-comment">
      <span class="comment-label">Uwaga ogólna:</span> <span class="pdf-val">{{ orderDetails.comment }}</span>
    </div>
  {% endif %}

  {% set globalIndex = 1 %}
  {% for table in cleanOrderItems %}
    {% for rowObj in table.rows %}

      <div class="position-card">

        <div class="pos-header">
          <span class="pos-number">#{{ globalIndex }}</span>
          <span class="pos-meta">
            {% if rowObj.item.commision %}<span class="meta-chip highlight">Zlecenie: <span class="pdf-val">{{ rowObj.item.commision }}</span></span>{% endif %}
          </span>
        </div>

        <div class="params-grid">
          {% for header in table.headers1 %}
            {% if not(header in rowObj.item.lockedParams) %}
              <div class="param-row">
                <div class="param-label">{{ header }}</div>
                <div class="param-value">{{ pdfCell(rowObj.row.row1[header]) }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if rowObj.item.comment %}
        <div class="pos-comment">
          <span class="comment-label">Uwaga:</span> <span class="pdf-val">{{ rowObj.item.comment }}</span>
        </div>
        {% endif %}

      </div>

      {% set globalIndex = globalIndex + 1 %}
    {% endfor %}
  {% endfor %}

  <div class="doc-footer">
    Liczba pozycji: <strong class="pdf-val">{{ totalQuantity if totalQuantity is defined else (globalIndex - 1) }}</strong>
  </div>

</div>
