{% from "_pdf_cell.njk" import pdfCell, pdfCellBold %}
{% block title %}{% endblock title %}
{% block head %}
  <link rel="stylesheet" href="styles/order-pdf.css">
  {% endblock head %}
  <div class="position-relative">
    <img src="{{ logoPath }}" alt="logo" class="logo">
      <div id='header-space'>
        <h2 class="header">{{ __('history_order.title') }}<span class="pdf-val">{{ orderNr }}</span>
          {% if orderDetails.commision %}
            "<span class="pdf-val">{{ orderDetails.commision }}</span>"{% endif %}
        </h2>
        {% if orderDetails.comment %}
          <div class='header-comment'>
            <strong>{{ __('order.comment') }}:</strong>
            <span class="pdf-val">{{ orderDetails.comment }}</span>
          </div>
        {% endif %}
      </div>
      {% set globalIndex = 1 %}
      {% for table in cleanOrderItems %}
        <table id='table'>
          <thead>
            <tr>
              <th>#</th>
              <th>{{ __('order.department') }}</th>
              <th>{{ __('order.group_name') }}</th>
              <th>{{ __('order.name') }}</th>
              {% for header in table.headers1 %}
                {% if not(header in table.locked) %}
                  <th>{{ header }}</th>
                {% endif %}
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for rowObj in table.rows %}
              <tr>
                <td><span class="pdf-val">{{ globalIndex }}</span></td>
                <td>{{ pdfCell(rowObj.item.department) }}</td>
                <td>{{ pdfCell(rowObj.item.group_name) }}</td>
                <td>{{ pdfCell(rowObj.item.commision) }}</td>
                {% for header in table.headers1 %}
                  {% if (not(header in rowObj.item.lockedParams)) %}
                    <td>{{ pdfCell(rowObj.row.row1[header]) }}</td>
                  {% endif %}
                {% endfor %}
              </tr>
              {# ⚠️ `withoutPrices` (klient z `ab_type = without_price`) wyłącza WSZYSTKIE
                 kwoty: ceny katalogowe, SUB, wartości zablokowane, sumy i rabat.
                 Musi być tutaj, bo ten wiersz nie zależy od flagi `prices`. #}
              {% if not clientView and not withoutPrices %}
              <tr>
                {% for header in table.headers2 %}
                  {% if (not(header in rowObj.item.lockedParams)) %}
                    <td class="price" colspan="2">
                      <span class="price-label">{{ header }}:</span>
                      <b>{{ pdfCellBold(rowObj.row.row2[header]) }}</b>
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
              {% endif %}
              {% if (clientView or showBoth) and not withoutPrices %}
              <tr>
                {% for entry in rowObj.item.subParamValues %}
                  {% if entry.value and entry.value != '-' and entry.value != '' and not entry.locked %}
                    <td class="price" colspan="2">
                      <span class="price-label">{{ entry.display }}:</span>
                      <b>{{ pdfCellBold(entry.value) }}</b>
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
              {% endif %}
              {% if prices and showGoldPrices and not clientView %}
              <tr>
                {% for header in table.headers1 %}
                  {% if (header in rowObj.item.lockedParams) %}
                    <td class="price" colspan="2">
                      <span class="price-label gold">{{ header }}:</span>
                      <b>{{ pdfCellBold(rowObj.row.row1[header] or rowObj.row.row2[header]) }}</b>
                    </td>
                  {% endif %}
                {% endfor %}
                {% for header in table.headers2 %}
                  {% if (header in rowObj.item.lockedParams) %}
                    <td class="price" colspan="2">
                      <span class="price-label gold">{{ header }}:</span>
                      <b>{{ pdfCellBold(rowObj.row.row1[header] or rowObj.row.row2[header]) }}</b>
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
              {% endif %}
              {% if prices and (clientView or showBoth) %}
              <tr>
                {% for entry in rowObj.item.subParamValues %}
                  {% if entry.value and entry.value != '-' and entry.value != '' and entry.locked %}
                    <td class="price" colspan="2">
                      <span class="price-label gold">{{ entry.display }}:</span>
                      <b>{{ pdfCellBold(entry.value) }}</b>
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
              {% endif %}
              {% if rowObj.item.comment %}
              <tr>
                <td class="row-comment" colspan="999"><span class="price-label">{{ __('order.comment') }}:</span> <span class="pdf-val">{{ rowObj.item.comment }}</span></td>
              </tr>
              {% endif %}
              {% set globalIndex = globalIndex + 1 %}
            {% endfor %}
          </tbody>
        </table>
      {% endfor %}
      {% if maxProdDays %}
        <div class="print-total-items">
          {{ __('order.production_time_label') }} <span class="pdf-val">{{ maxProdDays }}</span> {{ __('termin.days') }}
        </div>
      {% endif %}
      <div class="print-total-items">
        {{ __('order.total_items') }}: <span class="pdf-val">{{ totalQuantity if totalQuantity is defined else (globalIndex - 1) }}</span>
      </div>
      {% if sendData.total %}
        <div id='total-container'>
          <div class="total-price">
            {{ __('order.total') }}: <span class="pdf-val">{{ sendData.total | replace(__('order.total') + ': ', '') }}</span>
          </div>
        </div>
      {% endif %}
      {% if sendData.total_hidden %}
        <div id='total-container'>
          <div class="total-price">
            {{ __('order.total_hidden') }}: <span class="pdf-val">{{ sendData.total_hidden | replace(__('order.total_hidden') + ': ', '') }}</span>
          </div>
        </div>
      {% endif %}
      {% if not prices and discountInfo and discountInfo.type != 'none' %}
        <div class="print-total-items">
          <span style="background: rgba(235, 232, 75, 0.8); color: #333; padding: 1px 6px;">{{ __('order.discount') }}: <span class="pdf-val">{{ discountInfo.discountValue }}{% if discountInfo.type == 'percentage' %}%{% else %} €{% endif %}</span></span>
        </div>
        <div class="print-total-items">
          <span style="background: rgba(235, 232, 75, 0.8); color: #333; padding: 1px 6px;">{{ __('order.total_after_discount') }}: <span class="pdf-val">{{ discountInfo.result }} €</span></span>
        </div>
      {% endif %}
    </div>
    <div class='client-details'>
      <div class="order-details">
        <h2 class='header-3'>{{ __('order.client_data') }}</h2>
        <div class="order-details-line">{{ __('new-order.client_name') }}: {{ sendData.client }}</div>
        <div class="order-details-line">{{ __('base.nip') }}: {{ sendData.tax }}</div>
        {% if sendData.userStreet or sendData.userCity or sendData.userZip %}
          <div class="order-details-line">{{ __('new-order.street') }}: {{ sendData.userStreet or '-' }}</div>
          <div class="order-details-line">{{ __('new-order.city') }}: {{ sendData.userZip }} {{ sendData.userCity }}</div>
          {% if sendData.userCountry %}
            <div class="order-details-line">{{ __('new-order.country') }}: {{ sendData.userCountry }}</div>
          {% endif %}
          {% if sendData.userPhone %}
            <div class="order-details-line">{{ __('new-order.phone') }}: {{ sendData.userPhone }}</div>
          {% endif %}
        {% endif %}
        <div class="order-details-line">{{ __('orders.created_date') }}: {{ sendData.created_date }}</div>
        <div class="order-details-line">{{ __('orders.sent_date') }}: {{ sendData.sentDate }}</div>
      </div>
      <div class="order-details">
        <h2 class='header-3'>{{ __('order.send_data') }}</h2>
        {% if sendData.name %}
          <div class="order-details-line">{{ __('order.address_name') }}: {{ sendData.name }}</div>
        {% endif %}
        <div class="order-details-line">{{ __('new-order.street') }}: {{ sendData.address }}</div>
        <div class="order-details-line">{{ __('new-order.city') }}: {{ sendData.zip }} {{ sendData.city }}</div>
        <div class="order-details-line">{{ __('new-order.country') }}: {{ sendData.country }}</div>
        <div class="order-details-line">{{ __('new-order.email_placeholder') }}: {{ sendData.email }}</div>
        <div class="order-details-line">{{ __('new-order.phone') }}: {{ sendData.phone }}</div>
      </div>
    </div>
  </div>
  {% block scripts %}
    <script type='module' src='/scripts/base.js'></script>
  {% endblock %}