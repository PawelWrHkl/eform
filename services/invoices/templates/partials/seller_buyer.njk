{#
  Strony transakcji. Dane są zdenormalizowaną KOPIĄ z chwili wystawienia
  (patrz `db/schema.sql`) — szablon nigdy nie dociąga bieżących danych klienta.
#}
{% macro party(title, p) %}
  <section class="party">
    <h2 class="party__title">{{ title }}</h2>
    <div class="party__name">{{ p.name }}</div>
    {% if p.street %}<div class="party__line">{{ p.street }}</div>{% endif %}
    {% if p.zip or p.city %}<div class="party__line">{{ p.zip }} {{ p.city }}</div>{% endif %}
    {% if p.country %}<div class="party__line">{{ p.country }}</div>{% endif %}
    {% if p.vatEuId %}
      <div class="party__line"><span class="label">{{ t('party.vat_eu_id') }}:</span> {{ p.vatEuId }}</div>
    {% elif p.taxId %}
      <div class="party__line"><span class="label">{{ t('party.tax_id') }}:</span> {{ p.taxId }}</div>
    {% endif %}
    {% if p.email %}<div class="party__line">{{ p.email }}</div>{% endif %}
    {% if p.phone %}<div class="party__line">{{ p.phone }}</div>{% endif %}
  </section>
{% endmacro %}

<div class="parties">
  {{ party(t('party.seller'), invoice.seller) }}
  {{ party(t('party.buyer'), invoice.buyer) }}
</div>
