{#
  Tabela pozycji.

  ⚠️ Kolumna „ilość" pokazuje `meta.displayQuantity` (sztuki), a wartość netto pochodzi
  z wyceny silnika formularzy — patrz `core/orderMapper.js`.

  Cena – ilość – wartość (uwaga KK 2026-11-07, też wymóg art. 106e ust. 1 pkt 9 VAT):
  cena jednostkowa netto = wartość pozycji / ilość, zaokrąglona do grosza. Przy
  nierównym dzieleniu iloczyn może się różnić o grosz od wartości — wiąże wartość.

  Klient organizacji z rabatem (ceny SUB___, np. klient Luxanu albo Cozy): cena
  jednostkowa przed rabatem, rabat, cena jednostkowa po rabacie i wartość netto.
  Decyzja właściciela 2026-10-22, ceny jednostkowe od 2026-11-07. Dane w `meta`
  pozycji (`core/orderMapper.js`), przełącznik — `discounts`
  (`render/renderer.js:summarizeItemDiscounts`).
#}
{% set withDiscount = discounts and discounts.show %}
{# Liczba kolumn — opis pozycji idzie wierszem pod nią, na całą szerokość (od kolumny nazwy) #}
{% set columns = 13 if withDiscount else 11 %}
<table class="items{{ ' items--discount' if withDiscount else '' }}">
  <thead>
    <tr>
      <th class="col-nr">{{ t('items.position') }}</th>
      <th class="col-name">{{ t('items.name') }}</th>
      {# Wymóg specyfikacji: pozycja faktury MUSI wskazywać numer oryginalnego
         zamówienia i wymiary — przy częściowym fakturowaniu to jedyny sposób,
         żeby powiązać partię z konkretną pozycją zamówienia. #}
      <th class="col-order">{{ t('items.order_ref') }}</th>
      <th class="col-dim">{{ t('items.dimensions') }}</th>
      <th class="col-qty">{{ t('items.quantity') }}</th>
      <th class="col-unit">{{ t('items.unit') }}</th>
      {% if withDiscount %}
        <th class="col-before">{{ t('items.price_before_discount') }}</th>
        <th class="col-disc">{{ t('items.discount') }}</th>
        <th class="col-price">{{ t('items.price_after_discount') }}</th>
      {% else %}
        <th class="col-price">{{ t('items.unit_price_net') }}</th>
      {% endif %}
      <th class="col-net">{{ t('items.net_amount') }}</th>
      <th class="col-rate">{{ t('items.tax_rate') }}</th>
      <th class="col-tax">{{ t('items.tax_amount') }}</th>
      <th class="col-gross">{{ t('items.gross_amount') }}</th>
    </tr>
  </thead>
  {# Każda pozycja we własnym <tbody>: wiersz z kwotami + wiersz opisu, nierozdzielne między stronami #}
    {% for item in invoice.items %}
      {% set qty = item.meta.displayQuantity if item.meta.displayQuantity else item.quantity %}
      {% set unitNet = (item.netAmount / qty) | round if qty > 0 else item.netAmount %}
    <tbody class="items__item">
      <tr>
        <td class="col-nr">{{ item.position }}</td>
        <td class="col-name">
          <span class="items__name">{{ item.name }}</span>
        </td>
        <td class="col-order">
          {{ item.orderNumber if item.orderNumber else (invoice.orderRef if invoice.orderRef else '—') }}
        </td>
        <td class="col-dim">
          {%- if item.meta.widthMm and item.meta.heightMm -%}
            {{ item.meta.widthMm }}×{{ item.meta.heightMm }} mm
          {%- elif item.meta.widthMm -%}
            {{ item.meta.widthMm }} mm
          {%- else -%}—{%- endif -%}
        </td>
        <td class="col-qty">
          {{ (item.meta.displayQuantity if item.meta.displayQuantity else item.quantity) | qty }}
          {# Partia z częściowego fakturowania: „2 / 3" czyni jawnym, że to część zamówienia #}
          {% if item.meta.orderedQuantity and item.meta.invoicedQuantity %}
            <span class="items__batch">/ {{ item.meta.orderedQuantity | qty }}</span>
          {% endif %}
        </td>
        <td class="col-unit">{{ item.unit | unitLabel }}</td>
        {% if withDiscount %}
          {% if item.meta.discountPercent > 0 and item.meta.priceBeforeDiscountMinor > 0 %}
            <td class="col-before">{{ ((item.meta.priceBeforeDiscountMinor / qty) | round if qty > 0 else item.meta.priceBeforeDiscountMinor) | money }}</td>
            <td class="col-disc">
              {{- item.meta.discountPercent | rate -}}
              {# Różne rabaty składników ceny (np. Cozy: cena 60%, dopłaty 35%) — `orderMapper.discountTermsOf` #}
              {%- if item.meta.discountTerms and item.meta.discountTerms.length -%}
                <span class="items__terms">
                  {%- for term in item.meta.discountTerms -%}
                    <span class="items__term">{{ t('items.discount_on_' + term.part) }} {{ term.percent | rate }}</span>
                  {%- endfor -%}
                </span>
              {%- endif -%}
            </td>
          {% else %}
            <td class="col-before">{{ unitNet | money }}</td>
            <td class="col-disc">—</td>
          {% endif %}
        {% endif %}
        <td class="col-price">{{ unitNet | money }}</td>
        <td class="col-net">{{ item.netAmount | money }}</td>
        <td class="col-rate">{{ item.taxRate | rate }}</td>
        <td class="col-tax">{{ item.taxAmount | money }}</td>
        <td class="col-gross">{{ item.grossAmount | money }}</td>
      </tr>
      {# Krótka specyfikacja (produkt, model, dodatki) na całą szerokość — w wąskiej kolumnie
         nazwy zawijała się na kilkanaście linii (2026-11-07) #}
      {% if item.description %}
        <tr class="items__desc-row">
          <td></td>
          <td colspan="{{ columns - 1 }}"><span class="items__desc">{{ item.description }}</span></td>
        </tr>
      {% endif %}
    </tbody>
    {% endfor %}
  <tfoot>
    <tr>
      <td colspan="6" class="items__total-label">{{ t('vat.total') }}</td>
      {# Pod cenami jednostkowymi bez sumy — suma cen jednostkowych nic nie znaczy #}
      {% if withDiscount %}
        <td></td>
        <td></td>
      {% endif %}
      <td></td>
      <td class="col-net">{{ invoice.totalNet | money }}</td>
      <td></td>
      <td class="col-tax">{{ invoice.totalTax | money }}</td>
      <td class="col-gross">{{ invoice.totalGross | money }}</td>
    </tr>
  </tfoot>
</table>
