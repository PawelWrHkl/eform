{# Nagłówek: logo, typ i numer dokumentu, daty, referencje (zamówienie/korekta). #}
<header class="doc-header">
  {# ⚠️ JEDEN wiersz: tytuł z numerem po lewej, daty po prawej (uwaga KK
     2026-10-26: góra faktury zajmowała 1/3 strony). Nazwy sprzedawcy tu nie
     ma — jest na papierze firmowym i w bloku „Sprzedawca" tuż pod spodem.
     Tytuł i numer nigdy się nie rozdzielają („Faktura VAT 2026/00001"). #}
  <div class="doc-header__row">
    <div class="doc-header__brand">
      {% if logoDataUri %}
        <img class="doc-header__logo" src="{{ logoDataUri }}" alt="">
      {% endif %}
      <div class="doc-header__titlebar">
        <h1 class="doc-header__title">{{ t('doc.' ~ invoice.documentType) }}</h1>
        {# Szkic nie ma jeszcze numeru — numer nadajemy przy wystawieniu #}
        <span class="doc-header__number">{{ invoice.number if invoice.number else '—' }}</span>
      </div>
    </div>

    <div class="doc-header__meta">

    {# Daty jako zawijany pasek, nie tabela jeden-pod-drugim: w układzie
       poziomym wysokość jest zasobem deficytowym, a nagłówek był jej
       największym pojedynczym konsumentem. #}
    <div class="doc-header__dates">
      <div class="doc-date">
        <span class="doc-date__label">{{ t('header.issue_date') }}</span>
        <strong class="doc-date__value">{{ invoice.issueDate | date }}</strong>
      </div>
      <div class="doc-date">
        <span class="doc-date__label">{{ t('header.sale_date') }}</span>
        <strong class="doc-date__value">{{ invoice.saleDate | date }}</strong>
      </div>
      <div class="doc-date">
        <span class="doc-date__label">{{ t('header.due_date') }}</span>
        <strong class="doc-date__value">{{ invoice.dueDate | date }}</strong>
      </div>
      {% if invoice.orderId %}
        <div class="doc-date">
          <span class="doc-date__label">{{ t('header.order_ref') }}</span>
          <strong class="doc-date__value">{{ invoice.orderRef if invoice.orderRef else invoice.orderId }}</strong>
        </div>
      {% endif %}
      {% if invoice.orderName %}
        <div class="doc-date doc-date--wide">
          <span class="doc-date__label">{{ t('header.order_name') }}</span>
          <strong class="doc-date__value">{{ invoice.orderName }}</strong>
        </div>
      {% endif %}
      {% if invoice.correctedInvoiceNumber %}
        <div class="doc-date">
          <span class="doc-date__label">{{ t('header.corrected_ref') }}</span>
          <strong class="doc-date__value">{{ invoice.correctedInvoiceNumber }}</strong>
        </div>
      {% endif %}
      </div>
    </div>
  </div>
</header>

{% if invoice.documentType == DocumentType.CORRECTION and invoice.correctionReason %}
  <div class="doc-correction-reason">
    <span class="label">{{ t('header.correction_reason') }}:</span>
    <span>{{ invoice.correctionReason }}</span>
  </div>
{% endif %}
