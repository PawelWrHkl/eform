{#
  Podsumowanie VAT — jeden wiersz na parę (stawka, kategoria).
  Kwoty pochodzą z `invoice.taxLines`, które zostały zapisane przy wystawieniu:
  VAT zaokrągla się per grupa stawek, więc suma z pozycji może różnić się o grosz.
#}
<section class="vat-summary">
  <h2 class="section-title">{{ t('vat.summary') }}</h2>

  <table class="vat-table">
    <thead>
      <tr>
        <th>{{ t('vat.rate') }}</th>
        {# Kategoria, nie tylko stawka: WDT 0% i eksport 0% to różne stany prawne #}
        <th>{{ t('vat.category') }}</th>
        <th>{{ t('vat.net') }}</th>
        <th>{{ t('vat.tax') }}</th>
        <th>{{ t('vat.gross') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for line in invoice.taxLines %}
        <tr>
          <td>{{ line.taxRate | rate }}</td>
          <td class="vat-table__category">{{ t('taxcat.' ~ line.taxCategory) }}</td>
          <td>{{ line.netAmount | money }}</td>
          <td>{{ line.taxAmount | money }}</td>
          <td>{{ line.grossAmount | money }}</td>
        </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td>{{ t('vat.total') }}</td>
        <td></td>
        <td>{{ invoice.totalNet | money }}</td>
        <td>{{ invoice.totalTax | money }}</td>
        <td>{{ invoice.totalGross | money }}</td>
      </tr>
    </tfoot>
  </table>

  {# Faktura w walucie obcej: kwota podatku musi być podana także w walucie krajowej sprzedawcy #}
  {% if invoice.currency != invoice.localCurrency %}
    <div class="vat-local">
      {% if invoice.totalTaxLocal is not none %}
        <div>
          <span class="label">{{ t('vat.local_note') }}:</span>
          <strong>{{ invoice.totalTaxLocal | moneyLocal }} {{ invoice.localCurrency }}</strong>
        </div>
        {% if invoice.exchangeRate %}
          <div class="vat-local__rate">
            {{ t('vat.exchange_rate') }}: 1 {{ invoice.currency }} = {{ invoice.exchangeRate.rate }} {{ invoice.localCurrency }}
            ({{ invoice.exchangeRate.date | date }}{% if invoice.exchangeRate.source %}, {{ invoice.exchangeRate.source }}{% endif %})
          </div>
        {% endif %}
      {% else %}
        {# Brak kursu drukujemy jawnie — lepiej ostrzeżenie niż fałszywe 0,00 #}
        <div class="vat-local__warning">{{ t('vat.exchange_rate_missing') }}</div>
      {% endif %}
    </div>
  {% endif %}

  {# Adnotacje prawne: WDT / reverse charge / eksport — klucze z `taxLines` #}
  {% set notes = [] %}
  {% for line in invoice.taxLines %}
    {% if line.legalNoteKey and line.legalNoteKey not in notes %}
      {% set notes = (notes.push(line.legalNoteKey), notes) %}
    {% endif %}
  {% endfor %}
  {% if notes | length %}
    <ul class="legal-notes">
      {% for key in notes %}
        <li>{{ t(key) }}</li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

<section class="totals">
  <table class="totals-table">
    <tr>
      <th>{{ t('totals.total_net') }}</th>
      <td>{{ invoice.totalNet | money }} {{ invoice.currency }}</td>
    </tr>
    <tr>
      <th>{{ t('totals.total_tax') }}</th>
      <td>{{ invoice.totalTax | money }} {{ invoice.currency }}</td>
    </tr>
    <tr class="totals-table__gross">
      <th>{{ t('totals.total_gross') }}</th>
      <td>{{ invoice.totalGross | money }} {{ invoice.currency }}</td>
    </tr>
    {% if invoice.advanceSettled %}
      <tr>
        <th>{{ t('totals.advance_settled') }}</th>
        <td>− {{ invoice.advanceSettled | money }} {{ invoice.currency }}</td>
      </tr>
    {% endif %}
    <tr class="totals-table__due">
      <th>{{ t('totals.amount_due') }}</th>
      <td>{{ (invoice.amountDue if invoice.amountDue is not none else invoice.totalGross) | money }} {{ invoice.currency }}</td>
    </tr>
  </table>
</section>
