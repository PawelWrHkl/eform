{#
  Podsumowanie VAT — jeden wiersz na parę (stawka, kategoria).
  Kwoty pochodzą z `invoice.taxLines`, które zostały zapisane przy wystawieniu:
  VAT zaokrągla się per grupa stawek, więc suma z pozycji może różnić się o grosz.
#}
<section class="vat-summary">
  <h2 class="section-title">{{ t('vat.summary') }}</h2>

  <table class="vat-table">
    <thead>
      <tr>
        <th>{{ t('vat.rate') }}</th>
        {# Kategoria, nie tylko stawka: WDT 0% i eksport 0% to różne stany prawne #}
        <th>{{ t('vat.category') }}</th>
        <th>{{ t('vat.net') }}</th>
        <th>{{ t('vat.tax') }}</th>
        <th>{{ t('vat.gross') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for line in invoice.taxLines %}
        <tr>
          <td>{{ line.taxRate | rate }}</td>
          <td class="vat-table__category">{{ t('taxcat.' ~ line.taxCategory) }}</td>
          <td>{{ line.netAmount | money }}</td>
          <td>{{ line.taxAmount | money }}</td>
          <td>{{ line.grossAmount | money }}</td>
        </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td>{{ t('vat.total') }}</td>
        <td></td>
        <td>{{ invoice.totalNet | money }}</td>
        <td>{{ invoice.totalTax | money }}</td>
        <td>{{ invoice.totalGross | money }}</td>
      </tr>
    </tfoot>
  </table>

  {# ⚠️ USUNIĘTE NA ŻYCZENIE: przeliczenie kwoty VAT na walutę krajową
     sprzedawcy wraz z kursem NBP. Kwoty nadal są LICZONE i zapisywane
     (`invoice.total_tax_local`, `exchange_rate*` — patrz `core/calculator.js`),
     więc przywrócenie tego bloku to sama edycja szablonu.

     Uwaga na przyszłość: dla polskiego sprzedawcy wystawiającego fakturę w EUR
     z NIEZEROWĄ stawką krajową kwota podatku w PLN jest wymogiem ustawowym
     (art. 106e ust. 11 ustawy o VAT). Dziś taki przypadek tu nie występuje —
     sprzedaż zagraniczna idzie jako WDT/eksport ze stawką 0% — ale gdyby się
     pojawił, ten blok trzeba przywrócić. Flaga `compliance.requiresLocalVatAmount`
     nadal to wykrywa. #}

  {# Adnotacje prawne: WDT / reverse charge / eksport — klucze z `taxLines` #}
  {% set notes = [] %}
  {% for line in invoice.taxLines %}
    {% if line.legalNoteKey and line.legalNoteKey not in notes %}
      {% set notes = (notes.push(line.legalNoteKey), notes) %}
    {% endif %}
  {% endfor %}
  {% if notes | length %}
    <ul class="legal-notes">
      {% for key in notes %}
        <li>{{ t(key) }}</li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

<section class="totals">
  <table class="totals-table">
    {# Rabat odbiorcy: kwoty pozycji są już PO nim, więc pokazujemy wartość
       sprzed rabatu i samo obniżenie — inaczej klient nie zobaczyłby, że
       przyznany mu rabat faktycznie zadziałał. #}
    {% if invoice.clientDiscount and invoice.clientDiscount.amount %}
      <tr>
        <th>{{ t('totals.net_before_discount') }}</th>
        <td>{{ invoice.clientDiscount.baseNet | money }} {{ invoice.currency }}</td>
      </tr>
      <tr class="totals-table__discount">
        <th>
          {{ t('totals.client_discount') }}
          {%- if invoice.clientDiscount.type == 'percentage' %} ({{ invoice.clientDiscount.percent | rate }}){% endif -%}
        </th>
        <td>− {{ invoice.clientDiscount.amount | money }} {{ invoice.currency }}</td>
      </tr>
    {% endif %}
    <tr>
      <th>{{ t('totals.total_net') }}</th>
      <td>{{ invoice.totalNet | money }} {{ invoice.currency }}</td>
    </tr>
    <tr>
      <th>{{ t('totals.total_tax') }}</th>
      <td>{{ invoice.totalTax | money }} {{ invoice.currency }}</td>
    </tr>
    <tr class="totals-table__gross">
      <th>{{ t('totals.total_gross') }}</th>
      <td>{{ invoice.totalGross | money }} {{ invoice.currency }}</td>
    </tr>
    {% if invoice.advanceSettled %}
      <tr>
        <th>{{ t('totals.advance_settled') }}</th>
        <td>− {{ invoice.advanceSettled | money }} {{ invoice.currency }}</td>
      </tr>
    {% endif %}
    <tr class="totals-table__due">
      <th>{{ t('totals.amount_due') }}</th>
      <td>{{ (invoice.amountDue if invoice.amountDue is not none else invoice.totalGross) | money }} {{ invoice.currency }}</td>
    </tr>
  </table>
</section>
