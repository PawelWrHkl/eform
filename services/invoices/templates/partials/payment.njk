{# Sekcja płatności: forma, rachunek bankowy, termin. #}
<section class="payment">
  <h2 class="section-title">{{ t('payment.title') }}</h2>
  <table class="payment-table">
    {% if invoice.paymentMethod %}
      <tr>
        <th>{{ t('payment.method') }}</th>
        <td>{{ t('payment.' ~ invoice.paymentMethod) }}</td>
      </tr>
    {% endif %}
    <tr>
      <th>{{ t('header.due_date') }}</th>
      <td>{{ invoice.dueDate | date }}</td>
    </tr>
    {% if profile.bankAccount and profile.bankAccount.iban %}
      {% if profile.bankAccount.bankName %}
        <tr>
          <th>{{ t('payment.bank') }}</th>
          <td>{{ profile.bankAccount.bankName }}</td>
        </tr>
      {% endif %}
      <tr>
        <th>{{ t('payment.iban') }}</th>
        <td class="payment-table__iban">{{ profile.bankAccount.iban }}</td>
      </tr>
      {% if profile.bankAccount.swift %}
        <tr>
          <th>{{ t('payment.swift') }}</th>
          <td>{{ profile.bankAccount.swift }}</td>
        </tr>
      {% endif %}
    {% endif %}
  </table>
</section>
