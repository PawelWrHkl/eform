{#
  Mail z fakturą automatu (services/invoices/invoiceMailer.js).
  Środowisko: render/renderer.js:createEnvironment — `t()` w języku dokumentu,
  filtry `money` i `date`. Style wyłącznie inline: klienci poczty wycinają <style>.
  Baner trybu testowego jest po polsku — czytają go tylko adresaci przekierowania.
#}
<!doctype html>
<html lang="{{ invoice.lang }}">
<head><meta charset="utf-8"><title>{{ docLabel }} {{ invoice.number }}</title></head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #e1e4e8;border-radius:6px;">
  {% if redirect %}
  <tr><td style="padding:14px 24px;background:#fff4ce;border-bottom:1px solid #f0d27a;border-radius:6px 6px 0 0;font-size:13px;line-height:1.5;">
    <strong>TRYB TESTOWY ({{ redirect.envLabel }}) — ten mail NIE trafił do klienta.</strong><br>
    {% if redirect.intendedTo %}
    Normalnie trafiłby do: <strong>{{ redirect.intendedTo }}</strong>
    {% else %}
    <strong>Nabywca nie ma adresu e-mail</strong> — przy wysyłce do klientów ten mail by nie wyszedł.
    {% endif %}
    (nabywca: {{ invoice.buyer.name }}, poziom {{ invoice.level }}{% if invoice.orderId %}, zamówienie id {{ invoice.orderId }}{% endif %}).
    {% if redirect.replyTo %}<br>Odpowiedź klienta trafiłaby do: {{ redirect.replyTo }}{% endif %}
  </td></tr>
  {% endif %}
  <tr><td style="padding:24px 24px 8px;font-size:20px;font-weight:bold;">{{ docLabel }} {{ invoice.number }}</td></tr>
  <tr><td style="padding:0 24px;font-size:14px;color:#52606d;">{{ invoice.seller.name }}</td></tr>
  <tr><td style="padding:20px 24px 0;font-size:15px;line-height:1.6;">
    {{ t('mail.greeting') }}<br>
    {{ t('mail.intro') }}
  </td></tr>
  <tr><td style="padding:16px 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;border-collapse:collapse;">
      <tr><td style="padding:6px 0;color:#52606d;">{{ t('header.number') }}</td><td style="padding:6px 0;text-align:right;font-weight:bold;">{{ invoice.number }}</td></tr>
      <tr><td style="padding:6px 0;color:#52606d;border-top:1px solid #eef0f2;">{{ t('header.issue_date') }}</td><td style="padding:6px 0;text-align:right;border-top:1px solid #eef0f2;">{{ invoice.issueDate | date }}</td></tr>
      {% if invoice.orderRef %}
      <tr><td style="padding:6px 0;color:#52606d;border-top:1px solid #eef0f2;">{{ t('header.order_ref') }}</td><td style="padding:6px 0;text-align:right;border-top:1px solid #eef0f2;">{{ invoice.orderRef }}</td></tr>
      {% endif %}
      {% if invoice.orderName %}
      <tr><td style="padding:6px 0;color:#52606d;border-top:1px solid #eef0f2;">{{ t('header.order_name') }}</td><td style="padding:6px 0;text-align:right;border-top:1px solid #eef0f2;">{{ invoice.orderName }}</td></tr>
      {% endif %}
      <tr><td style="padding:6px 0;color:#52606d;border-top:1px solid #eef0f2;">{{ t('header.due_date') }}</td><td style="padding:6px 0;text-align:right;border-top:1px solid #eef0f2;">{{ invoice.dueDate | date }}</td></tr>
      <tr><td style="padding:10px 0 6px;font-weight:bold;border-top:2px solid #1f2933;">{{ t('totals.amount_due') }}</td><td style="padding:10px 0 6px;text-align:right;font-weight:bold;font-size:16px;border-top:2px solid #1f2933;">{{ (invoice.amountDue if invoice.amountDue is not none else invoice.totalGross) | money }} {{ invoice.currency }}</td></tr>
    </table>
  </td></tr>
  <tr><td style="padding:0 24px 8px;font-size:14px;line-height:1.6;">
    {{ t('mail.attachment') }}
    {% if hasReplyTo %}<br>{{ t('mail.questions') }}{% endif %}
  </td></tr>
  <tr><td style="padding:12px 24px 24px;font-size:14px;line-height:1.6;">
    {{ t('mail.regards') }}<br><strong>{{ invoice.seller.name }}</strong>
  </td></tr>
  <tr><td style="padding:12px 24px;border-top:1px solid #e1e4e8;font-size:11px;color:#7b8794;">{{ t('mail.auto_note') }}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
